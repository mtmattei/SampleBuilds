<Application x:Class="MorningCard.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       RequestedTheme="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme
          xmlns:utum="using:Uno.Toolkit.UI.Material"
          ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml">
          <!--
            Without this, Material's own controls keep Roboto while the card's text is Geist
            Sans - a mismatch that shows up first in the simulator's sliders and chips.
          -->
          <utum:MaterialToolkitTheme.FontOverrideDictionary>
            <ResourceDictionary>
              <FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Assets/Fonts/Geist_Regular.ttf#Geist</FontFamily>
              <FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Assets/Fonts/Geist_Regular.ttf#Geist</FontFamily>
              <FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Assets/Fonts/Geist_Medium.ttf#Geist Medium</FontFamily>
            </ResourceDictionary>
          </utum:MaterialToolkitTheme.FontOverrideDictionary>
        </utum:MaterialToolkitTheme>

        <!-- The card's own palette and type. Text styles come last: they build on both. -->
        <ResourceDictionary Source="ms-appx:///Themes/CardTokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/MotionTokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Fonts.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/TextStyles.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Converters.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/CardStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>


