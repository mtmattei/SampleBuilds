<!--
  Control styles for the card.

  The round actions are retemplated rather than lightweight-styled from Material's icon button. A
  Material icon button is a bare circle with no label; this design puts a 13px label and an optional
  second line under a 56px circle, and the press scales only the circle. That is a different visual
  tree, not a different set of colours, so a template is the honest way to get it.

  The corner radius is written as half the height: an oversized "pill" radius renders as an oval on
  the Skia renderer, which reduces per axis instead of clamping to a circle.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI"
                    xmlns:mc="using:MorningCard.Controls">







  <!-- The hairline between rows. A Rectangle rather than a Border: one job, one element. -->
  <Style x:Key="RowRule" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{ThemeResource LineBrush}" />
  </Style>

  <!--
    The "Open in Maps" pill. Sits on the map, so it carries its own opaque-ish ground rather than
    relying on whatever tile happens to be underneath - the same lesson as the Simulator panel.
  -->
  <Style x:Key="MapPillStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource MapPillBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource InkStrongBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <!-- D-pad and keyboard focus (v6 TV): 3 px slate outside, 3 px paper inside. Touch never shows it. -->
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="3" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CardSurfaceBrush}" />
    <Setter Property="FocusVisualSecondaryThickness" Value="3" />
    <!-- Template, not lightweight keys: Material Button has no key for the press scale or for the 8 px hit area outside the drawn pill. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!-- A transparent hit area 8 px past the drawn shell brings the target to 48 px
               without moving layout (the artboard's inset:-8px). -->
          <Grid Background="Transparent" Margin="-8">
          <Border x:Name="Shell"
                  Margin="8"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="ShellScale" />
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <!-- Scoped with To/From: a bare GeneratedDuration here would apply to every
                     change in the group, disabled included, and would carry the system default
                     curve that the house easing exists to replace. -->
                <VisualStateGroup.Transitions>
                  <VisualTransition To="Pressed">
                    <Storyboard>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.98" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.98" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualTransition>
                  <VisualTransition From="Pressed">
                    <Storyboard>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.92" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="ShellScale.ScaleX" Value="{StaticResource PressScale}" />
                    <Setter Target="ShellScale.ScaleY" Value="{StaticResource PressScale}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!--
    The checklist's action. One height for every pill on the card, which is the consistency the
    action row used to break by mixing circle buttons with text buttons.
  -->
  <Style x:Key="PrimaryPillStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="15,8" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <!-- D-pad and keyboard focus (v6 TV): 3 px slate outside, 3 px paper inside. Touch never shows it. -->
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="3" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CardSurfaceBrush}" />
    <Setter Property="FocusVisualSecondaryThickness" Value="3" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <!-- Template, not lightweight keys: Material Button has no key for the 0.98 press scale or for the 4 px hit area outside the shell. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!-- A transparent hit area 4 px past the drawn shell brings the target to 48 px
               without moving layout (the artboard's inset:-4px). -->
          <Grid Background="Transparent" Margin="-4">
          <Border x:Name="Shell"
                  Margin="4"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="ShellScale" />
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                  <VisualTransition To="Pressed">
                    <Storyboard>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.98" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.98" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualTransition>
                  <VisualTransition From="Pressed">
                    <Storyboard>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.9" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.78" />
                    <Setter Target="ShellScale.ScaleX" Value="{StaticResource PressScale}" />
                    <Setter Target="ShellScale.ScaleY" Value="{StaticResource PressScale}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Secondary: same height and radius, outline instead of fill. The ring is ink, not the glass edge
    the rest of the card uses - this one sits on the shell beside a filled primary, and a near-white
    hairline there read as an unfinished button rather than a quiet one.
  -->
  <!-- v6 ghost: a faint ink wash, no ring, 40 tall, radius 12 (Unlock, Retry). -->
  <Style x:Key="GhostPillStyle" TargetType="Button" BasedOn="{StaticResource PrimaryPillStyle}">
    <Setter Property="Background" Value="{ThemeResource GhostBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource InkStrongBrush}" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="13,0,16,0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="13.5" />
    <!-- Own template: the ghost shell has no outline and a hover wash; BasedOn alone keeps the primary template. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!-- A transparent hit area 4 px past the drawn shell brings the target to 48 px
               without moving layout (the artboard's inset:-4px). -->
          <Grid Background="Transparent" Margin="-4">
          <Border x:Name="Shell"
                  Margin="4"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="ShellScale" />
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                  <VisualTransition To="Pressed">
                    <Storyboard>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.98" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.98" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualTransition>
                  <VisualTransition From="Pressed">
                    <Storyboard>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY">
                        <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="{StaticResource EaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Shell.Background" Value="{ThemeResource ChipBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.7" />
                    <Setter Target="ShellScale.ScaleX" Value="{StaticResource PressScale}" />
                    <Setter Target="ShellScale.ScaleY" Value="{StaticResource PressScale}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The card's one primary action: strong ink, 40 tall, radius 12 (v6 .btn-dark). -->
  <Style x:Key="StartDriveStyle" TargetType="Button" BasedOn="{StaticResource PrimaryPillStyle}">
    <Setter Property="Background" Value="{ThemeResource InkStrongBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnInkStrongBrush}" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="16,0,18,0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontSize" Value="14" />
  </Style>


  <!--
    A button that looks like the row it wraps. The checklist header is the disclosure control, so
    the whole row is the target - but it must not read as a button, hence no chrome until pointer
    over. Hit area matches the visual, which is the thing a separate chevron button gets wrong.
  -->
  <Style x:Key="RowButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <!-- Defaulted here rather than hardcoded in the template, so a row that needs to read as a
         container can ask for a larger radius without a second template. -->
    <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <!-- D-pad and keyboard focus (v6 TV): 3 px slate outside, 3 px paper inside. Touch never shows it. -->
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="3" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CardSurfaceBrush}" />
    <Setter Property="FocusVisualSecondaryThickness" Value="3" />
    <Setter Property="FocusVisualMargin" Value="-2" />
    <!-- Template: a whole-row target with no chrome until hover, which no Material button style provides. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shell"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Shell.Background" Value="{ThemeResource ChipBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Shell.Background" Value="{ThemeResource ChipBrush}" />
                    <Setter Target="Shell.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 28x28: under the 44px touch minimum, which is recorded as a desktop-only trade-off. -->


  <!-- A checklist row's primary action (Start warming): slate, 32 tall, radius 10 (v6 .btn-primary). -->
  <Style x:Key="RowActionPrimaryStyle" TargetType="Button" BasedOn="{StaticResource PrimaryPillStyle}">
    <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0,14,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <!-- A checklist row's secondary action (Skip): ghost wash, 32 tall, radius 10 (v6 .btn-ghost). -->
  <Style x:Key="RowActionGhostStyle" TargetType="Button" BasedOn="{StaticResource GhostPillStyle}">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0,14,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{ThemeResource PinBrush}" />
  </Style>

  <!-- Undo: a text link in the slate ink (v6 .btn-link). -->
  <Style x:Key="RowLinkStyle" TargetType="HyperlinkButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource AccentInkBrush}" />
  </Style>

  <!--
    A status pill (v6 .pill-s / .chip): a Toolkit Chip made non-interactive. Its size comes from the
    Chip lightweight keys scoped in MorningCardView's resources (22 tall, radius 7). Hidden from
    automation: a Chip announces as a toggle button; the row it sits in carries the pill's text in
    its own accessible name.
  -->
  <Style x:Key="StatusPillStyle" TargetType="utu:Chip" BasedOn="{StaticResource SuggestionChipStyle}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
  </Style>

  <!--
    A loading skeleton bar (v6): the Line ink, radius 8, static (no pulse; spec). Out of the
    automation tree: a skeleton that narrates is noise. Bars under 16 px set their own radius to
    half their height: an oversized radius renders as an oval on Skia (rules file).
  -->
  <Style x:Key="SkeletonBar" TargetType="Rectangle">
    <Setter Property="Fill" Value="{ThemeResource LineBrush}" />
    <Setter Property="RadiusX" Value="8" />
    <Setter Property="RadiusY" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
  </Style>
  <!--
    Static cards. WORKAROUND(Card hover overlay sticks on touch scroll): the Material
    CardContentControl templates carry hover/pressed state overlays for clickable cards. On touch,
    a swipe that starts on the card hands the pointer to the ScrollViewer, the card never sees the
    pointer leave, and the overlay stays up, washing the whole card out (measured on the Wear
    emulator, Toolkit 9.1.3, 2026-09-23). Every card here is a static container, so these keep the
    Toolkit control and its Filled/Outlined colours but template out the state overlays.
  -->
  <!-- xaml-lint: allow card - template for the static card styles below, see WORKAROUND above -->
  <ControlTemplate x:Key="StaticCardTemplate" TargetType="utu:CardContentControl">
    <Border Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Padding="{TemplateBinding Padding}">
      <ContentPresenter Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Border>
  </ControlTemplate>

  <Style x:Key="StaticFilledCardStyle" TargetType="utu:CardContentControl" BasedOn="{StaticResource FilledCardContentControlStyle}">
    <!-- A container, not a D-pad stop: focus landed here on TV and showed no ring. -->
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{ThemeResource FilledCardContentBackground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource FilledCardContentBorderBrush}" />
    <Setter Property="Template" Value="{StaticResource StaticCardTemplate}" />
  </Style>

  <Style x:Key="StaticOutlinedCardStyle" TargetType="utu:CardContentControl" BasedOn="{StaticResource OutlinedCardContentControlStyle}">
    <!-- A container, not a D-pad stop: focus landed here on TV and showed no ring. -->
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{ThemeResource OutlinedCardContentBackground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlinedCardContentBorderBrush}" />
    <Setter Property="Template" Value="{StaticResource StaticCardTemplate}" />
  </Style>
</ResourceDictionary>
