<!--
  Control styles for the card.

  The round actions are retemplated rather than lightweight-styled from Material's icon button. A
  Material icon button is a bare circle with no label; this design puts a 13px label and an optional
  second line under a 56px circle, and the press scales only the circle. That is a different visual
  tree, not a different set of colours, so a template is the honest way to get it.

  The corner radius is written as half the height: an oversized "pill" radius renders as an oval on
  the Skia renderer, which reduces per axis instead of clamping to a circle.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="using:MorningCard.Controls">

  <Style x:Key="CardActionButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="Circle"
                    Width="56"
                    Height="56"
                    CornerRadius="28"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource ChipBrush}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="CircleScale" />
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource ActionLabel}"
                         TextAlignment="Center"
                         Text="{Binding Path=(mc:CardAction.Label), RelativeSource={RelativeSource TemplatedParent}}" />
              <TextBlock Style="{StaticResource CardCaption}"
                         TextAlignment="Center"
                         Visibility="{Binding Path=(mc:CardAction.SubLabel), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibility}}"
                         Text="{Binding Path=(mc:CardAction.SubLabel), RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="CircleScale.ScaleX" Value="0.94" />
                    <Setter Target="CircleScale.ScaleY" Value="0.94" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Circle.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Same shape, plus the checked fill. Lock and Climate are the two that hold a state. -->
  <Style x:Key="CardActionToggleStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="Circle"
                    Width="56"
                    Height="56"
                    CornerRadius="28"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource ChipBrush}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="CircleScale" />
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource ActionLabel}"
                         TextAlignment="Center"
                         Text="{Binding Path=(mc:CardAction.Label), RelativeSource={RelativeSource TemplatedParent}}" />
              <TextBlock Style="{StaticResource CardCaption}"
                         TextAlignment="Center"
                         Visibility="{Binding Path=(mc:CardAction.SubLabel), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibility}}"
                         Text="{Binding Path=(mc:CardAction.SubLabel), RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="CircleScale.ScaleX" Value="0.94" />
                    <Setter Target="CircleScale.ScaleY" Value="0.94" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Circle.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Circle.Background" Value="{ThemeResource AccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Circle.Background" Value="{ThemeResource AccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Circle.Background" Value="{ThemeResource AccentBrush}" />
                    <Setter Target="CircleScale.ScaleX" Value="0.94" />
                    <Setter Target="CircleScale.ScaleY" Value="0.94" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Circle.Background" Value="{ThemeResource AccentBrush}" />
                    <Setter Target="Circle.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The trip title reads as a heading and behaves as a link into the trip page. -->
  <Style x:Key="CardTitleButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <ContentPresenter />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The tires cell: looks tappable, and in this version it is not wired to anything. -->
  <Style x:Key="CardCellButtonStyle" TargetType="Button" BasedOn="{StaticResource CardTitleButtonStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

</ResourceDictionary>
