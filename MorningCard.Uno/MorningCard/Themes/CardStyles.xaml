<!--
  Control styles for the card.

  The round actions are retemplated rather than lightweight-styled from Material's icon button. A
  Material icon button is a bare circle with no label; this design puts a 13px label and an optional
  second line under a 56px circle, and the press scales only the circle. That is a different visual
  tree, not a different set of colours, so a template is the honest way to get it.

  The corner radius is written as half the height: an oversized "pill" radius renders as an oval on
  the Skia renderer, which reduces per axis instead of clamping to a circle.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="using:MorningCard.Controls">

  <Style x:Key="CardActionButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="Circle"
                    Width="56"
                    Height="56"
                    CornerRadius="28"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource ChipBrush}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="CircleScale" />
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource ActionLabel}"
                         TextAlignment="Center"
                         Text="{Binding Path=(mc:CardAction.Label), RelativeSource={RelativeSource TemplatedParent}}" />
              <TextBlock Style="{StaticResource CardCaption}"
                         TextAlignment="Center"
                         Visibility="{Binding Path=(mc:CardAction.SubLabel), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibility}}"
                         Text="{Binding Path=(mc:CardAction.SubLabel), RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="CircleScale.ScaleX" Value="0.94" />
                    <Setter Target="CircleScale.ScaleY" Value="0.94" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Circle.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Same shape, plus the checked fill. Lock and Climate are the two that hold a state. -->
  <Style x:Key="CardActionToggleStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="Circle"
                    Width="56"
                    Height="56"
                    CornerRadius="28"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource ChipBrush}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="CircleScale" />
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource ActionLabel}"
                         TextAlignment="Center"
                         Text="{Binding Path=(mc:CardAction.Label), RelativeSource={RelativeSource TemplatedParent}}" />
              <TextBlock Style="{StaticResource CardCaption}"
                         TextAlignment="Center"
                         Visibility="{Binding Path=(mc:CardAction.SubLabel), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToVisibility}}"
                         Text="{Binding Path=(mc:CardAction.SubLabel), RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="CircleScale.ScaleX" Value="0.94" />
                    <Setter Target="CircleScale.ScaleY" Value="0.94" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Circle.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Circle.Background" Value="{ThemeResource AccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Circle.Background" Value="{ThemeResource AccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Circle.Background" Value="{ThemeResource AccentBrush}" />
                    <Setter Target="CircleScale.ScaleX" Value="0.94" />
                    <Setter Target="CircleScale.ScaleY" Value="0.94" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Circle.Background" Value="{ThemeResource AccentBrush}" />
                    <Setter Target="Circle.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The trip title reads as a heading and behaves as a link into the trip page. -->
  <Style x:Key="CardTitleButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <ContentPresenter />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>



  <!-- One row of the list under the map. Fixed height keeps the three rules evenly spaced. -->
  <Style x:Key="ListRowStyle" TargetType="Grid">
    <Setter Property="Padding" Value="0,14" />
    <Setter Property="ColumnSpacing" Value="14" />
  </Style>

  <!-- The hairline between rows. A Rectangle rather than a Border: one job, one element. -->
  <Style x:Key="RowRule" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{ThemeResource LineBrush}" />
  </Style>

  <!--
    The "Open in Maps" pill. Sits on the map, so it carries its own opaque-ish ground rather than
    relying on whatever tile happens to be underneath - the same lesson as the Simulator panel.
  -->
  <Style x:Key="MapPillStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource MapPillBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!--
    The checklist's action. One height for every pill on the card, which is the consistency the
    action row used to break by mixing circle buttons with text buttons.
  -->
  <Style x:Key="PrimaryPillStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="15,8" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource InkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shell"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.9" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.78" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary: same height and radius, outline instead of fill. -->
  <Style x:Key="GhostPillStyle" TargetType="Button" BasedOn="{StaticResource PrimaryPillStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shell"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{ThemeResource GlassEdgeBrush}"
                  BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Shell.Background" Value="{ThemeResource ChipBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Shell.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The card's one primary action, so it is the only ink-filled control on it. -->
  <Style x:Key="StartDriveStyle" TargetType="Button" BasedOn="{StaticResource PrimaryPillStyle}">
    <Setter Property="Background" Value="{ThemeResource InkBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource GlassInkBrush}" />
    <Setter Property="Padding" Value="17,9" />
  </Style>

</ResourceDictionary>

