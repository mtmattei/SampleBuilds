<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    GENERATED by scripts/Fetch-Icons.ps1. Do not hand-edit: rerun the script.

    One icon set, one weight, one FontFamily. The card drew its own Path geometry before
    this, across five stroke weights and seven Viewbox sizes, which is what made the icons
    read as drawn rather than as a set.
  -->

  <FontFamily x:Key="IconFont">ms-appx:///Assets/Fonts/Phosphor_Regular.ttf#Phosphor</FontFamily>

  <!-- sun -->
