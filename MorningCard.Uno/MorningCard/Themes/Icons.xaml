  <!-- caret-down -->
  <x:String x:Key="IconDisclosure">&#xE136;</x:String>
  <!-- list-checks -->
  <x:String x:Key="IconChecklist">&#xEADC;</x:String>
  <!-- gas-pump -->
  <x:String x:Key="IconFuel">&#xE768;</x:String>
  <!-- thermometer-simple -->
  <x:String x:Key="IconCabin">&#xE5CC;</x:String>
  <!-- map-pin -->
  <x:String x:Key="IconParking">&#xE316;</x:String>
  <!-- lock-simple -->
  <x:String x:Key="IconLock">&#xE308;</x:String>
  <!-- lock-simple-open -->
  <x:String x:Key="IconUnlock">&#xE30A;</x:String>
  <!-- navigation-arrow -->
