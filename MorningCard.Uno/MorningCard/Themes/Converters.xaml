<!--
  Converter instances, in their own dictionary so they are merged before the styles and pages that
  reference them rather than declared alongside the app's own resources.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mp="using:MorningCard.Presentation">

  <mp:BoolToAngleConverter x:Key="BoolToAngle" />
  <mp:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <mp:InverseBoolConverter x:Key="InverseBool" />
  <mp:NullToVisibilityConverter x:Key="NullToVisibility" />
  <mp:BoolToStrikeConverter x:Key="BoolToStrike" />

  <!--
    Brush converters. Each returns one card token per state; the app is light only (v6 decision B6),
    so a single value per token is the design, not a missing dark variant.
  -->
  <!-- xaml-lint: allow tokentheme - light-only app (B6) -->
  <mp:TrafficBrushConverter x:Key="TrafficBrush" />
  <!-- xaml-lint: allow tokentheme - light-only app (B6) -->
  <mp:CabinPillBrushConverter x:Key="CabinPillBrush" />
  <!-- xaml-lint: allow tokentheme - light-only app (B6) -->
  <mp:CabinPillInkConverter x:Key="CabinPillInk" />
  <!-- xaml-lint: allow tokentheme - light-only app (B6) -->
  <mp:CabinIconBrushConverter x:Key="CabinIconBrush" />
  <!-- xaml-lint: allow tokentheme - light-only app (B6) -->
  <mp:FuelPillBrushConverter x:Key="FuelPillBrush" />
  <!-- xaml-lint: allow tokentheme - light-only app (B6) -->
  <mp:FuelPillInkConverter x:Key="FuelPillInk" />
  <!-- xaml-lint: allow tokentheme - light-only app (B6) -->
  <mp:TokenBrushConverter x:Key="TokenBrush" />
  <mp:WatchAccentSizeConverter x:Key="WatchAccentSize" />

</ResourceDictionary>
