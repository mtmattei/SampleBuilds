<!--
  Converter instances, in their own dictionary so they are merged before the styles and pages that
  reference them rather than declared alongside the app's own resources.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mp="using:MorningCard.Presentation">

  <mp:StatLevelBrushConverter x:Key="StatLevelBrush" />
  <mp:TrafficBrushConverter x:Key="TrafficBrush" />
  <mp:ToneBrushConverter x:Key="ToneBrush" />
  <mp:LockGlyphConverter x:Key="LockGlyph" />
  <mp:ChecksHeaderRadiusConverter x:Key="ChecksHeaderRadius" />
  <mp:ConnectionDotBrushConverter x:Key="ConnectionDotBrush" />
  <mp:AccentToneConverter x:Key="AccentTone" />
  <mp:ToneChipInkConverter x:Key="ToneChipInk" />
  <!-- xaml-lint: allow tokentheme - converters, not brushes; they hand out live per-theme brushes from Tokens -->
  <mp:ToneTrackBrushConverter x:Key="ToneTrackBrush" />
  <mp:ToneChipBrushConverter x:Key="ToneChipBrush" />
  <mp:ReadyInkConverter x:Key="ReadyInk" />
  <mp:BoolToAngleConverter x:Key="BoolToAngle" />
  <mp:LateInkConverter x:Key="LateInk" />
  <mp:StaleOpacityConverter x:Key="StaleOpacity" />
  <mp:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <mp:InverseBoolConverter x:Key="InverseBool" />
  <mp:NullToVisibilityConverter x:Key="NullToVisibility" />
  <mp:PercentToStarConverter x:Key="PercentToStar" />

</ResourceDictionary>


