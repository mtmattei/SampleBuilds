<!--
  The card's palette. Light is the base and dark redefines the same names.

  Colours and their brushes both live inside the theme dictionaries. Brushes at the root would be a
  single shared instance resolved against the application's theme, and the theme service switches
  the root element's theme instead - which left the map panel drawing its light palette on a dark
  card. Per-theme brushes resolve against the element that uses them.

  The hue dial mutates the accent brushes in place, in both dictionaries (see AccentPalette).

  Matte, not glass: the frame and the panels are opaque paper, each with one hairline and, for the
  frame only, one soft ambient shadow. One muted slate-blue carries every route and time meaning;
  the other hues are quiet states - clay for walking, sage for ready, tan for "soon", brick for late.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:media="using:Microsoft.UI.Xaml.Media">

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!-- The app ground: dark slate in both themes, with grain drawn over it by GrainCanvas. -->
      <Color x:Key="GroundColor">#2C3238</Color>
      <!--
        The card's outer shell: frosted grey glass. One cool grey tint over a real backdrop blur of
        the slate ground (Uno's Skia-native acrylic path, not the Composition effect brush, which
        paints nothing on Skia desktop). The tint is high enough that ink on the shell keeps 4.5:1
        over the darkest thing behind it. FallbackColor is the same glass flattened, for any head
        where the backdrop path is unavailable.
      -->
      <Color x:Key="ShellTintColor">#EEF0F2</Color>
      <Color x:Key="ShellFallbackColor">#CDD0D4</Color>
      <AcrylicBrush x:Key="ShellBackgroundBrush"
                    AlwaysUseFallback="False"
                    media:AcrylicBrushExtensions.UseCompositionEffectBrush="False"
                    TintColor="{StaticResource ShellTintColor}"
                    TintOpacity="0.8"
                    FallbackColor="{StaticResource ShellFallbackColor}" />

      <!-- The outer frame: flat warm paper grey. -->
      <Color x:Key="FrameColor">#F1EFE9</Color>
      <!-- The panels inside it: warm off-white. -->
      <Color x:Key="CardSurfaceColor">#FBFAF7</Color>

      <Color x:Key="InkColor">#1B2430</Color>
      <Color x:Key="Ink2Color">#4C555F</Color>
      <Color x:Key="Ink3Color">#626B77</Color>
      <!-- The one hairline every surface carries. Warm, so it sits in the paper rather than on it. -->
      <Color x:Key="LineColor">#243A342A</Color>
      <Color x:Key="ChipColor">#123A342A</Color>

      <!-- hsl(209 30% 41.5%) and hsl(209 30% 36%): the route accent. 5.3:1 on the panel. -->
      <Color x:Key="AccentColor">#4A6B8A</Color>
      <Color x:Key="AccentInkColor">#405D77</Color>
      <Color x:Key="OnAccentColor">#FFFFFF</Color>

      <!-- Sage: ready. The ink is 5.4:1 on the panel. -->
      <Color x:Key="GoodColor">#7E9C82</Color>
      <Color x:Key="GoodInkColor">#4F6E53</Color>
      <!-- Clay: the walk leg, and anything that is "soon". The ink is 5.8:1 on the panel. -->
      <Color x:Key="AmberColor">#B5824F</Color>
      <Color x:Key="AmberInkColor">#85592D</Color>
      <!-- Muted brick: running late. The ink is 6.6:1 on the panel. -->
      <Color x:Key="DangerColor">#A85A45</Color>
      <Color x:Key="DangerInkColor">#8E4533</Color>

      <Color x:Key="MapColor">#EEECE6</Color>
      <Color x:Key="PinColor">#3D3A35</Color>

      <!-- The frame's single ambient shadow. -->
      <Color x:Key="CardShadowColor">#1C2A2419</Color>
      <Color x:Key="SunInkColor">#B5824F</Color>
      <Color x:Key="MapScrimColor">#EBFBFAF7</Color>  <!-- Covers the tiles when the map has no route to show. -->
      <Color x:Key="MapPillColor">#F2FBFAF7</Color>
      <Color x:Key="AccentChipColor">#1F4A6B8A</Color>
      <!-- Soft tan: "Fuel soon". -->
      <Color x:Key="AmberChipColor">#2EB5824F</Color>
      <Color x:Key="DangerChipColor">#1F8E4533</Color>
      <Color x:Key="GoodChipColor">#247E9C82</Color>
      <!--
        The scrim ramp under the ETA block, in the panel colour. The alphas are the ones measured off
        the mockup: it holds, then lets go, and is fully clear by about 0.74.
      -->
      <Color x:Key="EtaScrimColor">#FFFBFAF7</Color>
      <Color x:Key="EtaScrimFadeColor">#00FBFAF7</Color>
      <Color x:Key="EtaScrimStop1Color">#F2FBFAF7</Color>
      <Color x:Key="EtaScrimStop2Color">#DCFBFAF7</Color>
      <Color x:Key="EtaScrimStop3Color">#C0FBFAF7</Color>
      <Color x:Key="EtaScrimStop4Color">#96FBFAF7</Color>
      <Color x:Key="EtaScrimStop5Color">#56FBFAF7</Color>
      <Color x:Key="EtaScrimStop6Color">#1EFBFAF7</Color>
      <Color x:Key="EtaScrimStop7Color">#0AFBFAF7</Color>
      <Color x:Key="GlassInkColor">#FBFAF7</Color>  <!-- Ink on an ink-filled control (Start drive). -->
      <!-- The slack ruler's blocks: firmer tints than the chips, so each block reads as a span of time. -->
      <Color x:Key="RulerSlackColor">#D3E3D4</Color>
      <Color x:Key="RulerDriveColor">#D9E2EC</Color>
      <!-- Clay, like the map's walk leg, at the same strength as slack and drive. -->
      <Color x:Key="RulerWalkColor">#E9DCCD</Color>
      <SolidColorBrush x:Key="SunInkBrush" Color="{StaticResource SunInkColor}" />
      <SolidColorBrush x:Key="MapScrimBrush" Color="{StaticResource MapScrimColor}" />
      <SolidColorBrush x:Key="MapPillBrush" Color="{StaticResource MapPillColor}" />
      <SolidColorBrush x:Key="AccentChipBrush" Color="{StaticResource AccentChipColor}" />
      <SolidColorBrush x:Key="AmberChipBrush" Color="{StaticResource AmberChipColor}" />
      <SolidColorBrush x:Key="DangerChipBrush" Color="{StaticResource DangerChipColor}" />
      <SolidColorBrush x:Key="GoodChipBrush" Color="{StaticResource GoodChipColor}" />
      <SolidColorBrush x:Key="GlassInkBrush" Color="{StaticResource GlassInkColor}" />
      <SolidColorBrush x:Key="RulerSlackBrush" Color="{StaticResource RulerSlackColor}" />
      <SolidColorBrush x:Key="RulerDriveBrush" Color="{StaticResource RulerDriveColor}" />
      <SolidColorBrush x:Key="RulerWalkBrush" Color="{StaticResource RulerWalkColor}" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource GroundColor}" />
      <SolidColorBrush x:Key="FrameBrush" Color="{StaticResource FrameColor}" />
      <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
      <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="Ink2Brush" Color="{StaticResource Ink2Color}" />
      <SolidColorBrush x:Key="Ink3Brush" Color="{StaticResource Ink3Color}" />
      <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
      <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
      <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
      <SolidColorBrush x:Key="GoodInkBrush" Color="{StaticResource GoodInkColor}" />
      <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
      <SolidColorBrush x:Key="AmberInkBrush" Color="{StaticResource AmberInkColor}" />
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
      <SolidColorBrush x:Key="DangerInkBrush" Color="{StaticResource DangerInkColor}" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="GroundColor">#1F2328</Color>
      <!-- The same frosted glass in a dark grey. -->
      <Color x:Key="ShellTintColor">#3E434A</Color>
      <Color x:Key="ShellFallbackColor">#373C42</Color>
      <AcrylicBrush x:Key="ShellBackgroundBrush"
                    AlwaysUseFallback="False"
                    media:AcrylicBrushExtensions.UseCompositionEffectBrush="False"
                    TintColor="{StaticResource ShellTintColor}"
                    TintOpacity="0.8"
                    FallbackColor="{StaticResource ShellFallbackColor}" />

      <Color x:Key="FrameColor">#1D1C1A</Color>
      <Color x:Key="CardSurfaceColor">#252421</Color>

      <Color x:Key="InkColor">#F0EEE9</Color>
      <Color x:Key="Ink2Color">#B3AFA7</Color>
      <Color x:Key="Ink3Color">#9A958C</Color>
      <Color x:Key="LineColor">#1FFFFFFF</Color>
      <Color x:Key="ChipColor">#14FFFFFF</Color>

      <!-- hsl(209 32% 64%) and hsl(209 36% 72%). -->
      <Color x:Key="AccentColor">#86A4C1</Color>
      <Color x:Key="AccentInkColor">#9EB8D1</Color>
      <Color x:Key="OnAccentColor">#141311</Color>

      <Color x:Key="GoodColor">#93B297</Color>
      <Color x:Key="GoodInkColor">#A9C5AC</Color>
      <Color x:Key="AmberColor">#CFA274</Color>
      <Color x:Key="AmberInkColor">#DDB88F</Color>
      <Color x:Key="DangerColor">#C98370</Color>
      <Color x:Key="DangerInkColor">#D99A89</Color>

      <Color x:Key="MapColor">#1F1E1C</Color>
      <Color x:Key="PinColor">#E6E3DC</Color>

      <Color x:Key="CardShadowColor">#59000000</Color>
      <Color x:Key="SunInkColor">#CFA274</Color>
      <Color x:Key="MapScrimColor">#E0252421</Color>
      <Color x:Key="MapPillColor">#F2252421</Color>
      <Color x:Key="AccentChipColor">#2E86A4C1</Color>
      <Color x:Key="AmberChipColor">#2ECFA274</Color>
      <Color x:Key="DangerChipColor">#2EC98370</Color>
      <Color x:Key="GoodChipColor">#2E93B297</Color>
      <Color x:Key="EtaScrimColor">#FF252421</Color>
      <Color x:Key="EtaScrimFadeColor">#00252421</Color>
      <Color x:Key="EtaScrimStop1Color">#F2252421</Color>
      <Color x:Key="EtaScrimStop2Color">#DC252421</Color>
      <Color x:Key="EtaScrimStop3Color">#C0252421</Color>
      <Color x:Key="EtaScrimStop4Color">#96252421</Color>
      <Color x:Key="EtaScrimStop5Color">#56252421</Color>
      <Color x:Key="EtaScrimStop6Color">#1E252421</Color>
      <Color x:Key="EtaScrimStop7Color">#0A252421</Color>
      <Color x:Key="GlassInkColor">#141311</Color>
      <Color x:Key="RulerSlackColor">#444C42</Color>
      <Color x:Key="RulerDriveColor">#3D4449</Color>
      <Color x:Key="RulerWalkColor">#504336</Color>
      <SolidColorBrush x:Key="SunInkBrush" Color="{StaticResource SunInkColor}" />
      <SolidColorBrush x:Key="MapScrimBrush" Color="{StaticResource MapScrimColor}" />
      <SolidColorBrush x:Key="MapPillBrush" Color="{StaticResource MapPillColor}" />
      <SolidColorBrush x:Key="AccentChipBrush" Color="{StaticResource AccentChipColor}" />
      <SolidColorBrush x:Key="AmberChipBrush" Color="{StaticResource AmberChipColor}" />
      <SolidColorBrush x:Key="DangerChipBrush" Color="{StaticResource DangerChipColor}" />
      <SolidColorBrush x:Key="GoodChipBrush" Color="{StaticResource GoodChipColor}" />
      <SolidColorBrush x:Key="GlassInkBrush" Color="{StaticResource GlassInkColor}" />
      <SolidColorBrush x:Key="RulerSlackBrush" Color="{StaticResource RulerSlackColor}" />
      <SolidColorBrush x:Key="RulerDriveBrush" Color="{StaticResource RulerDriveColor}" />
      <SolidColorBrush x:Key="RulerWalkBrush" Color="{StaticResource RulerWalkColor}" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource GroundColor}" />
      <SolidColorBrush x:Key="FrameBrush" Color="{StaticResource FrameColor}" />
      <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
      <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="Ink2Brush" Color="{StaticResource Ink2Color}" />
      <SolidColorBrush x:Key="Ink3Brush" Color="{StaticResource Ink3Color}" />
      <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
      <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
      <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
      <SolidColorBrush x:Key="GoodInkBrush" Color="{StaticResource GoodInkColor}" />
      <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
      <SolidColorBrush x:Key="AmberInkBrush" Color="{StaticResource AmberInkColor}" />
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
      <SolidColorBrush x:Key="DangerInkBrush" Color="{StaticResource DangerInkColor}" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>


  <!-- Geometry the card and its canvases share. CardCornerRadius is what the radius dial writes. -->
  <CornerRadius x:Key="CardCornerRadius">28</CornerRadius>
  <!-- Concentric: each radius is the one outside it minus the gap. Shell 28 - 16 ring = 12 for
       the white card and the bar buttons; white card 12 - 8 inset = 4 for the map and checklist. -->
  <CornerRadius x:Key="CardInnerCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="MapCornerRadius">4</CornerRadius>
  <!-- Skeleton bars, the map pin and other small rounded shapes share one value. -->
  <CornerRadius x:Key="SmallCornerRadius">8</CornerRadius>
  <!-- Chips, the slack callout and ruler blocks: soft rounded rectangles, not pills. -->
  <CornerRadius x:Key="ChipCornerRadius">8</CornerRadius>
  <!-- Bar buttons nest in the shell corner (28 - 16). The map pill cannot nest in a 4 corner, so it takes the small 8. -->
  <CornerRadius x:Key="ButtonCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="MapButtonCornerRadius">8</CornerRadius>
  <!--
    Uneven at the top on purpose. The shell's top band runs from the card's edge to the inner
    card's, and the strip has to sit centred in it - at a flat 27 the strip was 27 from the card
    edge and 4 from the inner card, pinned to the bottom of its own band. The 11 it gives up here
    is handed back as the strip's bottom margin, so the band and the card height are unchanged.
  -->
  <Thickness x:Key="CardPadding">32,16,32,16</Thickness>

  <!-- What the top padding gave up, so the row still ends where it did. -->
  <Thickness x:Key="StatusStripMargin">-16,0,-16,16</Thickness>

  <!--
    The same problem at the other end, mirrored. The bottom band runs from the inner card's edge to
    the card's, and the bar sat 2 from the inner card and 27 from the card - pinned to the top of
    its band this time. The bottom padding gives up 12 and this takes it back, so again the band
    and the card height are unchanged.
  -->
  <Thickness x:Key="BottomBarMargin">-16,8,-16,0</Thickness>
  <!-- 529: the original 400 plus 15% twice. The two-column stage is two of these plus the 24 gap and
       the stage's own 16 of side padding each way. -->
  <x:Double x:Key="CardMaxWidth">529</x:Double>

  <!--
    Space held for the card whatever state it is in, so the Simulator below it does not move.

    Measured at 529 wide: 654 epx closed, 855 epx with the checklist open, and about 55 more when
    the cabin row shows its action. Opening the checklist used to shove the Simulator 200 epx down
    the screen, which is fine in use and ruinous in a recording - the frame reflows under the take.
    Reserving the tall case costs empty space in the closed state and buys a fixed stage.
  -->
  <x:Double x:Key="CardReservedHeight">940</x:Double>
  <x:Double x:Key="StageMaxWidthWide">1114</x:Double>
  <!-- 264: the reference panel scaled to this card width. 248 read 6% short. -->
  <x:Double x:Key="MapPanelHeight">264</x:Double>

</ResourceDictionary>
