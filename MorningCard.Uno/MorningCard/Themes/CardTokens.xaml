<!--
  The card's palette. The app is light only (v6 decision B6), so there is one theme dictionary.

  Colours and their brushes stay inside the Light theme dictionary so {ThemeResource} lookups and
  CardPalette.Lookup keep resolving the same way they always have.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!-- Flat warm ground behind the card. -->
      <Color x:Key="GroundColor">#E9E6DF</Color>
      <!-- The shell (was frosted glass). -->
      <Color x:Key="GlassColor">#F1EFE9</Color>
      <!-- The shell's 1 px inset top highlight. -->
      <Color x:Key="GlassEdgeColor">#E6FFFFFF</Color>
      <Color x:Key="GlassSecondaryColor">#FBFAF7</Color>
      <!-- The panel inside the shell. -->
      <Color x:Key="CardSurfaceColor">#FBFAF7</Color>
      <Color x:Key="PanelRingColor">#0D2A2C2F</Color>
      <Color x:Key="InkColor">#2A2C2F</Color>
      <Color x:Key="Ink2Color">#55585C</Color>
      <Color x:Key="Ink3Color">#76787B</Color>
      <!-- Caps labels (LEAVE BY, ARRIVE, BELL). -->
      <Color x:Key="CapsColor">#94918A</Color>
      <Color x:Key="FaintColor">#ADA9A1</Color>
      <Color x:Key="LineColor">#142A2C2F</Color>
      <Color x:Key="ChipColor">#0D2A2C2F</Color>
      <!-- On time: muted slate. The accent is the on-time tone. -->
      <Color x:Key="AccentColor">#4A6B8A</Color>
      <Color x:Key="AccentInkColor">#3F5C78</Color>
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <!-- Leave now: brown. -->
      <Color x:Key="LeaveNowColor">#A6703F</Color>
      <Color x:Key="LeaveNowInkColor">#8A5A2E</Color>
      <!-- Sage for ready and light traffic. -->
      <Color x:Key="GoodColor">#7E947A</Color>
      <Color x:Key="GoodInkColor">#4F6B4C</Color>
      <Color x:Key="GoodFillColor">#E4EBE1</Color>
      <!-- Ochre: the walk leg and the sun. -->
      <Color x:Key="AmberColor">#B5824F</Color>
      <Color x:Key="AmberInkColor">#8A6236</Color>
      <Color x:Key="WalkFillColor">#F1E7DA</Color>
      <Color x:Key="DriveFillColor">#E1E8EF</Color>
      <!-- Late: brick. -->
      <Color x:Key="DangerColor">#9C4A3E</Color>
      <Color x:Key="DangerInkColor">#8C4236</Color>
      <!-- 1 px at 135 deg, 6 px pitch, drawn in Skia (spike R9). -->
      <Color x:Key="HatchColor">#1A2A2C2F</Color>
      <Color x:Key="HatchGroundColor">#F1EFEA</Color>
      <Color x:Key="OverrunColor">#4D9C4A3E</Color>
      <Color x:Key="OverrunRingColor">#739C4A3E</Color>
      <!-- Strong ink (#2B2D30): headings and the primary action fill (Start drive). -->
      <Color x:Key="InkStrongColor">#2B2D30</Color>
      <Color x:Key="OnInkStrongColor">#FBFAF7</Color>
      <!-- Ghost button fill (Unlock, Retry). -->
      <Color x:Key="GhostColor">#0F2A2C2F</Color>
      <!-- Paper map ground; also the tint target for the OSM tiles. -->
      <Color x:Key="MapColor">#EFEEE9</Color>
      <Color x:Key="MapRoadColor">#FFFFFF</Color>
      <Color x:Key="MapParkColor">#E8ECE3</Color>
      <Color x:Key="MapWaterColor">#DBE1E3</Color>
      <Color x:Key="PinColor">#3A3C3F</Color>
      <!-- Map overlay (v6): the dotted slack line, the callout ring and the walk callout plate. -->
      <Color x:Key="SlackDotColor">#A8A49C</Color>
      <Color x:Key="CalloutRingColor">#142A2C2F</Color>
      <Color x:Key="WalkPlateColor">#F0EADF</Color>
      <!-- Card shadow: 0.5 px ring, 0 2 6, 0 32 64 -24. -->
      <Color x:Key="CardShadowRingColor">#1A2A2C2F</Color>
      <Color x:Key="CardShadowNearColor">#0F2A2C2F</Color>
      <Color x:Key="CardShadowFarColor">#612A2C2F</Color>
      <Color x:Key="SunInkColor">#B5824F</Color>
      <!-- Covers the tiles when the map has no route to show. -->
      <Color x:Key="MapScrimColor">#E6EFEEE9</Color>
      <Color x:Key="MapPillColor">#FBFAF7</Color>
      <Color x:Key="AccentChipColor">#1F4A6B8A</Color>
      <Color x:Key="AmberChipColor">#F0EADF</Color>
      <Color x:Key="DangerChipColor">#1F9C4A3E</Color>
      <Color x:Key="GoodChipColor">#E8ECE3</Color>
      <!-- Map scrim: white 97% to 90% at 24%, 45% at 44%, 0 at 62%. -->
      <Color x:Key="EtaScrimColor">#F7FFFFFF</Color>
      <Color x:Key="EtaScrimFadeColor">#00FFFFFF</Color>
      <Color x:Key="EtaScrimStop1Color">#E6FFFFFF</Color>
      <Color x:Key="EtaScrimStop2Color">#73FFFFFF</Color>
      <Color x:Key="EtaScrimStop3Color">#40FFFFFF</Color>
      <Color x:Key="EtaScrimStop4Color">#1AFFFFFF</Color>
      <Color x:Key="EtaScrimStop5Color">#08FFFFFF</Color>
      <!-- Ground for controls sitting on top of map tiles. -->
      <!-- Checklist pills (v6): neutral for suggested and skipped, slate-tinted while warming. -->
      <Color x:Key="NeutralChipColor">#EAE7E0</Color>
      <Color x:Key="NeutralChipInkColor">#6A6C6F</Color>
      <Color x:Key="WarmingChipColor">#E7EBEF</Color>
      <Color x:Key="SkippedTitleColor">#A5A199</Color>
      <SolidColorBrush x:Key="NeutralChipBrush" Color="{StaticResource NeutralChipColor}" />
      <SolidColorBrush x:Key="NeutralChipInkBrush" Color="{StaticResource NeutralChipInkColor}" />
      <SolidColorBrush x:Key="WarmingChipBrush" Color="{StaticResource WarmingChipColor}" />
      <SolidColorBrush x:Key="SkippedTitleBrush" Color="{StaticResource SkippedTitleColor}" />
      <Color x:Key="GlassInkColor">#FBFAF7</Color>

      <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource GroundColor}" />
      <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}" />
      <SolidColorBrush x:Key="GlassEdgeBrush" Color="{StaticResource GlassEdgeColor}" />
      <SolidColorBrush x:Key="GlassSecondaryBrush" Color="{StaticResource GlassSecondaryColor}" />
      <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
      <SolidColorBrush x:Key="PanelRingBrush" Color="{StaticResource PanelRingColor}" />
      <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="Ink2Brush" Color="{StaticResource Ink2Color}" />
      <SolidColorBrush x:Key="Ink3Brush" Color="{StaticResource Ink3Color}" />
      <SolidColorBrush x:Key="CapsBrush" Color="{StaticResource CapsColor}" />
      <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
      <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
      <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="LeaveNowBrush" Color="{StaticResource LeaveNowColor}" />
      <SolidColorBrush x:Key="LeaveNowInkBrush" Color="{StaticResource LeaveNowInkColor}" />
      <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
      <SolidColorBrush x:Key="GoodInkBrush" Color="{StaticResource GoodInkColor}" />
      <SolidColorBrush x:Key="GoodFillBrush" Color="{StaticResource GoodFillColor}" />
      <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
      <SolidColorBrush x:Key="AmberInkBrush" Color="{StaticResource AmberInkColor}" />
      <SolidColorBrush x:Key="WalkFillBrush" Color="{StaticResource WalkFillColor}" />
      <SolidColorBrush x:Key="DriveFillBrush" Color="{StaticResource DriveFillColor}" />
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
      <SolidColorBrush x:Key="DangerInkBrush" Color="{StaticResource DangerInkColor}" />
      <SolidColorBrush x:Key="HatchBrush" Color="{StaticResource HatchColor}" />
      <SolidColorBrush x:Key="HatchGroundBrush" Color="{StaticResource HatchGroundColor}" />
      <SolidColorBrush x:Key="OverrunBrush" Color="{StaticResource OverrunColor}" />
      <SolidColorBrush x:Key="OverrunRingBrush" Color="{StaticResource OverrunRingColor}" />
      <SolidColorBrush x:Key="InkStrongBrush" Color="{StaticResource InkStrongColor}" />
      <SolidColorBrush x:Key="OnInkStrongBrush" Color="{StaticResource OnInkStrongColor}" />
      <SolidColorBrush x:Key="GhostBrush" Color="{StaticResource GhostColor}" />
      <SolidColorBrush x:Key="MapBrush" Color="{StaticResource MapColor}" />
      <SolidColorBrush x:Key="MapRoadBrush" Color="{StaticResource MapRoadColor}" />
      <SolidColorBrush x:Key="MapParkBrush" Color="{StaticResource MapParkColor}" />
      <SolidColorBrush x:Key="MapWaterBrush" Color="{StaticResource MapWaterColor}" />
      <SolidColorBrush x:Key="PinBrush" Color="{StaticResource PinColor}" />
      <SolidColorBrush x:Key="SunInkBrush" Color="{StaticResource SunInkColor}" />
      <SolidColorBrush x:Key="MapScrimBrush" Color="{StaticResource MapScrimColor}" />
      <SolidColorBrush x:Key="MapPillBrush" Color="{StaticResource MapPillColor}" />
      <SolidColorBrush x:Key="AccentChipBrush" Color="{StaticResource AccentChipColor}" />
      <SolidColorBrush x:Key="AmberChipBrush" Color="{StaticResource AmberChipColor}" />
      <SolidColorBrush x:Key="DangerChipBrush" Color="{StaticResource DangerChipColor}" />
      <SolidColorBrush x:Key="GoodChipBrush" Color="{StaticResource GoodChipColor}" />
      <SolidColorBrush x:Key="GlassInkBrush" Color="{StaticResource GlassInkColor}" />

      <!-- Toolkit CardContentControl lightweight keys: the shell is the Filled card, the paper
           panel the Outlined one. State variants repeat the rest value: neither card is clickable. -->
      <SolidColorBrush x:Key="FilledCardContentBackground" Color="{StaticResource GlassColor}" />
      <SolidColorBrush x:Key="FilledCardContentBorderBrush" Color="{StaticResource GlassEdgeColor}" />
      <SolidColorBrush x:Key="FilledCardContentBorderBrushPointerOver" Color="{StaticResource GlassEdgeColor}" />
      <SolidColorBrush x:Key="FilledCardContentBorderBrushFocused" Color="{StaticResource GlassEdgeColor}" />
      <SolidColorBrush x:Key="FilledCardContentBorderBrushPressed" Color="{StaticResource GlassEdgeColor}" />
      <SolidColorBrush x:Key="OutlinedCardContentBackground" Color="{StaticResource CardSurfaceColor}" />
      <SolidColorBrush x:Key="OutlinedCardContentBorderBrush" Color="{StaticResource PanelRingColor}" />
    </ResourceDictionary>


  </ResourceDictionary.ThemeDictionaries>


  <!-- Geometry the card and its canvases share. CardCornerRadius and CardPadding double as the
       Toolkit's CardContentControl lightweight keys (the shell's values); the panel sets its own.
       CardCornerRadius is what the radius dial writes. v6: shell 28 = panel 20 + padding 8. -->
  <CornerRadius x:Key="CardCornerRadius">28</CornerRadius>
  <!-- Sits between the map panel inside it and the shell around it, so three nested surfaces
       read as nested rather than as three unrelated rounded boxes. -->
  <CornerRadius x:Key="CardInnerCornerRadius">20</CornerRadius>
  <!-- The same radius as the card it sits in, by request: the two edges are close enough
       together that a 20-against-24 difference read as a mistake rather than as nesting. -->
  <CornerRadius x:Key="MapCornerRadius">16</CornerRadius>
  <!-- Skeleton bars, the map pin and other small rounded shapes share one value. 6, 9 and 10 were
       three separately invented values within 4px of each other. -->
  <CornerRadius x:Key="SmallCornerRadius">8</CornerRadius>
  <!--
    Uneven at the top on purpose. The shell's top band runs from the card's edge to the inner
    card's, and the strip has to sit centred in it - at a flat 27 the strip was 27 from the card
    edge and 4 from the inner card, pinned to the bottom of its own band. The 11 it gives up here
    is handed back as the strip's bottom margin, so the band and the card height are unchanged.
  -->
  <Thickness x:Key="CardPadding">8</Thickness>

  <!-- What the top padding gave up, so the row still ends where it did. -->
  <Thickness x:Key="StatusStripMargin">0,0,0,11</Thickness>

  <!--
    The same problem at the other end, mirrored. The bottom band runs from the inner card's edge to
    the card's, and the bar sat 2 from the inner card and 27 from the card - pinned to the top of
    its band this time. The bottom padding gives up 12 and this takes it back, so again the band
    and the card height are unchanged.
  -->
  <Thickness x:Key="BottomBarMargin">0,10,0,0</Thickness>
  <!-- 529: the original 400 plus 15% twice. The two-column stage is two of these plus the 24 gap and
       the stage's own 16 of side padding each way. -->
  <x:Double x:Key="CardMaxWidth">552</x:Double>

  <!--
    Space held for the card whatever state it is in, so the Simulator below it does not move.

    Measured at 529 wide: 654 epx closed, 855 epx with the checklist open, and about 55 more when
    the cabin row shows its action. Opening the checklist used to shove the Simulator 200 epx down
    the screen, which is fine in use and ruinous in a recording - the frame reflows under the take.
    Reserving the tall case costs empty space in the closed state and buys a fixed stage.
  -->
  <x:Double x:Key="CardReservedHeight">940</x:Double>
  <x:Double x:Key="StageMaxWidthWide">1114</x:Double>
  <!-- 264: the reference panel scaled to this card width. 248 read 6% short. -->
  <x:Double x:Key="MapPanelHeight">280</x:Double>

</ResourceDictionary>








