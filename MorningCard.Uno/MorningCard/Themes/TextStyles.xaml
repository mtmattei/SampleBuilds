<!--
  The card's type scale, each style based on the nearest Material role so the ramp still reads as
  Material where sizes are not overridden. This is the only file that sets a font size: pages and
  controls pick a style.

  LineHeight is deliberately unset everywhere: TextBlock.IsTextScaleFactorEnabled defaults true, so
  at 200% Android font scale a fixed line box clips the grown glyphs.

  CharacterSpacing is a no-op on the Skia text stack, so the prototype's -0.02em and -0.03em
  tracking on the title and the ETA number is not carried over.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 30 / 600: the drive time in the map ETA block. -->
  <Style x:Key="EtaNumber" TargetType="TextBlock" BasedOn="{StaticResource DisplayMedium}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- The ETA's unit. A Run cannot take a Style, so the size lives here as a token. -->
  <x:Double x:Key="EtaUnitSize">15</x:Double>

  <!-- 34 / 600: the trip title. Measured against the reference at 23, where its ink came back a
       third short in both axes - the headline read at nearly subtitle weight. -->
  <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- 16 / 600: stat values. -->
  <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- 15 / 400: the leave-in sentence and the arrival line. -->
  <Style x:Key="CardBody" TargetType="TextBlock" BasedOn="{StaticResource BodyLarge}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontRegular}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2Brush}" />
  </Style>

  <!-- 14 / 400: the greeting. -->
  <Style x:Key="CardLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontRegular}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2Brush}" />
  </Style>

  <!-- 13.5 / 600: the traffic verdict, which carries its own semantic colour. -->
  <Style x:Key="CardLabelStrong" TargetType="TextBlock" BasedOn="{StaticResource CardLabel}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <!-- 13 / 400: action labels and simulator text. -->
  <Style x:Key="ActionLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelLarge}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontRegular}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- 12.5 / 400 in Ink3: the traffic sub-line, stat captions, car status, secondary action lines. -->
  <Style x:Key="CardCaption" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontRegular}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{ThemeResource Ink3Brush}" />
  </Style>

  <!-- 12.5 / 500: the car's name. -->
  <Style x:Key="CardCaptionStrong" TargetType="TextBlock" BasedOn="{StaticResource CardCaption}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- 23 / 600: the empty and error headline inside the map panel. Shares CardTitle's size: 22 sat one pixel away for no reason. -->
  <Style x:Key="EmptyTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontSize" Value="23" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- 13 / 600: the simulator's own heading. -->
  <Style x:Key="PanelHeading" TargetType="TextBlock" BasedOn="{StaticResource LabelLarge}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>


  <!-- 13 / 400: the status strip above the headline. -->
  <Style x:Key="StatusLine" TargetType="TextBlock" BasedOn="{StaticResource CardCaption}">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Same size, ink-weight: the temperature and conditions read as values, not captions. -->
  <Style x:Key="StatusLineStrong" TargetType="TextBlock" BasedOn="{StaticResource StatusLine}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- 17 / 500: the headline under the title; its emphasis Run is 27 / 600 (LeadEmphasisSize). -->
  <Style x:Key="CardLead" TargetType="TextBlock" BasedOn="{StaticResource CardBody}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2Brush}" />
  </Style>

  <!-- 17 / 500: the left label column of a list row. -->
  <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource CardBody}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2Brush}" />
  </Style>

  <!-- 18 / 600: a list row's primary value. -->
  <Style x:Key="RowValueStrong" TargetType="TextBlock" BasedOn="{StaticResource CardBody}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>


  <!-- 10 / 600 caps: the ruler key-time labels (LEAVE BY, ARRIVE, BELL). Was 11 / 500 uppercase: the timeline's column labels. CharacterSpacing is a no-op on the Skia
       text stack, so the letterspacing the design shows is not attempted here. -->
  <Style x:Key="TimelineLabel" TargetType="TextBlock" BasedOn="{StaticResource CardCaption}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{ThemeResource CapsBrush}" />
  </Style>

  <!-- 19 / 600: the key times over the ruler. -->
  <Style x:Key="TimelineTime" TargetType="TextBlock" BasedOn="{StaticResource CardBody}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- v6 roles (phone). -->
  <x:Double x:Key="LeadEmphasisSize">27</x:Double>

  <!-- 15 / 600: "Good morning, Josh". -->
  <Style x:Key="GreetingText" TargetType="TextBlock" BasedOn="{StaticResource TitleSmall}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{ThemeResource InkStrongBrush}" />
  </Style>

  <!-- 13 / 500 in Ink3: the weather line and "Now 7:24". -->
  <Style x:Key="HeaderMeta" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource Ink3Brush}" />
  </Style>

  <!-- 10.5 / 600 caps: "DRIVE TO SCHOOL". -->
  <Style x:Key="CapsCaption" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{ThemeResource CapsBrush}" />
  </Style>

  <!-- 11.5 / 600: a ruler segment label ("Slack 9 min"); colour comes from the segment. -->
  <Style x:Key="SegmentLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <!-- 15 / 600: "Before you go". -->
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleSmall}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{ThemeResource InkStrongBrush}" />
  </Style>

  <!-- 15.5 / 550 (rendered 500): a checklist row title. -->
  <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyLarge}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="Foreground" Value="{ThemeResource InkStrongBrush}" />
  </Style>

  <!-- 13 / 400 in Ink3: a checklist row meta line and the ready count. -->
  <Style x:Key="RowMeta" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontRegular}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource Ink3Brush}" />
  </Style>

  <!-- 14 / 400 in Ink2: a checklist row detail paragraph. -->
  <Style x:Key="RowDetail" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontRegular}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2Brush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 12 / 550 (rendered 500): status pills ("Until 9:30", "Warming"). -->
  <Style x:Key="PillText" TargetType="TextBlock" BasedOn="{StaticResource LabelMedium}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
</ResourceDictionary>
