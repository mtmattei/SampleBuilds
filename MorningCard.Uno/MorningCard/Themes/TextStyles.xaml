<!--
  The card's type scale, each style based on the nearest Material role so the ramp still reads as
  Material where sizes are not overridden. This is the only file that sets a font size: pages and
  controls pick a style.

  LineHeight is deliberately unset everywhere: TextBlock.IsTextScaleFactorEnabled defaults true, so
  at 200% Android font scale a fixed line box clips the grown glyphs.

  CharacterSpacing is a no-op on the Skia text stack, so the prototype's -0.02em and -0.03em
  tracking on the title and the ETA number is not carried over.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    48 / 600: the trip duration, still the largest figure on the card. Nothing on the card is bold
    for emphasis alone, so size carries the hierarchy and weight stops at semibold.
  -->
  <Style x:Key="EtaNumber" TargetType="TextBlock" BasedOn="{StaticResource DisplayMedium}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="48" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- The ETA's unit, scaled with the number (22 at 52). A Run cannot take a Style, so the size
       lives here as a token. -->
  <x:Double x:Key="EtaUnitSize">20</x:Double>

  <!-- 34 / 600: the trip title. The design's tracking change (less negative) is not carried over:
       CharacterSpacing is a no-op on the Skia text stack. -->
  <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>


  <!-- 15 / 400: the leave-in sentence and the arrival line. -->
  <Style x:Key="CardBody" TargetType="TextBlock" BasedOn="{StaticResource BodyLarge}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontRegular}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2Brush}" />
  </Style>

  <!-- 14 / 400: the greeting. -->
  <Style x:Key="CardLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontRegular}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2Brush}" />
  </Style>

  <!-- 14 / 600: the traffic verdict, which carries its own semantic colour. -->
  <Style x:Key="CardLabelStrong" TargetType="TextBlock" BasedOn="{StaticResource CardLabel}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
  </Style>

  <!-- 13 / 400: action labels and simulator text. -->
  <Style x:Key="ActionLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelLarge}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontRegular}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- 12.5 / 400: stat captions, car status, secondary action lines. -->
  <Style x:Key="CardCaption" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontRegular}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2Brush}" />
  </Style>


  <!-- 23 / 600: the empty and error headline inside the map panel. Shares CardTitle's size: 22 sat one pixel away for no reason. -->
  <Style x:Key="EmptyTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontSize" Value="23" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- 13 / 600: the simulator's own heading. -->
  <Style x:Key="PanelHeading" TargetType="TextBlock" BasedOn="{StaticResource LabelLarge}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>


  <!-- 13 / 400: the status strip above the headline. -->
  <Style x:Key="StatusLine" TargetType="TextBlock" BasedOn="{StaticResource CardCaption}">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Same size, ink-weight: the temperature and conditions read as values, not captions. -->
  <Style x:Key="StatusLineStrong" TargetType="TextBlock" BasedOn="{StaticResource StatusLine}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>

  <!-- 19 / 400: the sentence under the title, which carries the accented duration inline. -->
  <Style x:Key="CardLead" TargetType="TextBlock" BasedOn="{StaticResource CardBody}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2Brush}" />
  </Style>


  <!-- 18 / 600: a list row's primary value. -->
  <Style x:Key="RowValueStrong" TargetType="TextBlock" BasedOn="{StaticResource CardBody}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>


  <!-- 11 / 500 uppercase: the timeline's column labels. CharacterSpacing is a no-op on the Skia
       text stack, so the letterspacing the design shows is not attempted here. -->
  <Style x:Key="TimelineLabel" TargetType="TextBlock" BasedOn="{StaticResource CardCaption}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontMedium}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource Ink3Brush}" />
  </Style>

  <!-- 21 / 600: the times over the track. -->
  <Style x:Key="TimelineTime" TargetType="TextBlock" BasedOn="{StaticResource CardBody}">
    <Setter Property="FontFamily" Value="{StaticResource CardFontSemiBold}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>
</ResourceDictionary>



