<Project Sdk="Uno.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\MorningCard.Core\MorningCard.Core.csproj" />
    <PackageReference Include="Mapsui.Uno.WinUI" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common.Java8" Condition="'$(TargetPlatformIdentifier)' == 'android'" />
  </ItemGroup>

  <!--
    Android Auto: the Car App Library reads its API level from car-app-api.level, a Java resource in
    its classes.jar; without it the host's GET_APP_VERSION call throws and Android Auto closes the
    app. .NET for Android keeps jar resources only when a packaging rule includes them, and it reads
    the library's jar only on builds that re-extract the AAR, so incremental builds dropped it.
  -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <AndroidPackagingOptionsInclude Include="car-app-api.level" />
  </ItemGroup>

  <!--
    WORKAROUND(car-app-api.level dropped on incremental builds): an incremental APK update drops the
    library's jar resources on every other build (present, missing, present across three builds with
    a C# change between them, Debug and Release). Packaging from a fresh intermediate APK keeps them.
  -->
  <Target Name="MorningCardFreshApk" BeforeTargets="_BuildApkEmbed" Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <Delete Files="$(ApkFileIntermediate)" />
  </Target>

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-desktop</TargetFrameworks>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>MorningCard</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.morningcard</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>MorningCard</ApplicationPublisher>
    <!-- Package Description -->
    <Description>MorningCard powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Configuration;
      Localization;
      Navigation;
      SkiaRenderer;
      AndroidTV;
      AndroidWear;
      AndroidAuto;
    </UnoFeatures>
  </PropertyGroup>

</Project>
