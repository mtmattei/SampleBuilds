<Page x:Class="MorningCard.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="using:MorningCard.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource GroundBrush}"
      utu:StatusBar.Foreground="Auto"
      utu:StatusBar.Background="{ThemeResource GroundBrush}">

  <Grid>
    <!--
      The backdrop is full bleed: safe-area insets go on the scrolling content instead, so the blur
      runs under the status bar rather than stopping at it.
    -->
    <mc:BokehBackdrop />

    <ScrollViewer utu:SafeArea.Insets="Left,Top,Right,Bottom"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Padding="16,36,16,56" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- A star column with a max width, never a content-sized panel: an empty state must not
             collapse the card to the width of its longest word. -->
        <Grid MaxWidth="{ThemeResource CardMaxWidth}" HorizontalAlignment="Stretch">
          <mc:MorningCardView />
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
