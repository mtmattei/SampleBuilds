<Page x:Class="MorningCard.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="using:MorningCard.Controls"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource GroundBrush}"
      utu:StatusBar.Foreground="Auto"
      utu:StatusBar.Background="{ThemeResource GroundBrush}">

  <Grid>
    <!-- v6 ground is flat (no bokeh): the page background carries it. -->
    <ScrollViewer utu:SafeArea.Insets="Left,Top,Right,Bottom"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <!-- A star column with a max width, never a content-sized panel: an empty state must not
           collapse the card to the width of its longest word. -->
      <!-- The containing Grid is a region too. Without it the nested Simulator region resolves
           only because its route is IsDefault and nothing ever issues a Navigation.Request; a
           second region, or any ./Simulator request, would not resolve. -->
      <Grid x:Name="Stage"
            uen:Region.Attached="True"
            Padding="16,36,16,56"
            HorizontalAlignment="Stretch"
            MaxWidth="{StaticResource StageMaxWidthWide}"
            RowSpacing="24">
        <Grid.RowDefinitions>
          <!-- Auto with a floor, not a fixed height: a narrower window makes the card taller than
               the reserve, and it has to be allowed to grow past it. -->
          <RowDefinition Height="Auto" MinHeight="{StaticResource CardReservedHeight}" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          Content-sized, never a column filler: as tall as it has something to say. It carries the
          card width itself now, because the stage is wider than the card - the Simulator row below
          needs the room, and clamping the stage to the card clipped most of its dials away.
        -->
        <mc:MorningCardView VerticalAlignment="Top"
                            MaxWidth="{StaticResource CardMaxWidth}" />

        <!--
          The Simulator is a row under the card at every width, not a second column at 1140. Beside
          the card it read as a panel of equal weight to the product, and it set the height of the
          row the card sat in - a stretched card grew about 290 px of empty glass under its action
          row. Under the card it stays what it is: stage machinery.
        -->

        <ContentControl x:Name="SimulatorRegion"
                        Grid.Row="1"
                        uen:Region.Attached="True"
                        uen:Region.Name="Simulator"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Top" />

      </Grid>
    </ScrollViewer>
  </Grid>
</Page>




