<UserControl x:Class="MorningCard.Presentation.TuningPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI">

  <Border Background="{ThemeResource GlassSecondaryBrush}"
          BorderBrush="{ThemeResource GlassEdgeBrush}"
          BorderThickness="1"
          CornerRadius="{ThemeResource MapCornerRadius}"
          Padding="20,18,20,20">
    <StackPanel Spacing="12">

      <TextBlock x:Uid="SimulatorTitle" Style="{StaticResource PanelHeading}" />
      <TextBlock x:Uid="SimulatorNote"
                 Style="{StaticResource ActionLabel}"
                 Foreground="{ThemeResource Ink2Brush}"
                 TextWrapping="Wrap" />

      <!--
        Single select: exactly one mode is always in force.

        The stray mark these chips used to show in captures was not a defect here. A subtree dump
        (MC_PROBE_CHIPS) reports exactly one TextBlock per chip, untrimmed and unoverlapped, and the
        marks vanish on any second relayout: they were stale pixels left behind when the capture
        script collapsed the app's 1024x640 wide stage straight to a tall narrow window, so the band
        the chips land in still held text from the previous layout. Fixed in Capture-Tall.ps1 by
        sizing twice.
      -->
      <utu:ChipGroup x:Name="ModeChips"
                     ItemsSource="{Binding Modes}"
                     SelectedItem="{Binding Mode, Mode=TwoWay}"
                     SelectionMode="SingleOrNone"
                     Style="{StaticResource FilterChipGroupStyle}" />

      <StackPanel Spacing="2">
        <Grid>
          <TextBlock x:Name="LabelClock" x:Uid="DialClock" Style="{StaticResource ActionLabel}" />
          <TextBlock Style="{StaticResource ActionLabel}"
                     HorizontalAlignment="Right"
                     Foreground="{ThemeResource Ink2Brush}"
                     Text="{Binding ClockText}" />
        </Grid>
        <Slider AutomationProperties.LabeledBy="{Binding ElementName=LabelClock}" Minimum="420" Maximum="490" StepFrequency="1" Value="{Binding Clock, Mode=TwoWay}" />
      </StackPanel>

      <StackPanel Spacing="2">
        <Grid>
          <TextBlock x:Name="LabelTraffic" x:Uid="DialTraffic" Style="{StaticResource ActionLabel}" />
          <TextBlock Style="{StaticResource ActionLabel}"
                     HorizontalAlignment="Right"
                     Foreground="{ThemeResource Ink2Brush}"
                     Text="{Binding TrafficDelay}" />
        </Grid>
        <Slider AutomationProperties.LabeledBy="{Binding ElementName=LabelTraffic}" Minimum="0" Maximum="25" StepFrequency="1" Value="{Binding TrafficDelay, Mode=TwoWay}" />
      </StackPanel>

      <StackPanel Spacing="2">
        <Grid>
          <TextBlock x:Name="LabelRange" x:Uid="DialRange" Style="{StaticResource ActionLabel}" />
          <TextBlock Style="{StaticResource ActionLabel}"
                     HorizontalAlignment="Right"
                     Foreground="{ThemeResource Ink2Brush}"
                     Text="{Binding Range}" />
        </Grid>
        <Slider AutomationProperties.LabeledBy="{Binding ElementName=LabelRange}" Minimum="0" Maximum="400" StepFrequency="2" Value="{Binding Range, Mode=TwoWay}" />
      </StackPanel>

      <StackPanel Spacing="2">
        <Grid>
          <TextBlock x:Name="LabelCabin" x:Uid="DialCabin" Style="{StaticResource ActionLabel}" />
          <TextBlock Style="{StaticResource ActionLabel}"
                     HorizontalAlignment="Right"
                     Foreground="{ThemeResource Ink2Brush}"
                     Text="{Binding CabinTemp}" />
        </Grid>
        <Slider AutomationProperties.LabeledBy="{Binding ElementName=LabelCabin}" Minimum="10" Maximum="80" StepFrequency="1" Value="{Binding CabinTemp, Mode=TwoWay}" />
      </StackPanel>

      <StackPanel Spacing="2">
        <Grid>
          <TextBlock x:Name="LabelTire" x:Uid="DialTire" Style="{StaticResource ActionLabel}" />
          <TextBlock Style="{StaticResource ActionLabel}"
                     HorizontalAlignment="Right"
                     Foreground="{ThemeResource Ink2Brush}"
                     Text="{Binding TirePressure}" />
        </Grid>
        <Slider AutomationProperties.LabeledBy="{Binding ElementName=LabelTire}" Minimum="20" Maximum="36" StepFrequency="1" Value="{Binding TirePressure, Mode=TwoWay}" />
      </StackPanel>

      <Grid>
        <TextBlock x:Name="LabelPlug" x:Uid="DialPlug" Style="{StaticResource ActionLabel}" VerticalAlignment="Center" />
        <ToggleSwitch AutomationProperties.LabeledBy="{Binding ElementName=LabelPlug}" HorizontalAlignment="Right" IsOn="{Binding PluggedIn, Mode=TwoWay}" OnContent="" OffContent="" />
      </Grid>

      <!-- Charge only means something while the car is plugged in. -->
      <StackPanel Spacing="2" IsEnabled="{Binding PluggedIn}">
        <Grid>
          <TextBlock x:Name="LabelCharge" x:Uid="DialCharge" Style="{StaticResource ActionLabel}" />
          <TextBlock Style="{StaticResource ActionLabel}"
                     HorizontalAlignment="Right"
                     Foreground="{ThemeResource Ink2Brush}"
                     Text="{Binding ChargePercent}" />
        </Grid>
        <Slider AutomationProperties.LabeledBy="{Binding ElementName=LabelCharge}" Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ChargePercent, Mode=TwoWay}" />
      </StackPanel>

      <StackPanel Spacing="2">
        <Grid>
          <TextBlock x:Name="LabelHue" x:Uid="DialHue" Style="{StaticResource ActionLabel}" />
          <TextBlock Style="{StaticResource ActionLabel}"
                     HorizontalAlignment="Right"
                     Foreground="{ThemeResource Ink2Brush}"
                     Text="{Binding Hue}" />
        </Grid>
        <Slider AutomationProperties.LabeledBy="{Binding ElementName=LabelHue}" Minimum="0" Maximum="360" StepFrequency="1" Value="{Binding Hue, Mode=TwoWay}" />
      </StackPanel>

      <StackPanel Spacing="2">
        <Grid>
          <TextBlock x:Name="LabelRadius" x:Uid="DialRadius" Style="{StaticResource ActionLabel}" />
          <TextBlock Style="{StaticResource ActionLabel}"
                     HorizontalAlignment="Right"
                     Foreground="{ThemeResource Ink2Brush}"
                     Text="{Binding CornerRadius}" />
        </Grid>
        <Slider AutomationProperties.LabeledBy="{Binding ElementName=LabelRadius}" Minimum="12" Maximum="44" StepFrequency="1" Value="{Binding CornerRadius, Mode=TwoWay}" />
      </StackPanel>

      <StackPanel Spacing="2">
        <Grid>
          <TextBlock x:Name="LabelMotion" x:Uid="DialMotion" Style="{StaticResource ActionLabel}" />
          <TextBlock Style="{StaticResource ActionLabel}"
                     HorizontalAlignment="Right"
                     Foreground="{ThemeResource Ink2Brush}"
                     Text="{Binding MotionSpeed}" />
        </Grid>
        <Slider AutomationProperties.LabeledBy="{Binding ElementName=LabelMotion}" Minimum="0.25" Maximum="2" StepFrequency="0.25" Value="{Binding MotionSpeed, Mode=TwoWay}" />
      </StackPanel>

      <!-- Desktop has no OS reduced-motion signal in Uno, so this switch is it. -->
      <Grid>
        <TextBlock x:Name="LabelReduced" x:Uid="DialReducedMotion" Style="{StaticResource ActionLabel}" VerticalAlignment="Center" />
        <ToggleSwitch AutomationProperties.LabeledBy="{Binding ElementName=LabelReduced}" HorizontalAlignment="Right" IsOn="{Binding ReducedMotion, Mode=TwoWay}" OnContent="" OffContent="" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <Button x:Uid="ButtonReplay" Style="{StaticResource OutlinedButtonStyle}" Command="{Binding ReplayEntrance}" />
        <Button x:Uid="ButtonTheme" Style="{StaticResource OutlinedButtonStyle}" Command="{Binding ToggleTheme}" />
      </StackPanel>

    </StackPanel>
  </Border>
</UserControl>



