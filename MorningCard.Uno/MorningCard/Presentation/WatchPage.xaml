<Page x:Class="MorningCard.Presentation.WatchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="using:MorningCard.Controls"
      Background="{ThemeResource GlassBrush}">

  <!--
    Wear OS (v6 artboard wear_os.png). The artboard is drawn in physical pixels on a 454 px round
    watch, about 227 epx wide, so laying out at a 454 wide design space inside a Viewbox reproduces
    its scale exactly. One vertical ScrollViewer and no horizontal paging, which would fight the
    system swipe-to-dismiss (Uno Wear docs). Wide side insets keep content off the round bezel.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top">
      <StackPanel Width="454" Padding="56,56,56,120" Spacing="40">
        <mc:HeaderPart />
        <mc:TripPart />
        <mc:MapPart Height="300" />
        <mc:ChecksPart />
        <mc:FooterPart />
      </StackPanel>
    </Viewbox>
  </ScrollViewer>
</Page>
