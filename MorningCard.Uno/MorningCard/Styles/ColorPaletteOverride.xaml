<!--
  Material's roles pointed at the card's palette, so stock controls (Slider, Chip, Button) sit next
  to the card without fighting it.

  The values are duplicated from Themes/CardTokens.xaml rather than referenced: the Material theme
  loads this file itself, before the app's own dictionaries exist. Green and amber stay out of here
  on purpose - they are semantic, not roles, and mapping them onto Secondary or Tertiary would let
  a control pick up "good" or "warning" colour by accident.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#4A6B8A</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#E1E8EF</Color>
      <Color x:Key="OnPrimaryContainerColor">#33506B</Color>
      <Color x:Key="SecondaryColor">#55585C</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#EAE7E0</Color>
      <Color x:Key="OnSecondaryContainerColor">#2A2C2F</Color>
      <Color x:Key="TertiaryColor">#3F5C78</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#E1E8EF</Color>
      <Color x:Key="OnTertiaryContainerColor">#33506B</Color>
      <Color x:Key="ErrorColor">#9C4A3E</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#F3E3E0</Color>
      <Color x:Key="OnErrorContainerColor">#8C4236</Color>
      <Color x:Key="BackgroundColor">#E9E6DF</Color>
      <Color x:Key="OnBackgroundColor">#2A2C2F</Color>
      <Color x:Key="SurfaceColor">#FBFAF7</Color>
      <Color x:Key="OnSurfaceColor">#2A2C2F</Color>
      <Color x:Key="SurfaceVariantColor">#F1EFE9</Color>
      <Color x:Key="OnSurfaceVariantColor">#55585C</Color>
      <Color x:Key="OutlineColor">#A5A199</Color>
      <Color x:Key="OutlineVariantColor">#DAD6CE</Color>
      <Color x:Key="SurfaceInverseColor">#2B2D30</Color>
      <Color x:Key="OnSurfaceInverseColor">#FBFAF7</Color>
      <Color x:Key="PrimaryInverseColor">#A9BDD0</Color>
      <Color x:Key="SurfaceTintColor">#4A6B8A</Color>
    </ResourceDictionary>


  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
