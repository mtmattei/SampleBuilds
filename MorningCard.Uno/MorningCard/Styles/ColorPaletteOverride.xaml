<!--
  Material's roles pointed at the card's palette, so stock controls (Slider, Chip, Button) sit next
  to the card without fighting it.

  The values are duplicated from Themes/CardTokens.xaml rather than referenced: the Material theme
  loads this file itself, before the app's own dictionaries exist. Green and amber stay out of here
  on purpose - they are semantic, not roles, and mapping them onto Secondary or Tertiary would let
  a control pick up "good" or "warning" colour by accident.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#2169E9</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#DCE7FD</Color>
      <Color x:Key="OnPrimaryContainerColor">#0A1F44</Color>
      <Color x:Key="SecondaryColor">#5B6570</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#E3E6E9</Color>
      <Color x:Key="OnSecondaryContainerColor">#1B2430</Color>
      <Color x:Key="TertiaryColor">#2057B6</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#D8E4F8</Color>
      <Color x:Key="OnTertiaryContainerColor">#0A1F44</Color>
      <Color x:Key="ErrorColor">#D9453A</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#FADBD8</Color>
      <Color x:Key="OnErrorContainerColor">#4A100C</Color>
      <Color x:Key="BackgroundColor">#D9D6D0</Color>
      <Color x:Key="OnBackgroundColor">#1B2430</Color>
      <Color x:Key="SurfaceColor">#D9D6D0</Color>
      <Color x:Key="OnSurfaceColor">#1B2430</Color>
      <Color x:Key="SurfaceVariantColor">#E6E4E0</Color>
      <Color x:Key="OnSurfaceVariantColor">#5B6570</Color>
      <Color x:Key="OutlineColor">#98A1AB</Color>
      <Color x:Key="OutlineVariantColor">#C6CBD0</Color>
      <Color x:Key="SurfaceInverseColor">#1B2430</Color>
      <Color x:Key="OnSurfaceInverseColor">#F0F3F6</Color>
      <Color x:Key="PrimaryInverseColor">#5A93F6</Color>
      <Color x:Key="SurfaceTintColor">#2169E9</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#5A93F6</Color>
      <Color x:Key="OnPrimaryColor">#0F151C</Color>
      <Color x:Key="PrimaryContainerColor">#1B3A5C</Color>
      <Color x:Key="OnPrimaryContainerColor">#D8E6FF</Color>
      <Color x:Key="SecondaryColor">#A9B3BD</Color>
      <Color x:Key="OnSecondaryColor">#10151C</Color>
      <Color x:Key="SecondaryContainerColor">#2C3540</Color>
      <Color x:Key="OnSecondaryContainerColor">#F0F3F6</Color>
      <Color x:Key="TertiaryColor">#77A6F8</Color>
      <Color x:Key="OnTertiaryColor">#0F151C</Color>
      <Color x:Key="TertiaryContainerColor">#23405A</Color>
      <Color x:Key="OnTertiaryContainerColor">#D8E6FF</Color>
      <Color x:Key="ErrorColor">#EF6A5F</Color>
      <Color x:Key="OnErrorColor">#10151C</Color>
      <Color x:Key="ErrorContainerColor">#5C231F</Color>
      <Color x:Key="OnErrorContainerColor">#FFDAD6</Color>
      <Color x:Key="BackgroundColor">#10151C</Color>
      <Color x:Key="OnBackgroundColor">#F0F3F6</Color>
      <Color x:Key="SurfaceColor">#10151C</Color>
      <Color x:Key="OnSurfaceColor">#F0F3F6</Color>
      <Color x:Key="SurfaceVariantColor">#222932</Color>
      <Color x:Key="OnSurfaceVariantColor">#A9B3BD</Color>
      <Color x:Key="OutlineColor">#6F7A86</Color>
      <Color x:Key="OutlineVariantColor">#39414B</Color>
      <Color x:Key="SurfaceInverseColor">#F0F3F6</Color>
      <Color x:Key="OnSurfaceInverseColor">#10151C</Color>
      <Color x:Key="PrimaryInverseColor">#2169E9</Color>
      <Color x:Key="SurfaceTintColor">#5A93F6</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
