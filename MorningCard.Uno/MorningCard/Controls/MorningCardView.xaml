<UserControl x:Class="MorningCard.Controls.MorningCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="using:MorningCard.Controls"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             xmlns:uen="using:Uno.Extensions.Navigation.UI"
             xmlns:mapsui="using:Mapsui.UI.WinUI"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:theme="using:MorningCard.Themes"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">



  <!--
    v6: a warm shell (the card) holding one paper panel, with the header and the footer on the shell.
    The shadow canvas sits at a negative margin so the wide blur has room; hit-test transparent.
  -->
  <Grid>
    <mc:CardShadowCanvas />

    <!-- The shell: Filled card, coloured through the FilledCardContent* keys in CardTokens. The
         radius dial writes Glass.CornerRadius in code-behind. BorderThickness is the 1 px inset
         top highlight. -->
    <utu:CardContentControl x:Name="Glass"
                            Style="{StaticResource FilledCardContentControlStyle}"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}"
                            BorderThickness="0,1,0,0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
    <Grid RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============================ header ============================ -->
      <mc:HeaderPart />

      <!-- ============================ panel ============================ -->
      <!-- The paper panel: Outlined card, coloured through the OutlinedCardContent* keys. Radius
           and padding are local because the shared CardCornerRadius/CardPadding keys hold the
           shell's values. -->
      <utu:CardContentControl Grid.Row="1"
                              Style="{StaticResource OutlinedCardContentControlStyle}"
                              Margin="0"
                              HorizontalAlignment="Stretch"
                              CornerRadius="{StaticResource CardInnerCornerRadius}"
                              Padding="20"
                              BorderThickness="1"
                              HorizontalContentAlignment="Stretch">
        <StackPanel>
          <mc:TripPart />
          <mc:MapPart Margin="0,18,0,0" Height="{StaticResource MapPanelHeight}" />
          <mc:ChecksPart Margin="0,12,0,0" />
        </StackPanel>
      </utu:CardContentControl>

      <!-- ============================ footer ============================ -->
      <mc:FooterPart Grid.Row="2" />

    </Grid>
    </utu:CardContentControl>
  </Grid>
</UserControl>
