<UserControl x:Class="MorningCard.Controls.MorningCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="using:MorningCard.Controls"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             xmlns:uen="using:Uno.Extensions.Navigation.UI"
             xmlns:mapsui="using:Mapsui.UI.WinUI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

  <UserControl.Resources>
    <!--
      Shared by ProgressTemplate and NoneTemplate. A feed that has never yielded reaches the view as
      None, not Progress - Feed.Combine fast-starts to None as soon as a parent has no value - so
      handling only Progress left the card as a bare map with no header and no rows.
    -->
    <DataTemplate x:Key="HeaderSkeleton"><StackPanel Spacing="12">
              <Border Width="240" Height="13" HorizontalAlignment="Left" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource ChipBrush}" />
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="10" VerticalAlignment="Center">
                  <Border Width="210" Height="30" HorizontalAlignment="Left" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource ChipBrush}" />
                  <Border Width="250" Height="17" HorizontalAlignment="Left" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource ChipBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Width="150" Height="86" CornerRadius="{StaticResource MapCornerRadius}" Background="{ThemeResource ChipBrush}" />
              </Grid>
              <Border Width="280" Height="13" HorizontalAlignment="Left" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource ChipBrush}" />
            </StackPanel></DataTemplate>

    <DataTemplate x:Key="RowsSkeleton"><StackPanel>
              <Grid Style="{StaticResource ListRowStyle}">
                <Border Width="200" Height="17" HorizontalAlignment="Left" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource ChipBrush}" />
              </Grid>
              <Rectangle Style="{StaticResource RowRule}" />
              <Grid Style="{StaticResource ListRowStyle}">
                <Border Width="240" Height="17" HorizontalAlignment="Left" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource ChipBrush}" />
              </Grid>
              <Rectangle Style="{StaticResource RowRule}" />
              <Grid Style="{StaticResource ListRowStyle}">
                <Border Width="180" Height="17" HorizontalAlignment="Left" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource ChipBrush}" />
              </Grid>
            </StackPanel></DataTemplate>
  </UserControl.Resources>

  <!--
    The card is a Border over a childless glass sibling. Keeping the translucent fill on its own
    element leaves the content free of the backdrop, which is also what the Skia acrylic path wants
    on Android.
  -->
  <Grid>
    <!-- Sits at a negative margin so the wide blur has room; hit-test transparent. -->
    <mc:CardShadowCanvas />

    <Border x:Name="Glass"
            Background="{ThemeResource GlassBrush}"
            BorderBrush="{ThemeResource GlassEdgeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}" />

    <Grid Padding="{StaticResource CardPadding}" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <mvux:FeedView Source="{Binding Header}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <StackPanel Spacing="12">

              <!-- ======================== status strip ======================== -->
              <!--
                Greeting, lock state and weather on one caption-weight line. It absorbs the car
                status that used to sit under the car image, and it is read-only: since v2 the card
                reports lock state but cannot change it.
              -->
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Stroke="{ThemeResource SunInkBrush}"
                            StrokeThickness="1.9"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M12 4V2M12 22v-2M4 12H2M22 12h-2M5.6 5.6 4.2 4.2M19.8 19.8l-1.4-1.4M5.6 18.4l-1.4 1.4M19.8 4.2l-1.4 1.4" />
                      <Ellipse Canvas.Left="7.5"
                               Canvas.Top="7.5"
                               Width="9"
                               Height="9"
                               Fill="{ThemeResource SunInkBrush}" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Style="{StaticResource StatusLine}"
                             VerticalAlignment="Center"
                             Text="{Binding Data.Greeting}" />
                </StackPanel>

                <Rectangle Grid.Column="1"
                           Width="1"
                           Height="14"
                           VerticalAlignment="Center"
                           Fill="{ThemeResource LineBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
                  <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Stroke="{ThemeResource Ink2Brush}"
                            StrokeThickness="1.9"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zM8 11V8a4 4 0 0 1 8 0v3" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Style="{StaticResource StatusLine}"
                             VerticalAlignment="Center"
                             Text="{Binding Data.LockText}" />
                </StackPanel>

                <TextBlock Grid.Column="4"
                           Style="{StaticResource StatusLineStrong}"
                           VerticalAlignment="Center"
                           Text="{Binding Data.OutsideTemp}" />

                <Rectangle Grid.Column="5"
                           Width="1"
                           Height="14"
                           VerticalAlignment="Center"
                           Fill="{ThemeResource LineBrush}" />

                <TextBlock Grid.Column="6"
                           Style="{StaticResource StatusLineStrong}"
                           VerticalAlignment="Center"
                           Text="{Binding Data.WeatherSummary}" />
              </Grid>

              <!-- ======================== headline ======================== -->
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource CardTitle}"
                               VerticalAlignment="Center"
                               Text="{Binding Data.Title}" />
                    <Viewbox Width="22" Height="22" VerticalAlignment="Center" Margin="0,3,0,0">
                      <Canvas Width="24" Height="24">
                        <Path Stroke="{ThemeResource Ink2Brush}"
                              StrokeThickness="2.2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M9 6l6 6-6 6" />
                      </Canvas>
                    </Viewbox>
                  </StackPanel>

                  <!--
                    One TextBlock, three Runs. Only the middle one takes the accent colour, which is
                    how the design puts the duration in blue without splitting the sentence into
                    separate blocks that would not share a baseline.
                  -->
                  <TextBlock Style="{StaticResource CardLead}"
                             Margin="0,4,0,0"
                             TextWrapping="Wrap"
                             Foreground="{Binding Data.Tone, Converter={StaticResource ToneBrush}}"><Run Text="{Binding Data.HeadlineLead}" /><Run Text="{Binding Data.HeadlineAccent}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" Foreground="{Binding Data.Tone, Converter={StaticResource AccentTone}}" /><Run Text="{Binding Data.HeadlineTail}" /></TextBlock>


                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Image Source="ms-appx:///Assets/Car/xc60.png"
                         Width="150"
                         Stretch="Uniform" />
                  <TextBlock Style="{StaticResource CardCaptionStrong}"
                             HorizontalAlignment="Center"
                             Margin="0,2,0,0"
                             Text="{Binding Data.CarName}" />
                </StackPanel>
              </Grid>

              <!--
                Times, then traffic in its severity colour. Both strings carry their own
                separators and punctuation: adjacent Runs are joined with whatever whitespace
                sits between them in the markup, which put a space before the late headline's
                full stop and doubled every middot here.
              -->
              <TextBlock Style="{StaticResource CardCaption}"
                         Margin="0,3,0,0"
                         TextWrapping="Wrap"
                         Visibility="{Binding Data.TimesLine, Converter={StaticResource NullToVisibility}}"><Run Text="{Binding Data.TimesLine}" /><Run Text="{Binding Data.TrafficText}" FontFamily="{StaticResource CardFontMedium}" Foreground="{Binding Data.Traffic, Converter={StaticResource TrafficBrush}}" /></TextBlock>
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>

        <!--
          Without this the whole header vanished while the feeds were still in progress and the card
          collapsed to a bare map. The skeleton carries the same footprint, so nothing jumps when
          the data lands.
        -->
        <mvux:FeedView.ProgressTemplate><StaticResource ResourceKey="HeaderSkeleton" /></mvux:FeedView.ProgressTemplate>
        <mvux:FeedView.NoneTemplate><StaticResource ResourceKey="HeaderSkeleton" /></mvux:FeedView.NoneTemplate>
      </mvux:FeedView>

      <!-- ============================ map panel ============================ -->
      <Border x:Name="MapPanel"
              Grid.Row="1"
              Height="{StaticResource MapPanelHeight}"
              CornerRadius="{StaticResource MapCornerRadius}"
              Background="{ThemeResource MapBrush}">
        <Grid>
          <!--
            Real OSM tiles since v2. The route above it stays schematic - minutes become distance
            along a path - so the drawn line deliberately does not follow the streets underneath:
            the map is a textured ground, not the route's geometry. Recorded in SPEC.md v2 as the
            accepted cost of keeping the time-as-distance device.
          -->
          <!--
            Wrapped in its own rounded Border. The panel's CornerRadius does not reach the map: it
            draws through its own surface, so the outer Border clipped everything except the tiles
            and the map showed square corners inside a rounded panel.
          -->
          <Border CornerRadius="{StaticResource MapCornerRadius}">
            <mapsui:MapControl x:Name="Map" />
          </Border>

          <mc:RouteRulerCanvas x:Name="Ruler" Eta="{Binding State.Data, ElementName=EtaFeed}" />

          <!-- Real launch, not a decorative pill: it opens the platform maps app at the school. -->
          <!-- Hidden whenever a scrim covers the map: a pill showing through "Can't reach the
               car" offers to open a trip the card just said it could not read. -->
          <Button x:Name="OpenInMaps"
                  x:Uid="OpenInMapsButton"
                  Style="{StaticResource MapPillStyle}"
                  Visibility="{Binding State.Data.Failed, ElementName=EtaFeed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, FallbackValue=Collapsed}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,12,30"
                  Click="OnOpenInMaps" />

          <mvux:FeedView x:Name="EtaFeed" Source="{Binding Eta}">

            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <Grid>
                <!--
                  The failure lives here rather than in ErrorTemplate. Measured 2026-09-21: a feed
                  built on a push stream cannot be recovered by FeedView.Refresh, so a Retry bound
                  to it executes and leaves the card broken. As a value, the stream stays alive and
                  the model's own Retry puts a good trip back through it.
                -->
                <Border x:Name="ErrorPanel"
                        Background="{ThemeResource MapScrimBrush}"
                        Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Padding="24"
                              Spacing="8">
                    <TextBlock x:Uid="ErrorTitle"
                               Style="{StaticResource EmptyTitle}"
                               TextAlignment="Center" />
                    <TextBlock Style="{StaticResource CardLabel}"
                               MaxWidth="260"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding Data.FailureMessage}" />
                    <Button x:Name="RetryButton"
                            x:Uid="ErrorRetry"
                            HorizontalAlignment="Center"
                            Command="{Binding Parent.Retry}" />
                  </StackPanel>
                </Border>
                </Grid>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>

            <!-- Nothing on the calendar: the map stays, the route goes. -->
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <Border Background="{ThemeResource MapScrimBrush}">
                  <StackPanel HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Padding="24"
                              Spacing="4">
                    <TextBlock x:Uid="EmptyTitle"
                               Style="{StaticResource EmptyTitle}"
                               TextAlignment="Center" />
                    <TextBlock x:Uid="EmptyNote"
                               Style="{StaticResource CardLabel}"
                               MaxWidth="260"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>

            <!-- Holds the panel's shape while the route is on its way, so nothing jumps. -->
            <mvux:FeedView.ProgressTemplate>
              <DataTemplate>
                <Border Background="{ThemeResource MapScrimBrush}">
                  <StackPanel Margin="18"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Spacing="10">
                    <Border Width="96" Height="13" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource ChipBrush}" />
                    <Border Width="150" Height="13" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource ChipBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </mvux:FeedView.ProgressTemplate>

          </mvux:FeedView>
        </Grid>
      </Border>

      <!-- ============================ list rows ============================ -->
      <mvux:FeedView Grid.Row="2" Source="{Binding Stats}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <StackPanel Opacity="{Binding Data.IsStale, Converter={StaticResource StaleOpacity}}">

              <!-- Fuel -->
              <Grid Style="{StaticResource ListRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="92" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{Binding Data.FuelLevel, Converter={StaticResource StatLevelBrush}}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M5 21V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v15M3 21h14M7 8h6M15 10h2a2 2 0 0 1 2 2v5.5a1.5 1.5 0 0 0 3 0V11l-3-3" />
                  </Canvas>
                </Viewbox>

                <TextBlock Grid.Column="1"
                           x:Uid="FuelLabel"
                           Style="{StaticResource RowLabel}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock>
                    <Run Text="{Binding Data.FuelValue}"
                         FontFamily="{StaticResource CardFontSemiBold}"
                         FontWeight="SemiBold"
                         FontSize="21" />
                    <Run Text="{Binding Data.FuelUnit}" FontSize="15" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource CardCaption}" Text="{Binding Data.FuelNote}" />
                </StackPanel>

                <Viewbox Grid.Column="3" Width="18" Height="18" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource Ink3Brush}"
                          StrokeThickness="2.2"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M9 6l6 6-6 6" />
                  </Canvas>
                </Viewbox>
              </Grid>

              <Rectangle Style="{StaticResource RowRule}" />

              <!-- Cabin -->
              <Grid Style="{StaticResource ListRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="92" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource AccentBrush}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M12 3a2.5 2.5 0 0 1 2.5 2.5v8.2a4.5 4.5 0 1 1-5 0V5.5A2.5 2.5 0 0 1 12 3z" />
                    <Ellipse Canvas.Left="9.5"
                             Canvas.Top="15"
                             Width="5"
                             Height="5"
                             Fill="{ThemeResource AccentBrush}" />
                  </Canvas>
                </Viewbox>

                <TextBlock Grid.Column="1"
                           Style="{StaticResource RowLabel}"
                           VerticalAlignment="Center"
                           Text="{Binding Data.CabinLabel}" />

                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap">
                  <Run Text="{Binding Data.CabinLead}" FontSize="17" />
                  <Run Text="{Binding Data.CabinFrom}"
                       FontFamily="{StaticResource CardFontSemiBold}"
                       FontWeight="SemiBold"
                       FontSize="19" />
                  <Run Text="{Binding Data.CabinMid}" FontSize="17" />
                  <Run Text="{Binding Data.CabinTo}"
                       FontFamily="{StaticResource CardFontSemiBold}"
                       FontWeight="SemiBold"
                       FontSize="19" />
                </TextBlock>

                <Viewbox Grid.Column="3" Width="18" Height="18" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource Ink3Brush}"
                          StrokeThickness="2.2"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M9 6l6 6-6 6" />
                  </Canvas>
                </Viewbox>
              </Grid>

              <Rectangle Style="{StaticResource RowRule}"
                         Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}" />

              <!-- Destination. Absent entirely on a no-trip morning rather than drawn empty. -->
              <Grid Style="{StaticResource ListRowStyle}"
                    Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="92" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Ellipse Canvas.Left="2"
                             Canvas.Top="2"
                             Width="20"
                             Height="20"
                             Stroke="{ThemeResource InkBrush}"
                             StrokeThickness="1.7" />
                    <Path Stroke="{ThemeResource InkBrush}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          Data="M10 17V7h3.2a3 3 0 0 1 0 6H10" />
                  </Canvas>
                </Viewbox>

                <TextBlock Grid.Column="1"
                           Style="{StaticResource RowLabel}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding Data.DestinationLabel}" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource RowValueStrong}"
                             TextWrapping="Wrap"
                             Text="{Binding Data.ParkingStreet}" />
                  <TextBlock Style="{StaticResource CardCaption}"
                             TextWrapping="Wrap"
                             Text="{Binding Data.ParkingNote}"
                             Visibility="{Binding Data.ParkingNote, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>

                <Viewbox Grid.Column="3" Width="18" Height="18" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource Ink3Brush}"
                          StrokeThickness="2.2"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M9 6l6 6-6 6" />
                  </Canvas>
                </Viewbox>
              </Grid>
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>

        <mvux:FeedView.ProgressTemplate><StaticResource ResourceKey="RowsSkeleton" /></mvux:FeedView.ProgressTemplate>
        <mvux:FeedView.NoneTemplate><StaticResource ResourceKey="RowsSkeleton" /></mvux:FeedView.NoneTemplate>
      </mvux:FeedView>
    </Grid>
  </Grid>
</UserControl>
