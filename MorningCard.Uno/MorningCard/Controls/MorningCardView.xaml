<UserControl x:Class="MorningCard.Controls.MorningCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="using:MorningCard.Controls"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             xmlns:uen="using:Uno.Extensions.Navigation.UI"
             xmlns:mapsui="using:Mapsui.UI.WinUI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

  <!--
    The card is a Border over a childless glass sibling. Keeping the translucent fill on its own
    element leaves the content free of the backdrop, which is also what the Skia acrylic path wants
    on Android.
  -->
  <Grid>
    <!-- Sits at a negative margin so the wide blur has room; hit-test transparent. -->
    <mc:CardShadowCanvas />

    <Border x:Name="Glass"
            Background="{ThemeResource GlassBrush}"
            BorderBrush="{ThemeResource GlassEdgeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}" />

    <Grid Padding="{StaticResource CardPadding}" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <mvux:FeedView Source="{Binding Header}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <StackPanel Spacing="12">

              <!-- ======================== status strip ======================== -->
              <!-- Greeting left, weather right. Lock moved under the car: the two halves were
                   competing for the same row and the weather half needed the room. -->
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                  <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Stroke="{ThemeResource SunInkBrush}"
                            StrokeThickness="1.9"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M12 4V2M12 22v-2M4 12H2M22 12h-2M5.6 5.6 4.2 4.2M19.8 19.8l-1.4-1.4M5.6 18.4l-1.4 1.4M19.8 4.2l-1.4 1.4" />
                      <Ellipse Canvas.Left="7.5" Canvas.Top="7.5" Width="9" Height="9" Fill="{ThemeResource SunInkBrush}" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Style="{StaticResource StatusLineStrong}"
                             VerticalAlignment="Center"
                             Text="{Binding Data.Greeting}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Border Background="{ThemeResource ChipBrush}" CornerRadius="10" Padding="9,3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Style="{StaticResource StatusLineStrong}" VerticalAlignment="Center" Text="{Binding Data.OutsideTemp}" />
                      <TextBlock Style="{StaticResource StatusLine}" VerticalAlignment="Center" Text="{Binding Data.WeatherSummary}" />
                    </StackPanel>
                  </Border>

                  <!-- The state, named. Colour alone would not carry it. -->
                  <Border CornerRadius="10"
                          Padding="9,3"
                          Background="{Binding Data.Tone, Converter={StaticResource ToneChipBrush}}">
                    <TextBlock Style="{StaticResource StatusLineStrong}"
                               VerticalAlignment="Center"
                               Foreground="{Binding Data.Tone, Converter={StaticResource ToneChipInk}}"
                               Text="{Binding Data.StatusBadge}" />
                  </Border>

                  <!--
                    A real MenuFlyout, not a decorative glyph: every item runs a command the model
                    already owns. MenuFlyoutItem invokes correctly under synthesized input on Skia
                    desktop, so this is verifiable without a human at the keyboard.
                  -->
                  <Button x:Name="Overflow"
                          x:Uid="OverflowButton"
                          Style="{StaticResource OverflowButtonStyle}"
                          VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16">
                      <Canvas Width="24" Height="24">
                        <Ellipse Canvas.Left="3.5" Canvas.Top="10.5" Width="3" Height="3" Fill="{ThemeResource Ink2Brush}" />
                        <Ellipse Canvas.Left="10.5" Canvas.Top="10.5" Width="3" Height="3" Fill="{ThemeResource Ink2Brush}" />
                        <Ellipse Canvas.Left="17.5" Canvas.Top="10.5" Width="3" Height="3" Fill="{ThemeResource Ink2Brush}" />
                      </Canvas>
                    </Viewbox>
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Name="MenuRefresh" x:Uid="MenuRefresh" Command="{Binding Parent.Retry}" />
                        <MenuFlyoutItem x:Name="MenuOpenMaps" x:Uid="MenuOpenMaps" Click="OnOpenInMaps" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuReplay" x:Uid="MenuReplay" Click="OnReplayEntrance" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- ======================== headline ======================== -->
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource CardTitle}"
                               VerticalAlignment="Center"
                               Text="{Binding Data.Title}" />
                    <Viewbox Width="22" Height="22" VerticalAlignment="Center" Margin="0,3,0,0">
                      <Canvas Width="24" Height="24">
                        <Path Stroke="{ThemeResource Ink2Brush}"
                              StrokeThickness="2.2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M9 6l6 6-6 6" />
                      </Canvas>
                    </Viewbox>
                  </StackPanel>

                  <!--
                    One TextBlock, three Runs. Only the middle one takes the accent colour, which is
                    how the design puts the duration in blue without splitting the sentence into
                    separate blocks that would not share a baseline.
                  -->
                  <TextBlock Style="{StaticResource CardLead}"
                             Margin="0,4,0,0"
                             TextWrapping="Wrap"
                             Foreground="{Binding Data.Tone, Converter={StaticResource ToneBrush}}"><Run Text="{Binding Data.HeadlineLead}" /><Run Text="{Binding Data.HeadlineAccent}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" Foreground="{Binding Data.Tone, Converter={StaticResource AccentTone}}" /><Run Text="{Binding Data.HeadlineTail}" /></TextBlock>


                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                  <!-- The car sits in its own tile, which separates it from the headline it stands
                       beside and gives the lock caption something to belong to. -->
                  <Border Background="{ThemeResource CarTileBrush}"
                          CornerRadius="{StaticResource MapCornerRadius}"
                          Padding="10,8">
                    <Image Source="ms-appx:///Assets/Car/xc60.png" Width="140" Stretch="Uniform" />
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                    <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                      <Canvas Width="24" Height="24">
                        <Path Stroke="{ThemeResource Ink2Brush}"
                              StrokeThickness="2.1"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zM8 11V8a4 4 0 0 1 8 0v3" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Style="{StaticResource CardCaption}"
                               VerticalAlignment="Center"
                               Text="{Binding Data.LockText}" />
                  </StackPanel>
                </StackPanel>
              </Grid>


            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>

        <!--
          Without this the whole header vanished while the feeds were still in progress and the card
          collapsed to a bare map. The skeleton carries the same footprint, so nothing jumps when
          the data lands.
        -->
      </mvux:FeedView>

      <!-- ============================ timeline ============================ -->
      <!--
        The slack ruler flattened into a strip: three labelled times over a track whose segments are
        proportional to the same fractions the map's route uses (RouteLeave, RouteArrive). Dotted
        while the car is parked, solid for the drive, amber for the walk, with a cap at the bell.
        Bound to the ETA feed, so it is simply absent on a no-trip morning or a failed lookup
        instead of asserting times the card cannot stand behind.
      -->
      <mvux:FeedView Grid.Row="1" Source="{Binding Eta}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <StackPanel Spacing="9"
                        Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="1">
                  <TextBlock Style="{StaticResource TimelineLabel}" Text="{Binding Data.LeaveByLabel}" />
                  <TextBlock Style="{StaticResource TimelineTime}"
                             Foreground="{Binding Data.Tone, Converter={StaticResource ToneChipInk}}"
                             Text="{Binding Data.LeaveByTime}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock x:Uid="TimelineArrive" Style="{StaticResource TimelineLabel}" />
                  <TextBlock Style="{StaticResource TimelineTime}" Text="{Binding Data.ArriveTime}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="1">
                  <TextBlock x:Uid="TimelineBell" Style="{StaticResource TimelineLabel}" />
                  <TextBlock Style="{StaticResource TimelineTime}" Text="{Binding Data.BellTime}" />
                </StackPanel>
              </Grid>

              <!-- Star columns carry the proportions, so the track needs no measuring code. -->
              <Grid Height="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding Data.TrackSlack, Converter={StaticResource PercentToStar}}" />
                  <ColumnDefinition Width="{Binding Data.TrackDrive, Converter={StaticResource PercentToStar}}" />
                  <ColumnDefinition Width="{Binding Data.TrackWalk, Converter={StaticResource PercentToStar}}" />
                </Grid.ColumnDefinitions>

                <!-- Slack: dotted, because the car has not moved yet. Stretch="Fill" spans the
                     cell without a measured width, so the dash pattern needs no code behind it. -->
                <Line X1="0" Y1="0" X2="1" Y2="0"
                      Stretch="Fill"
                      VerticalAlignment="Center"
                      Margin="14,0,2,0"
                      Stroke="{ThemeResource Ink3Brush}"
                      StrokeThickness="4"
                      StrokeDashCap="Round"
                      StrokeDashArray="0.01 0.9" />

                <Border Grid.Column="1"
                        Height="8"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Background="{Binding Data.Tone, Converter={StaticResource ToneTrackBrush}}" />

                <Border Grid.Column="2"
                        Height="8"
                        VerticalAlignment="Center"
                        Margin="0,0,7,0"
                        CornerRadius="4"
                        Background="{ThemeResource AmberBrush}" />

                <!-- Now, and the bell it has to beat. -->
                <Ellipse Width="11"
                         Height="11"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Fill="{Binding Data.Tone, Converter={StaticResource ToneTrackBrush}}" />

                <Rectangle Grid.Column="2"
                           Width="4"
                           Height="14"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           RadiusX="2"
                           RadiusY="2"
                           Fill="{ThemeResource InkBrush}" />
              </Grid>


            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

      <!-- ============================ map panel ============================ -->
      <Border x:Name="MapPanel"
              Grid.Row="2"
              Height="{StaticResource MapPanelHeight}"
              CornerRadius="{StaticResource MapCornerRadius}"
              Background="{ThemeResource MapBrush}">
        <Grid>
          <!--
            Real OSM tiles since v2. The route above it stays schematic - minutes become distance
            along a path - so the drawn line deliberately does not follow the streets underneath:
            the map is a textured ground, not the route's geometry. Recorded in SPEC.md v2 as the
            accepted cost of keeping the time-as-distance device.
          -->
          <!--
            Wrapped in its own rounded Border. The panel's CornerRadius does not reach the map: it
            draws through its own surface, so the outer Border clipped everything except the tiles
            and the map showed square corners inside a rounded panel.
          -->
          <Border CornerRadius="{StaticResource MapCornerRadius}">
            <mapsui:MapControl x:Name="Map" />
          </Border>

          <mc:RouteRulerCanvas x:Name="Ruler" Eta="{Binding State.Data, ElementName=EtaFeed}" />

          <!-- Real launch, not a decorative pill: it opens the platform maps app at the school. -->
          <!-- Hidden whenever a scrim covers the map: a pill showing through "Can't reach the
               car" offers to open a trip the card just said it could not read. -->
          <Button x:Name="OpenInMaps"
                  x:Uid="OpenInMapsButton"
                  Style="{StaticResource MapPillStyle}"
                  Visibility="{Binding State.Data.Failed, ElementName=EtaFeed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, FallbackValue=Collapsed}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,12,30"
                  Click="OnOpenInMaps" />

          <mvux:FeedView x:Name="EtaFeed" Source="{Binding Eta}">

            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <Grid>
                <!--
                  The failure lives here rather than in ErrorTemplate. Measured 2026-09-21: a feed
                  built on a push stream cannot be recovered by FeedView.Refresh, so a Retry bound
                  to it executes and leaves the card broken. As a value, the stream stays alive and
                  the model's own Retry puts a good trip back through it.
                -->
                <!--
                  A gradient scrim under the ETA block. The v1 map was a schematic that faded out
                  behind these numbers; real tiles do not, and dark ink on a street grid measured
                  unreadable. The fade keeps the map legible where the route runs and gives the
                  figures a ground where they sit.
                -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Width="215"
                        Height="150"
                        Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.72">
                      <GradientStop Color="{ThemeResource EtaScrimColor}" Offset="0" />
                      <GradientStop Color="{ThemeResource EtaScrimColor}" Offset="0.42" />
                      <GradientStop Color="{ThemeResource EtaScrimFadeColor}" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>

                <!--
                  Back inside the map in v3. It carries the minutes, the arrival and the traffic
                  read, which the timeline strip above deliberately does not repeat.
                -->
                <StackPanel Margin="16,14,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            MaxWidth="200"
                            Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"><StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource CardBody}" /></StackPanel.Resources>
                  <TextBlock Style="{StaticResource EtaNumber}"
                             Foreground="{Binding Data.IsLate, Converter={StaticResource LateInk}}"><Run Text="{Binding Data.TotalMinutes}" /><Run Text=" " /><Run Text="{Binding Parent.EtaUnitLabel}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" FontSize="{StaticResource EtaUnitSize}" /></TextBlock>

                  <TextBlock Style="{StaticResource CardBody}" Margin="0,1,0,0" Text="{Binding Data.ArrivalText}" />

                  <StackPanel Margin="0,7,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                               Fill="{Binding Data.Traffic, Converter={StaticResource TrafficBrush}}" />
                      <TextBlock Style="{StaticResource CardLabelStrong}"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding Data.Traffic, Converter={StaticResource TrafficBrush}}"
                                 Text="{Binding Data.TrafficText}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CardCaption}" Text="{Binding Data.VsUsualText}" />
                  </StackPanel>
                </StackPanel>

                <Border x:Name="ErrorPanel"
                        Background="{ThemeResource MapScrimBrush}"
                        Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Padding="24"
                              Spacing="8">
                    <TextBlock x:Uid="ErrorTitle"
                               Style="{StaticResource EmptyTitle}"
                               TextAlignment="Center" />
                    <TextBlock Style="{StaticResource CardLabel}"
                               MaxWidth="260"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding Data.FailureMessage}" />
                    <Button x:Name="RetryButton"
                            x:Uid="ErrorRetry"
                            HorizontalAlignment="Center"
                            Command="{Binding Parent.Retry}" />
                  </StackPanel>
                </Border>
                </Grid>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>

            <!-- Nothing on the calendar: the map stays, the route goes. -->
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <Border Background="{ThemeResource MapScrimBrush}">
                  <StackPanel HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Padding="24"
                              Spacing="4">
                    <TextBlock x:Uid="EmptyTitle"
                               Style="{StaticResource EmptyTitle}"
                               TextAlignment="Center" />
                    <TextBlock x:Uid="EmptyNote"
                               Style="{StaticResource CardLabel}"
                               MaxWidth="260"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>

          </mvux:FeedView>
        </Grid>
      </Border>

      <!-- ========================= before you go ========================= -->
      <mvux:FeedView Grid.Row="3" Source="{Binding Stats}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <StackPanel Opacity="{Binding Data.IsStale, Converter={StaticResource StaleOpacity}}">

              <!--
                The header is the disclosure control: one target for the whole row rather than a
                separate chevron button, so the hit area matches what it looks like.
              -->
              <Button x:Name="ChecksHeader"
                      Style="{StaticResource RowButtonStyle}"
                      Command="{Binding Parent.ToggleChecks}"
                      AutomationProperties.Name="{Binding Data.ChecksReady}">
                <Grid Style="{StaticResource ListRowStyle}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Stroke="{ThemeResource Ink2Brush}" StrokeThickness="1.9"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Data="M4 7h8M4 12h11M4 17h6M17.5 6.5v5M20 9h-5" />
                    </Canvas>
                  </Viewbox>

                  <TextBlock Grid.Column="1" x:Uid="ChecksTitle" Style="{StaticResource RowValueStrong}" VerticalAlignment="Center" Margin="4,0,0,0" />

                  <Border Grid.Column="2" Margin="9,0,0,0" Background="{ThemeResource ChipBrush}" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardCaption}" Text="{Binding Data.ChecksCount}" />
                  </Border>

                  <TextBlock Grid.Column="3" Style="{StaticResource CardCaption}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Data.ChecksReady}" />

                  <!-- One glyph, rotated, rather than two glyphs swapped. -->
                  <Viewbox Grid.Column="4" Width="16" Height="16" VerticalAlignment="Center" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform>
                      <RotateTransform Angle="{Binding Parent.ChecksExpanded, Converter={StaticResource BoolToAngle}}" />
                    </Viewbox.RenderTransform>
                    <Canvas Width="24" Height="24">
                      <Path Stroke="{ThemeResource Ink3Brush}" StrokeThickness="2.2" StrokeLineJoin="Round"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6 9l6 6 6-6" />
                    </Canvas>
                  </Viewbox>
                </Grid>
              </Button>

              <!-- Everything below the header collapses together. -->
              <StackPanel Visibility="{Binding Parent.ChecksExpanded, Converter={StaticResource BoolToVisibility}}">
              <Rectangle Style="{StaticResource RowRule}" />

              <!-- Fuel: informational, so it carries a status chip and no action. -->
              <Grid Style="{StaticResource ListRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="24" Height="24" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{Binding Data.FuelLevel, Converter={StaticResource StatLevelBrush}}"
                          StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M5 21V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v15M3 21h14M7 8h6M15 10h2a2 2 0 0 1 2 2v5.5a1.5 1.5 0 0 0 3 0V11l-3-3" />
                  </Canvas>
                </Viewbox>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource RowValueStrong}"><Run Text="{Binding Data.FuelValue}" /><Run Text=" " /><Run Text="{Binding Data.FuelUnit}" /><Run Text=" " /><Run x:Uid="FuelRangeWord" /></TextBlock>
                  <TextBlock x:Uid="ChecksFuelTitle" Style="{StaticResource CardCaption}" />
                </StackPanel>

                <Border Grid.Column="2" Background="{ThemeResource AmberChipBrush}" CornerRadius="9" Padding="9,3" VerticalAlignment="Center"
                        Visibility="{Binding Data.FuelNoteAccent, Converter={StaticResource NullToVisibility}}">
                  <TextBlock Style="{StaticResource CardCaption}" Foreground="{ThemeResource AmberInkBrush}" Text="{Binding Data.FuelChip}" />
                </Border>

                <Viewbox Grid.Column="3" Width="16" Height="16" VerticalAlignment="Center" Margin="10,0,0,0">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource Ink3Brush}" StrokeThickness="2.2" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9 6l6 6-6 6" />
                  </Canvas>
                </Viewbox>
              </Grid>

              <Rectangle Style="{StaticResource RowRule}" />

              <!-- Cabin: the one check the driver can still act on, so it owns the actions. -->
              <Grid Style="{StaticResource ListRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="24" Height="24" VerticalAlignment="Top" Margin="0,2,0,0">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource AccentBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M12 3a2.5 2.5 0 0 1 2.5 2.5v8.2a4.5 4.5 0 1 1-5 0V5.5A2.5 2.5 0 0 1 12 3z" />
                    <Ellipse Canvas.Left="9.5" Canvas.Top="15" Width="5" Height="5" Fill="{ThemeResource AccentBrush}" />
                  </Canvas>
                </Viewbox>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                  <StackPanel>
                    <TextBlock x:Uid="ChecksCabinTitle" Style="{StaticResource RowValueStrong}" />
                    <TextBlock Style="{StaticResource CardCaption}"><Run Text="{Binding Data.CabinLead}" /><Run Text="{Binding Data.CabinAccent}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" Foreground="{ThemeResource AccentInkBrush}" /></TextBlock>
                  </StackPanel>

                  <StackPanel Spacing="9" Visibility="{Binding Data.CabinNeedsWarming, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{ThemeResource ChipBrush}" CornerRadius="9" Padding="9,4" HorizontalAlignment="Left">
                      <TextBlock Style="{StaticResource CardCaption}"><Run Text="{Binding Data.CabinFrom}" /><Run Text="{Binding Data.CabinMid}" /><Run Text="{Binding Data.CabinTo}" /></TextBlock>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button x:Uid="StartWarming"
                              Style="{StaticResource PrimaryPillStyle}"
                              Command="{Binding Parent.ToggleClimate}"
                              IsEnabled="{Binding Data.IsStale, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="{ThemeResource AccentChipBrush}" CornerRadius="9" Padding="9,3" VerticalAlignment="Top" Margin="0,2,0,0"
                        Visibility="{Binding Data.CabinNeedsWarming, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock x:Uid="ChecksCabinSuggested" Style="{StaticResource CardCaption}" Foreground="{ThemeResource AccentInkBrush}" />
                </Border>
              </Grid>

              <Rectangle Style="{StaticResource RowRule}"
                         Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}" />

              <!-- Destination. Absent entirely on a no-trip morning rather than drawn empty. -->
              <Grid Style="{StaticResource ListRowStyle}"
                    Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="24" Height="24" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.7" />
                    <Path Stroke="{ThemeResource InkBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" Data="M10 17V7h3.2a3 3 0 0 1 0 6H10" />
                  </Canvas>
                </Viewbox>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource RowValueStrong}" TextWrapping="Wrap" Text="{Binding Data.ParkingStreet}" />
                  <TextBlock Style="{StaticResource CardCaption}" TextWrapping="Wrap" Text="{Binding Data.ParkingNote}" />
                </StackPanel>

                <Border Grid.Column="2" Background="{ThemeResource GoodChipBrush}" CornerRadius="9" Padding="9,3" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardCaption}" Foreground="{ThemeResource GoodInkBrush}" Text="{Binding Data.ParkingChip}" />
                </Border>

                <Viewbox Grid.Column="3" Width="16" Height="16" VerticalAlignment="Center" Margin="10,0,0,0">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource Ink3Brush}" StrokeThickness="2.2" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9 6l6 6-6 6" />
                  </Canvas>
                </Viewbox>
              </Grid>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

      <!-- ============================ bottom bar ============================ -->
      <mvux:FeedView Grid.Row="4" Source="{Binding Header}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <Grid Margin="0,6,0,0" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource GoodBrush}" />
                <TextBlock Style="{StaticResource CardCaption}" VerticalAlignment="Center" Text="{Binding Data.LockText}" />
              </StackPanel>

              <!-- Lock is its own control: the one state the bar both reports and changes. -->
              <Button Grid.Column="1"
                      Style="{StaticResource GhostPillStyle}"
                      Command="{Binding Parent.ToggleLock}"
                      IsEnabled="{Binding Data.IsStale, Converter={StaticResource InverseBool}}"
                      AutomationProperties.Name="{Binding Data.LockText}">
                <Viewbox Width="17" Height="17">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource InkBrush}" StrokeThickness="1.9" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zM8 11V8a4 4 0 0 1 8 0v3" />
                  </Canvas>
                </Viewbox>
              </Button>

              <Button Grid.Column="2"
                      Style="{StaticResource StartDriveStyle}"
                      Command="{Binding Parent.StartDrive}"
                      IsEnabled="{Binding Data.IsStale, Converter={StaticResource InverseBool}}"
                      Content="{Binding Parent.DriveLabel}" />
            </Grid>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

    </Grid>
  </Grid>
</UserControl>
