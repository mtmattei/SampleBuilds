<UserControl x:Class="MorningCard.Controls.MorningCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="using:MorningCard.Controls"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             xmlns:uen="using:Uno.Extensions.Navigation.UI"
             xmlns:mapsui="using:Mapsui.UI.WinUI"
             xmlns:utu="using:Uno.Toolkit.UI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

  <!--
    v6: a warm shell (the card) holding one paper panel, with the header and the footer on the shell.
    The shadow canvas sits at a negative margin so the wide blur has room; hit-test transparent.
  -->
  <Grid>
    <mc:CardShadowCanvas />

    <!-- The shell: Filled card, coloured through the FilledCardContent* keys in CardTokens. The
         radius dial writes Glass.CornerRadius in code-behind. BorderThickness is the 1 px inset
         top highlight. -->
    <utu:CardContentControl x:Name="Glass"
                            Style="{StaticResource FilledCardContentControlStyle}"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}"
                            BorderThickness="0,1,0,0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
    <Grid RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============================ header ============================ -->
      <!-- On the shell: sun, greeting over the weather line, and the time the card is reading. -->
      <mvux:FeedView Source="{Binding Header}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <Grid MinHeight="52" Padding="14,6,12,0" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Style="{StaticResource CardIcon}"
                        Glyph="{StaticResource IconSun}"
                        FontSize="18"
                        Foreground="{ThemeResource SunInkBrush}"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource GreetingText}" Text="{Binding Data.Greeting}" />
                <TextBlock Style="{StaticResource HeaderMeta}" Text="{Binding Data.WeatherLine}" />
              </StackPanel>
              <TextBlock Grid.Column="2"
                         Style="{StaticResource HeaderMeta}"
                         VerticalAlignment="Top"
                         Margin="0,2,0,0"
                         Text="{Binding Data.NowText}" />
            </Grid>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

      <!-- ============================ panel ============================ -->
      <!-- The paper panel: Outlined card, coloured through the OutlinedCardContent* keys. Radius
           and padding are local because the shared CardCornerRadius/CardPadding keys hold the
           shell's values. -->
      <utu:CardContentControl Grid.Row="1"
                              Style="{StaticResource OutlinedCardContentControlStyle}"
                              Margin="0"
                              HorizontalAlignment="Stretch"
                              CornerRadius="{StaticResource CardInnerCornerRadius}"
                              Padding="20"
                              BorderThickness="1"
                              HorizontalContentAlignment="Stretch">
        <StackPanel>

          <!-- Title, headline and the car. -->
          <mvux:FeedView Source="{Binding Header}">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Top">
                    <!--
                      DownOnly (c658b2b): the title keeps its 34 wherever it fits and scales down,
                      with its chevron beside it, where it does not.
                    -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Style="{StaticResource CardTitle}"
                                   VerticalAlignment="Center"
                                   Text="{Binding Data.Title}" />
                        <FontIcon Style="{StaticResource CardIcon}"
                                  Glyph="{StaticResource IconChevronRight}"
                                  FontSize="20"
                                  Foreground="{ThemeResource Ink3Brush}"
                                  VerticalAlignment="Center"
                                  Margin="0,4,0,0" />
                      </StackPanel>
                    </Viewbox>
                    <!-- One TextBlock, three Runs, so the emphasis shares the sentence's baseline. -->
                    <TextBlock Style="{StaticResource CardLead}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"><Run Text="{Binding Data.HeadlineLead}" /><Run Text="{Binding Data.HeadlineAccent}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" FontSize="{StaticResource LeadEmphasisSize}" Foreground="{Binding Data.Tone, Converter={StaticResource AccentTone}}" /><Run Text="{Binding Data.HeadlineTail}" /></TextBlock>
                  </StackPanel>
                  <!-- The XC60, muted offline (saturate .3, contrast .95); the artboard's Outback is
                       ignored by decision C6. -->
                  <Image Grid.Column="1"
                         Source="ms-appx:///Assets/Car/xc60_muted.png"
                         Width="156"
                         Height="82"
                         Margin="0,-4,-8,0"
                         VerticalAlignment="Top"
                         Stretch="Uniform"
                         AutomationProperties.Name="{Binding Data.CarName}" />
                </Grid>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
          </mvux:FeedView>

          <!-- ============================ slack ruler ============================ -->
          <mvux:FeedView Margin="0,16,0,0" Source="{Binding Eta}">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <mc:SlackRuler View="{Binding Data}" />
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
          </mvux:FeedView>
          <Border x:Name="MapPanel"
              Margin="0,18,0,0"
                  Height="{StaticResource MapPanelHeight}"
                  CornerRadius="{StaticResource MapCornerRadius}"
                  Background="{ThemeResource CardSurfaceBrush}">
            <Grid>
              <!--
                Real OSM tiles since v2. The route above it stays schematic - minutes become distance
                along a path - so the drawn line deliberately does not follow the streets underneath:
                the map is a textured ground, not the route's geometry. Recorded in SPEC.md v2 as the
                accepted cost of keeping the time-as-distance device.
              -->
              <!--
                Wrapped in its own rounded Border. The panel's CornerRadius does not reach the map: it
                draws through its own surface, so the outer Border clipped everything except the tiles
                and the map showed square corners inside a rounded panel.
              -->
              <Border CornerRadius="{StaticResource MapCornerRadius}">
                <mapsui:MapControl x:Name="Map" />
              </Border>

              <!-- No CornerRadius of its own: the panel Border already clips to the radius, and a
                   second rounding inside it cut a notch that exposed the panel's ground at the corner. -->
              <!-- Sized from the ETA block's right edge (OnEtaBlockSizeChanged): opaque under the text,
                   a fixed fade after it, and clear map beyond. A share of the panel either covered the
                   map far past the text on a wide card or left text on bare streets on a phone. -->
              <Border x:Name="EtaScrim"
                      HorizontalAlignment="Left"
                      Visibility="{Binding State.Data.Failed, ElementName=EtaFeed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, FallbackValue=Collapsed}">
                <Border.Background>
                  <!--
                    Opaque, not a wash. The left of the panel is the ETA block's ground, so the map is
                    fully gone behind it and only reappears past the text - a half-visible street grid
                    under a headline reads as a rendering fault rather than as depth.
                  -->
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{ThemeResource EtaScrimColor}" Offset="0" />
                    <!-- Offsets are placeholders until the ETA block is measured; the ramp's shape
                         (ScrimRamp in code-behind) is what these approximate. -->
                    <GradientStop Color="{ThemeResource EtaScrimColor}" Offset="0.22" />
                    <GradientStop Color="{ThemeResource EtaScrimStop1Color}" Offset="0.28" />
                    <GradientStop Color="{ThemeResource EtaScrimStop2Color}" Offset="0.33" />
                    <GradientStop Color="{ThemeResource EtaScrimStop3Color}" Offset="0.39" />
                    <GradientStop Color="{ThemeResource EtaScrimStop4Color}" Offset="0.46" />
                    <GradientStop Color="{ThemeResource EtaScrimStop5Color}" Offset="0.54" />
                    <GradientStop Color="{ThemeResource EtaScrimFadeColor}" Offset="0.60" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>

              <mc:RouteRulerCanvas x:Name="Ruler" Eta="{Binding State.Data, ElementName=EtaFeed}" />

              <!-- Real launch, not a decorative pill: it opens the platform maps app at the school. -->
              <!-- Hidden whenever a scrim covers the map: a pill showing through "Can't reach the
                   car" offers to open a trip the card just said it could not read. -->
              <Button x:Name="OpenInMaps"
                      x:Uid="OpenInMapsButton"
                      Style="{StaticResource MapPillStyle}"
                      Visibility="{Binding State.Data.Failed, ElementName=EtaFeed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, FallbackValue=Collapsed}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,12,26"
                      Click="OnOpenInMaps" />

              <mvux:FeedView x:Name="EtaFeed" Source="{Binding Eta}">

                <mvux:FeedView.ValueTemplate>
                  <DataTemplate>
                    <Grid>
                    <!--
                      The failure lives here rather than in ErrorTemplate. Measured 2026-09-21: a feed
                      built on a push stream cannot be recovered by FeedView.Refresh, so a Retry bound
                      to it executes and leaves the card broken. As a value, the stream stays alive and
                      the model's own Retry puts a good trip back through it.
                    -->
                    <!--
                      A gradient scrim under the ETA block. The v1 map was a schematic that faded out
                      behind these numbers; real tiles do not, and dark ink on a street grid measured
                      unreadable. The fade keeps the map legible where the route runs and gives the
                      figures a ground where they sit.
                    -->


                    <!--
                      Back inside the map in v3. It carries the minutes, the arrival and the traffic
                      read, which the timeline strip above deliberately does not repeat.
                    -->
                    <StackPanel Margin="16,14,0,0"
                                SizeChanged="OnEtaBlockSizeChanged"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                MaxWidth="200"
                                Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"><StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource CardBody}" /></StackPanel.Resources>
                      <TextBlock Style="{StaticResource EtaNumber}"
                                 Foreground="{Binding Data.IsLate, Converter={StaticResource LateInk}}"><Run Text="{Binding Data.TotalMinutes}" /><Run Text=" " /><Run Text="{Binding Parent.EtaUnitLabel}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" FontSize="{StaticResource EtaUnitSize}" /></TextBlock>

                      <StackPanel Margin="0,7,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                   Fill="{Binding Data.Traffic, Converter={StaticResource TrafficBrush}}" />
                          <TextBlock Style="{StaticResource CardLabelStrong}"
                                     VerticalAlignment="Center"
                                     Foreground="{Binding Data.Traffic, Converter={StaticResource TrafficBrush}}"
                                     Text="{Binding Data.TrafficText}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CardCaption}"
                                   Foreground="{ThemeResource Ink3Brush}"
                                   Text="{Binding Data.VsUsualText}" />
                      </StackPanel>
                    </StackPanel>

                    <Border x:Name="ErrorPanel"
                            Background="{ThemeResource MapScrimBrush}"
                            Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}}">
                      <StackPanel HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Padding="24"
                                  Spacing="8">
                        <TextBlock x:Uid="ErrorTitle"
                                   Style="{StaticResource EmptyTitle}"
                                   TextAlignment="Center" />
                        <TextBlock Style="{StaticResource CardLabel}"
                                   MaxWidth="260"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding Data.FailureMessage}" />
                        <Button x:Name="RetryButton"
                                x:Uid="ErrorRetry"
                                HorizontalAlignment="Center"
                                Command="{Binding Parent.Retry}" />
                      </StackPanel>
                    </Border>
                    </Grid>
                  </DataTemplate>
                </mvux:FeedView.ValueTemplate>

                <!-- Nothing on the calendar: the map stays, the route goes. -->
                <mvux:FeedView.NoneTemplate>
                  <DataTemplate>
                    <Border Background="{ThemeResource MapScrimBrush}">
                      <StackPanel HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Padding="24"
                                  Spacing="4">
                        <TextBlock x:Uid="EmptyTitle"
                                   Style="{StaticResource EmptyTitle}"
                                   TextAlignment="Center" />
                        <TextBlock x:Uid="EmptyNote"
                                   Style="{StaticResource CardLabel}"
                                   MaxWidth="260"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </mvux:FeedView.NoneTemplate>

              </mvux:FeedView>
            </Grid>
          </Border>

          <mvux:FeedView Margin="0,12,0,0" Source="{Binding Stats}">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <!--
                  One container for the whole checklist, header and rows together, as the mockup draws
                  it. The header carried the border on its own before, which made the rows beneath it
                  read as loose items on the card rather than as the contents of the thing that just
                  opened. The disclosure and what it discloses belong in the same box.
                -->
                <Border BorderBrush="{ThemeResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource MapCornerRadius}"
                        Opacity="{Binding Data.IsStale, Converter={StaticResource StaleOpacity}}">
                  <StackPanel>

                    <!--
                      The header is the disclosure control: one target for the whole row rather than a
                      separate chevron button, so the hit area matches what it looks like.
                    -->
                    <!--
                      In its own container, as the mockup draws it: the checklist is a panel the card
                      opens, and a bare row of text gave the disclosure nothing to belong to. The border
                      is what makes the closed state read as a closed thing rather than as a spare line.
                    -->
                    <!-- No border of its own: the container around the whole checklist owns that, and
                         the two were drawn on top of each other. -->
                    <Button x:Name="ChecksHeader"
                            Style="{StaticResource RowButtonStyle}"
                            CornerRadius="{Binding Data.ChecksExpanded, Converter={StaticResource ChecksHeaderRadius}}"
                            Padding="14,12"
                            Command="{Binding Parent.ToggleChecks}"
                            AutomationProperties.Name="{Binding Data.ChecksReady}">
                      <!-- Padding zeroed: the row style's own 14pt top and bottom stacked on the
                           button's and made the closed checklist half again the reference's height. -->
                      <Grid Style="{StaticResource ListRowStyle}" Padding="0" SizeChanged="OnChecksHeaderSizeChanged">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                          <Canvas Width="24" Height="24">
                            <Path Stroke="{ThemeResource Ink2Brush}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4 7h8M4 12h11M4 17h6M17.5 6.5v5M20 9h-5" />
                          </Canvas>
                        </Viewbox>

                        <TextBlock Grid.Column="1" x:Uid="ChecksTitle" Style="{StaticResource RowValueStrong}" VerticalAlignment="Center" Margin="4,0,0,0" />

                        <Border Grid.Column="2" Margin="9,0,0,0" Background="{ThemeResource ChipBrush}" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                          <TextBlock Style="{StaticResource CardCaption}" Text="{Binding Data.ChecksCount}" />
                        </Border>

                        <!--
                          Three dots, one per check, in the order the rows appear: fuel, cabin, parking.
                          They are not decoration - each takes the colour of the check it stands for, so
                          the row says which one needs attention while it is still closed, where the
                          count alone only says how many.
                        -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                          <!-- The dots give way first when the row is short (OnChecksHeaderSizeChanged):
                               the reference drops them at phone width and keeps the count and the
                               "ready" line, which say the same thing in words. -->
                          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{Binding Data.FuelLevel, Converter={StaticResource StatLevelBrush}}" />
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{Binding Data.CabinNeedsWarming, Converter={StaticResource CheckDotBrush}}" />
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{ThemeResource GoodBrush}" />
                          </StackPanel>
                          <TextBlock Style="{StaticResource CardCaption}"
                                     VerticalAlignment="Center"
                                     Text="{Binding Data.ChecksReady}" />
                        </StackPanel>

                        <!-- One glyph, rotated, rather than two glyphs swapped. -->
                        <Viewbox Grid.Column="4" Width="16" Height="16" VerticalAlignment="Center" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
                          <Viewbox.RenderTransform>
                            <RotateTransform Angle="{Binding Data.ChecksExpanded, Converter={StaticResource BoolToAngle}}" />
                          </Viewbox.RenderTransform>
                          <Canvas Width="24" Height="24">
                            <Path Stroke="{ThemeResource Ink3Brush}" StrokeThickness="2.2" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6 9l6 6 6-6" />
                          </Canvas>
                        </Viewbox>
                      </Grid>
                    </Button>

                    <!--
                      Everything below the header collapses together. The reveal fades and rises rather
                      than animating height: measuring a growing panel every frame is the expensive way,
                      and the job here is continuity, not spectacle.
                    -->
                    <StackPanel x:Name="ChecksBody"
                                Visibility="{Binding Data.ChecksExpanded, Converter={StaticResource BoolToVisibility}}"
                                RenderTransformOrigin="0.5,0">
                      <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ChecksBodyShift" />
                      </StackPanel.RenderTransform>
                    <Rectangle Style="{StaticResource RowRule}" />

                    <!-- Fuel: informational, so it carries a status chip and no action. -->
                    <Grid Style="{StaticResource ListRowStyle}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Viewbox Width="24" Height="24" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                          <Path Stroke="{Binding Data.FuelLevel, Converter={StaticResource StatLevelBrush}}"
                                StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                Data="M5 21V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v15M3 21h14M7 8h6M15 10h2a2 2 0 0 1 2 2v5.5a1.5 1.5 0 0 0 3 0V11l-3-3" />
                        </Canvas>
                      </Viewbox>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowValueStrong}"><Run Text="{Binding Data.FuelValue}" /><Run Text=" " /><Run Text="{Binding Data.FuelUnit}" /><Run Text=" " /><Run x:Uid="FuelRangeWord" /></TextBlock>
                        <TextBlock x:Uid="ChecksFuelTitle" Style="{StaticResource CardCaption}" />
                      </StackPanel>

                      <Border Grid.Column="2" Background="{ThemeResource AmberChipBrush}" CornerRadius="9" Padding="9,3" VerticalAlignment="Center"
                              Visibility="{Binding Data.FuelNoteAccent, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Style="{StaticResource CardCaption}" Foreground="{ThemeResource AmberInkBrush}" Text="{Binding Data.FuelChip}" />
                      </Border>

                      <!--
                        Decorative, and accepted as such: nothing sits behind these rows in a sample whose
                        whole product is one card. Recorded here rather than left for a reviewer to find.
                      -->
                      <Viewbox Grid.Column="3" Width="16" Height="16" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Canvas Width="24" Height="24">
                          <Path Stroke="{ThemeResource Ink3Brush}" StrokeThickness="2.2" StrokeLineJoin="Round"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9 6l6 6-6 6" />
                        </Canvas>
                      </Viewbox>
                    </Grid>

                    <Rectangle Style="{StaticResource RowRule}" />

                    <!-- Cabin: the one check the driver can still act on, so it owns the actions. -->
                    <Grid Style="{StaticResource ListRowStyle}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Viewbox Width="24" Height="24" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Canvas Width="24" Height="24">
                          <Path Stroke="{ThemeResource AccentBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                Data="M12 3a2.5 2.5 0 0 1 2.5 2.5v8.2a4.5 4.5 0 1 1-5 0V5.5A2.5 2.5 0 0 1 12 3z" />
                          <Ellipse Canvas.Left="9.5" Canvas.Top="15" Width="5" Height="5" Fill="{ThemeResource AccentBrush}" />
                        </Canvas>
                      </Viewbox>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                        <StackPanel>
                          <TextBlock x:Uid="ChecksCabinTitle" Style="{StaticResource RowValueStrong}" />
                          <TextBlock Style="{StaticResource CardCaption}"><Run Text="{Binding Data.CabinLead}" /><Run Text="{Binding Data.CabinAccent}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" Foreground="{ThemeResource AccentInkBrush}" /></TextBlock>
                        </StackPanel>

                        <StackPanel Spacing="9" Visibility="{Binding Data.CabinNeedsWarming, Converter={StaticResource BoolToVisibility}}">
                          <Border Background="{ThemeResource ChipBrush}" CornerRadius="9" Padding="9,4" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource CardCaption}"><Run Text="{Binding Data.CabinFrom}" /><Run Text="{Binding Data.CabinMid}" /><Run Text="{Binding Data.CabinTo}" /></TextBlock>
                          </Border>

                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="StartWarming"
                                    Style="{StaticResource PrimaryPillStyle}"
                                    Command="{Binding Parent.ToggleClimate}"
                                    IsEnabled="{Binding Data.IsStale, Converter={StaticResource InverseBool}}" />
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>

                      <Border Grid.Column="2" Background="{ThemeResource AccentChipBrush}" CornerRadius="9" Padding="9,3" VerticalAlignment="Top" Margin="0,2,0,0"
                              Visibility="{Binding Data.CabinNeedsWarming, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Uid="ChecksCabinSuggested" Style="{StaticResource CardCaption}" Foreground="{ThemeResource AccentInkBrush}" />
                      </Border>
                    </Grid>

                    <Rectangle Style="{StaticResource RowRule}"
                               Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Destination. Absent entirely on a no-trip morning rather than drawn empty. -->
                    <Grid Style="{StaticResource ListRowStyle}"
                          Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Viewbox Width="24" Height="24" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                          <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.7" />
                          <Path Stroke="{ThemeResource InkBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"
                                StrokeStartLineCap="Round" Data="M10 17V7h3.2a3 3 0 0 1 0 6H10" />
                        </Canvas>
                      </Viewbox>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowValueStrong}" TextWrapping="Wrap" Text="{Binding Data.ParkingStreet}" />
                        <TextBlock Style="{StaticResource CardCaption}" TextWrapping="Wrap" Text="{Binding Data.ParkingNote}" />
                      </StackPanel>

                      <Border Grid.Column="2" Background="{ThemeResource GoodChipBrush}" CornerRadius="9" Padding="9,3" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardCaption}" Foreground="{ThemeResource GoodInkBrush}" Text="{Binding Data.ParkingChip}" />
                      </Border>

                      <!--
                        Decorative, and accepted as such: nothing sits behind these rows in a sample whose
                        whole product is one card. Recorded here rather than left for a reviewer to find.
                      -->
                      <Viewbox Grid.Column="3" Width="16" Height="16" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Canvas Width="24" Height="24">
                          <Path Stroke="{ThemeResource Ink3Brush}" StrokeThickness="2.2" StrokeLineJoin="Round"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9 6l6 6-6 6" />
                        </Canvas>
                      </Viewbox>
                    </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
          </mvux:FeedView>
        </StackPanel>
      </utu:CardContentControl>

      <!-- ============================ footer ============================ -->
      <mvux:FeedView Grid.Row="2" Source="{Binding Header}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <Grid Height="56" Padding="14,0,4,0" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- The live dot, the car, and its lock state. -->
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource GoodBrush}" />
                <TextBlock Style="{StaticResource HeaderMeta}" Foreground="{ThemeResource InkBrush}" Text="{Binding Data.CarName}" />
                <TextBlock Style="{StaticResource HeaderMeta}" Foreground="{ThemeResource FaintBrush}" Text="&#x00B7;" />
                <TextBlock Style="{StaticResource HeaderMeta}" Text="{Binding Data.LockState}" />
              </StackPanel>

              <!-- Labelled since v6: the lock action names what it will do. -->
              <Button Grid.Column="1"
                      Style="{StaticResource GhostPillStyle}"
                      Command="{Binding Parent.ToggleLock}"
                      IsEnabled="{Binding Data.IsStale, Converter={StaticResource InverseBool}}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Grid VerticalAlignment="Center">
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconLockOpen}" FontSize="15" Foreground="{ThemeResource InkStrongBrush}"
                              Visibility="{Binding Data.IsLocked, Converter={StaticResource BoolToVisibility}}" />
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconLock}" FontSize="15" Foreground="{ThemeResource InkStrongBrush}"
                              Visibility="{Binding Data.IsLocked, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                  </Grid>
                  <TextBlock VerticalAlignment="Center" Text="{Binding Data.LockAction}" />
                </StackPanel>
              </Button>

              <Button Grid.Column="2"
                      Style="{StaticResource StartDriveStyle}"
                      Command="{Binding Parent.StartDrive}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconNavigation}" FontSize="14" Foreground="{ThemeResource OnInkStrongBrush}" VerticalAlignment="Center" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Parent.DriveLabel}" />
                </StackPanel>
              </Button>
            </Grid>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

    </Grid>
    </utu:CardContentControl>
  </Grid>
</UserControl>
