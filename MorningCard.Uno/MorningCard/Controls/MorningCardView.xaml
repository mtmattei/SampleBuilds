<UserControl x:Class="MorningCard.Controls.MorningCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="using:MorningCard.Controls"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             xmlns:uen="using:Uno.Extensions.Navigation.UI"
             xmlns:mapsui="using:Mapsui.UI.WinUI"
             xmlns:utu="using:Uno.Toolkit.UI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

  <UserControl.Resources>
    <!--
      Loading templates, shared by ProgressTemplate and UndefinedTemplate. A feed over a push
      stream sits in Undefined (not Progress) until its first value arrives, which is exactly the
      first-load case these skeletons exist for (measured 2026-09-23: Progress alone left the card
      blank while the trip was held).
    -->
    <DataTemplate x:Key="TitleLoadingTemplate">
      <Grid ColumnSpacing="8" AutomationProperties.AccessibilityView="Raw">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Top">
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock x:Uid="LoadingTitle" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
              <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconChevronRight}" FontSize="20"
                        Foreground="{ThemeResource Ink3Brush}" VerticalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Viewbox>
          <Rectangle Style="{StaticResource SkeletonBar}" Width="210" Height="18" Margin="0,14,0,0" />
          <Rectangle Style="{StaticResource SkeletonBar}" Width="150" Height="14" Margin="0,10,0,0" RadiusX="7" RadiusY="7" />
        </StackPanel>
        <Image Grid.Column="1" Source="ms-appx:///Assets/Car/xc60_muted.png" Width="156" Height="82"
               Margin="0,-4,-8,0" VerticalAlignment="Top" Stretch="Uniform" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RulerLoadingTemplate">
      <mc:SlackRuler IsSkeleton="True" AutomationProperties.AccessibilityView="Raw" />
    </DataTemplate>

    <DataTemplate x:Key="MapLoadingTemplate">
      <StackPanel Margin="18,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                  AutomationProperties.AccessibilityView="Raw">
        <Rectangle Style="{StaticResource SkeletonBar}" Width="96" Height="30" />
        <Rectangle Style="{StaticResource SkeletonBar}" Width="120" Height="10" Margin="0,12,0,0" RadiusX="5" RadiusY="5" />
        <Rectangle Style="{StaticResource SkeletonBar}" Width="150" Height="10" Margin="0,10,0,0" RadiusX="5" RadiusY="5" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ChecksLoadingTemplate">
      <utu:CardContentControl Style="{StaticResource OutlinedCardContentControlStyle}" Margin="0" Padding="14,0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}">
        <Grid Height="52" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconListChecks}" FontSize="18" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Uid="ChecksTitle" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Left" Background="{ThemeResource ChipBrush}">
            <TextBlock x:Uid="ChecksLoadingCount" Style="{StaticResource PillText}" VerticalAlignment="Center" Foreground="{ThemeResource Ink2Brush}" />
          </Border>
          <TextBlock Grid.Column="3" x:Uid="ChecksChecking" Style="{StaticResource HeaderMeta}" VerticalAlignment="Center" />
          <FontIcon Grid.Column="4" Style="{StaticResource CardIcon}" Glyph="{StaticResource IconChevronDown}" FontSize="16"
                    Foreground="{ThemeResource FaintBrush}" VerticalAlignment="Center" />
        </Grid>
      </utu:CardContentControl>
    </DataTemplate>

    <DataTemplate x:Key="FooterLoadingTemplate">
      <Grid Height="56" Padding="14,0,4,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource GoodBrush}" />
          <TextBlock x:Uid="FooterUpdating" Style="{StaticResource HeaderMeta}" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource GhostPillStyle}" Command="{Binding Parent.ToggleLock}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconLockOpen}" FontSize="15" Foreground="{ThemeResource InkStrongBrush}" VerticalAlignment="Center" />
            <TextBlock x:Uid="FooterUnlock" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Style="{StaticResource StartDriveStyle}" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconNavigation}" FontSize="14" Foreground="{ThemeResource OnInkStrongBrush}" VerticalAlignment="Center" />
            <TextBlock x:Uid="FooterStartDrive" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <!--
    v6: a warm shell (the card) holding one paper panel, with the header and the footer on the shell.
    The shadow canvas sits at a negative margin so the wide blur has room; hit-test transparent.
  -->
  <Grid>
    <mc:CardShadowCanvas />

    <!-- The shell: Filled card, coloured through the FilledCardContent* keys in CardTokens. The
         radius dial writes Glass.CornerRadius in code-behind. BorderThickness is the 1 px inset
         top highlight. -->
    <utu:CardContentControl x:Name="Glass"
                            Style="{StaticResource FilledCardContentControlStyle}"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}"
                            BorderThickness="0,1,0,0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
    <Grid RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============================ header ============================ -->
      <!-- On the shell: sun, greeting over the weather line, and the time the card is reading. -->
      <mvux:FeedView Source="{Binding Greeting}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <Grid MinHeight="52" Padding="14,6,12,0" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Style="{StaticResource CardIcon}"
                        Glyph="{StaticResource IconSun}"
                        FontSize="18"
                        Foreground="{ThemeResource SunInkBrush}"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource GreetingText}" Text="{Binding Data.Greeting}" />
                <TextBlock Style="{StaticResource HeaderMeta}" Text="{Binding Data.WeatherLine}" />
              </StackPanel>
              <TextBlock Grid.Column="2"
                         Style="{StaticResource HeaderMeta}"
                         VerticalAlignment="Top"
                         Margin="0,2,0,0"
                         Text="{Binding Data.NowText}" />
            </Grid>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

      <!-- ============================ panel ============================ -->
      <!-- The paper panel: Outlined card, coloured through the OutlinedCardContent* keys. Radius
           and padding are local because the shared CardCornerRadius/CardPadding keys hold the
           shell's values. -->
      <utu:CardContentControl Grid.Row="1"
                              Style="{StaticResource OutlinedCardContentControlStyle}"
                              Margin="0"
                              HorizontalAlignment="Stretch"
                              CornerRadius="{StaticResource CardInnerCornerRadius}"
                              Padding="20"
                              BorderThickness="1"
                              HorizontalContentAlignment="Stretch">
        <StackPanel>

          <!-- Title, headline and the car. -->
          <mvux:FeedView Source="{Binding Header}"
                         ProgressTemplate="{StaticResource TitleLoadingTemplate}" UndefinedTemplate="{StaticResource TitleLoadingTemplate}">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Top">
                    <!--
                      DownOnly (c658b2b): the title keeps its 34 wherever it fits and scales down,
                      with its chevron beside it, where it does not.
                    -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Style="{StaticResource CardTitle}"
                                   VerticalAlignment="Center"
                                   Text="{Binding Data.Title}" />
                        <FontIcon Style="{StaticResource CardIcon}"
                                  Glyph="{StaticResource IconChevronRight}"
                                  FontSize="20"
                                  Foreground="{ThemeResource Ink3Brush}"
                                  VerticalAlignment="Center"
                                  Margin="0,4,0,0" />
                      </StackPanel>
                    </Viewbox>
                    <!-- One TextBlock, three Runs, so the emphasis shares the sentence's baseline. -->
                    <TextBlock Style="{StaticResource CardLead}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"><Run Text="{Binding Data.HeadlineLead}" /><Run Text="{Binding Data.HeadlineAccent}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" FontSize="{Binding Data.HeadlineAccentSize}" Foreground="{Binding Data.HeadlineAccentInk, Converter={StaticResource TokenBrush}}" /><Run Text="{Binding Data.HeadlineTail}" /></TextBlock>
                    <!-- ETA unavailable (E6): the times on the card come from the saved schedule. -->
                    <TextBlock Style="{StaticResource CardCaption}"
                               FontSize="13.5"
                               Margin="0,4,0,0"
                               Text="{Binding Data.ScheduleNote}"
                               Visibility="{Binding Data.ScheduleNote, Converter={StaticResource NullToVisibility}}"
                               AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                  <!-- The XC60, muted offline (saturate .3, contrast .95); the artboard's Outback is
                       ignored by decision C6. -->
                  <Image Grid.Column="1"
                         Source="ms-appx:///Assets/Car/xc60_muted.png"
                         Width="156"
                         Height="82"
                         Margin="0,-4,-8,0"
                         VerticalAlignment="Top"
                         Stretch="Uniform"
                         AutomationProperties.Name="{Binding Data.CarName}" />
                </Grid>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
            <!-- Loading: the title and the car stay; the headline is two skeleton bars. -->
          </mvux:FeedView>

          <!-- ============================ slack ruler ============================ -->
          <mvux:FeedView Margin="0,16,0,0" Source="{Binding Eta}"
                         ProgressTemplate="{StaticResource RulerLoadingTemplate}" UndefinedTemplate="{StaticResource RulerLoadingTemplate}">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <mc:SlackRuler View="{Binding Data}" />
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
            <!-- No drop-off: no ruler at all rather than an empty one. -->
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <Grid />
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>
          </mvux:FeedView>
          <!-- xaml-lint: allow card - clips the map's own drawing surface to the panel radius; the
               1 px ring is the artboard's inset edge, not card chrome. -->
          <Border x:Name="MapPanel"
                  Margin="0,18,0,0"
                  Height="{StaticResource MapPanelHeight}"
                  CornerRadius="{StaticResource MapCornerRadius}"
                  BorderBrush="{ThemeResource LineBrush}"
                  BorderThickness="1"
                  Background="{ThemeResource MapBrush}">
            <Grid>
              <!--
                Real OSM tiles since v2. The route above it stays schematic - minutes become distance
                along a path - so the drawn line deliberately does not follow the streets underneath:
                the map is a textured ground, not the route's geometry. Recorded in SPEC.md v2 as the
                accepted cost of keeping the time-as-distance device.
              -->
              <!--
                Wrapped in its own rounded Border. The panel's CornerRadius does not reach the map: it
                draws through its own surface, so the outer Border clipped everything except the tiles
                and the map showed square corners inside a rounded panel.
              -->
              <Border CornerRadius="{StaticResource MapCornerRadius}">
                <mapsui:MapControl x:Name="Map" />
              </Border>

              <!-- v6 scrim: a fixed ramp across the whole panel, white 97% to 90% at 24%, 45% at 44%,
                   clear from 62%. The ETA text sits on the opaque part; the route on the clear. -->
              <Border x:Name="EtaScrim"
                      IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{ThemeResource EtaScrimColor}" Offset="0" />
                    <GradientStop Color="{ThemeResource EtaScrimStop1Color}" Offset="0.24" />
                    <GradientStop Color="{ThemeResource EtaScrimStop2Color}" Offset="0.44" />
                    <GradientStop Color="{ThemeResource EtaScrimFadeColor}" Offset="0.62" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>

              <mc:RouteRulerCanvas x:Name="Ruler" Eta="{Binding State.Data, ElementName=EtaFeed}" />

              <!-- Real launch, not a decorative pill: it opens the platform maps app at the school. -->
              <!-- Hidden whenever a scrim covers the map: a pill showing through "Can't reach the
                   car" offers to open a trip the card just said it could not read. -->
              <!-- No Recenter beside it (I6): the map is locked, so one would impersonate a control.
                   30 from the bottom, not the artboard's 12: the OSM attribution the tile policy
                   requires sits in the bottom-right corner, and the pill must not cover it. -->
              <Button x:Name="OpenInMaps"
                      x:Uid="OpenInMapsButton"
                      Style="{StaticResource MapPillStyle}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,12,30"
                      Click="OnOpenInMaps">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock x:Uid="OpenInMapsLabel" VerticalAlignment="Center" />
                  <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconArrowUpRight}" FontSize="12" Foreground="{ThemeResource InkStrongBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <mvux:FeedView x:Name="EtaFeed" Source="{Binding Eta}"
                             ProgressTemplate="{StaticResource MapLoadingTemplate}" UndefinedTemplate="{StaticResource MapLoadingTemplate}">

                <mvux:FeedView.ValueTemplate>
                  <DataTemplate>
                    <Grid>
                    <!--
                      The failure lives here rather than in ErrorTemplate. Measured 2026-09-21: a feed
                      built on a push stream cannot be recovered by FeedView.Refresh, so a Retry bound
                      to it executes and leaves the card broken. As a value, the stream stays alive and
                      the model's own Retry puts a good trip back through it.
                    -->
                    <!-- v6 ETA block: drive time, caption, traffic. Its right edge also bounds the
                         route fit (OnEtaBlockSizeChanged). -->
                    <StackPanel Margin="18,16,0,0"
                                SizeChanged="OnEtaBlockSizeChanged"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                MaxWidth="200"
                                Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                      <TextBlock Style="{StaticResource EtaNumber}"><Run Text="{Binding Data.TotalMinutes}" /><Run Text=" " /><Run Text="{Binding Parent.EtaUnitLabel}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" FontSize="{StaticResource EtaUnitSize}" /></TextBlock>
                      <TextBlock x:Uid="EtaCaption" Style="{StaticResource CapsCaption}" Margin="0,1,0,0" />

                      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,10,0,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding Data.Traffic, Converter={StaticResource TrafficBrush}}" />
                        <TextBlock Style="{StaticResource CardLabelStrong}"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Data.Traffic, Converter={StaticResource TrafficBrush}}"
                                   Text="{Binding Data.TrafficText}" />
                      </StackPanel>
                      <TextBlock Style="{StaticResource CardCaption}"
                                 Margin="15,1,0,0"
                                 Text="{Binding Data.VsUsualText}" />
                    </StackPanel>

                    <!--
                      ETA unavailable (E6): only this block reports the failure; the ruler and the
                      route above keep the saved schedule. Retry is the model's own command, bound
                      from the ValueTemplate, where Parent resolves commands.
                    -->
                    <StackPanel x:Name="ErrorPanel"
                                Margin="18,16,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                MaxWidth="200"
                                Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock x:Uid="EtaUnavailableTitle" Style="{StaticResource CardLead}"
                                 FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold"
                                 Foreground="{ThemeResource InkBrush}" AutomationProperties.LiveSetting="Polite" />
                      <TextBlock x:Uid="EtaUnavailableNote" Style="{StaticResource RowMeta}" Margin="0,2,0,0" />
                      <Button x:Name="RetryButton"
                              x:Uid="EtaRetry"
                              Style="{StaticResource RowActionGhostStyle}"
                              Height="34"
                              Margin="0,12,0,0"
                              Command="{Binding Parent.Retry}" />
                    </StackPanel>
                    </Grid>
                  </DataTemplate>
                </mvux:FeedView.ValueTemplate>

                <!-- Loading: the tiles show, the route waits, the ETA block is three skeleton bars. -->

                <!-- No drop-off: the map stays for Open in Maps (L6); the route shows tomorrow. -->
                <mvux:FeedView.NoneTemplate>
                  <DataTemplate>
                    <TextBlock x:Uid="RouteTomorrow"
                               Style="{StaticResource SectionTitle}"
                               Foreground="{ThemeResource Ink2Brush}"
                               Margin="18,16,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               AutomationProperties.LiveSetting="Polite" />
                  </DataTemplate>
                </mvux:FeedView.NoneTemplate>

              </mvux:FeedView>
            </Grid>
          </Border>

          <!-- ========================= before you go ========================= -->
          <!--
            v6 accordion. The header opens the whole list; inside it, one row is open at a time
            (OpenRow in the model). Rows are command-driven Buttons rather than WinUI Expanders: an
            Expander toggles its own IsExpanded on click, which would fight the model's single
            open-row state, and its template would need rebuilding for this row anatomy (S6).
          -->
          <mvux:FeedView Margin="0,12,0,0" Source="{Binding Stats}"
                         ProgressTemplate="{StaticResource ChecksLoadingTemplate}" UndefinedTemplate="{StaticResource ChecksLoadingTemplate}">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <utu:CardContentControl Style="{StaticResource OutlinedCardContentControlStyle}"
                                        Margin="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        CornerRadius="16"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource LineBrush}">
                  <StackPanel>
                    <Button x:Name="ChecksHeader"
                            Style="{StaticResource RowButtonStyle}"
                            CornerRadius="16"
                            Height="52"
                            Padding="14,0"
                            Command="{Binding Parent.ToggleChecks}"
                            AutomationProperties.Name="{Binding Data.ChecksReady}">
                      <Grid ColumnSpacing="10" SizeChanged="OnChecksHeaderSizeChanged">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconListChecks}" FontSize="18" Foreground="{ThemeResource Ink2Brush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Uid="ChecksTitle" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" Background="{ThemeResource ChipBrush}">
                            <TextBlock Style="{StaticResource PillText}" VerticalAlignment="Center" Foreground="{ThemeResource Ink2Brush}" Text="{Binding Data.ChecksCount}" />
                          </Border>
                        <TextBlock Grid.Column="4" Style="{StaticResource HeaderMeta}" VerticalAlignment="Center" Text="{Binding Data.ChecksReady}" />
                        <FontIcon Grid.Column="5" Style="{StaticResource CardIcon}" Glyph="{StaticResource IconChevronDown}" FontSize="16" Foreground="{ThemeResource FaintBrush}"
                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                          <FontIcon.RenderTransform>
                            <RotateTransform Angle="{Binding Data.ChecksExpanded, Converter={StaticResource BoolToAngle}}" />
                          </FontIcon.RenderTransform>
                        </FontIcon>
                      </Grid>
                    </Button>

                    <StackPanel x:Name="ChecksBody"
                                Padding="14,0,14,2"
                                BorderBrush="{ThemeResource LineBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding Data.ChecksExpanded, Converter={StaticResource BoolToVisibility}}"
                                RenderTransformOrigin="0.5,0">
                      <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ChecksBodyShift" />
                      </StackPanel.RenderTransform>

                      <!-- Fuel -->
                      <Button Style="{StaticResource RowButtonStyle}" Margin="-10,0" Padding="10,8" MinHeight="56" CornerRadius="12"
                              Command="{Binding Parent.ToggleFuel}" AutomationProperties.Name="{Binding Data.FuelRowName}">
                        <Grid ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                          </Grid.ColumnDefinitions>
                          <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconFuel}" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Foreground="{Binding Data.FuelLevel, Converter={StaticResource FuelPillInk}}" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Data.FuelTitle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource RowMeta}" Text="{Binding Data.FuelMeta}" />
                          </StackPanel>
                          <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" Visibility="{Binding Data.FuelOffline, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" Background="{Binding Data.FuelLevel, Converter={StaticResource FuelPillBrush}}">
                            <TextBlock Style="{StaticResource PillText}" VerticalAlignment="Center" Foreground="{Binding Data.FuelLevel, Converter={StaticResource FuelPillInk}}" Text="{Binding Data.FuelPill}" />
                          </Border>
                          <!-- Car offline: what the card last read, with no live signal. -->
                          <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" Background="{ThemeResource NeutralChipBrush}"
                                  Visibility="{Binding Data.FuelOffline, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource PillText}" VerticalAlignment="Center" Foreground="{ThemeResource CapsBrush}" Text="{Binding Data.FuelNoSignal}" />
                          </Border>
                          <FontIcon Grid.Column="3" Style="{StaticResource CardIcon}" Glyph="{StaticResource IconChevronRight}" FontSize="16" Foreground="{ThemeResource FaintBrush}"
                                    VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                              <RotateTransform Angle="{Binding Data.FuelOpen, Converter={StaticResource BoolToAngle}, ConverterParameter=90}" />
                            </FontIcon.RenderTransform>
                          </FontIcon>
                        </Grid>
                      </Button>
                      <TextBlock Style="{StaticResource RowDetail}" Margin="38,0,0,16" Text="{Binding Data.FuelDetail}"
                                 Visibility="{Binding Data.FuelOpen, Converter={StaticResource BoolToVisibility}}" />

                      <!-- Cabin: the one row the driver acts on. -->
                      <Rectangle Style="{StaticResource RowRule}" />
                      <Button Style="{StaticResource RowButtonStyle}" Margin="-10,0" Padding="10,8" MinHeight="56" CornerRadius="12"
                              Command="{Binding Parent.ToggleCabin}" AutomationProperties.Name="{Binding Data.CabinRowName}">
                        <Grid ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                          </Grid.ColumnDefinitions>
                          <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconThermometer}" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Foreground="{Binding Data.Cabin, Converter={StaticResource CabinIconBrush}}" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="ChecksCabinTitle" Style="{StaticResource RowTitle}"
                                       TextDecorations="{Binding Data.CabinSkipped, Converter={StaticResource BoolToStrike}}" />
                            <TextBlock Style="{StaticResource RowMeta}" Text="{Binding Data.CabinMeta}" />
                          </StackPanel>
                          <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" Background="{Binding Data.Cabin, Converter={StaticResource CabinPillBrush}}">
                            <TextBlock Style="{StaticResource PillText}" VerticalAlignment="Center" Foreground="{Binding Data.Cabin, Converter={StaticResource CabinPillInk}}" Text="{Binding Data.CabinPill}" />
                          </Border>
                          <FontIcon Grid.Column="3" Style="{StaticResource CardIcon}" Glyph="{StaticResource IconChevronRight}" FontSize="16" Foreground="{ThemeResource FaintBrush}"
                                    VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                              <RotateTransform Angle="{Binding Data.CabinOpen, Converter={StaticResource BoolToAngle}, ConverterParameter=90}" />
                            </FontIcon.RenderTransform>
                          </FontIcon>
                        </Grid>
                      </Button>
                      <StackPanel Margin="38,0,0,16" Visibility="{Binding Data.CabinOpen, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource RowDetail}" Text="{Binding Data.CabinDetail}" />
                        <Border Style="{StaticResource StatusPillStyle}" Margin="0,10,0,0" HorizontalAlignment="Left" Background="{ThemeResource ChipBrush}">
                          <TextBlock x:Uid="ChecksRemoteStart" Style="{StaticResource PillText}" VerticalAlignment="Center" Foreground="{ThemeResource Ink2Brush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0"
                                    Visibility="{Binding Data.CabinPending, Converter={StaticResource BoolToVisibility}}">
                          <Button x:Name="StartWarmingButton" Style="{StaticResource RowActionPrimaryStyle}" Command="{Binding Parent.StartWarming}"
                                  IsEnabled="{Binding Data.IsStale, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconThermometer}" FontSize="14" Foreground="{ThemeResource OnAccentBrush}" VerticalAlignment="Center" />
                              <TextBlock x:Uid="StartWarmingLabel" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="SkipWarmingButton" x:Uid="SkipWarming" Style="{StaticResource RowActionGhostStyle}" Command="{Binding Parent.SkipWarming}"
                                  IsEnabled="{Binding Data.IsStale, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                        <HyperlinkButton x:Name="UndoWarmingButton" x:Uid="UndoWarming" Style="{StaticResource RowLinkStyle}" Margin="0,12,0,0" Command="{Binding Parent.UndoWarming}"
                                         Visibility="{Binding Data.CabinDecided, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>

                      <!-- Parking. Absent on a no-trip morning rather than drawn empty. -->
                      <Rectangle Style="{StaticResource RowRule}" Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}" />
                      <Button Style="{StaticResource RowButtonStyle}" Margin="-10,0" Padding="10,8" MinHeight="56" CornerRadius="12"
                              Command="{Binding Parent.ToggleParking}" AutomationProperties.Name="{Binding Data.ParkingRowName}"
                              Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}">
                        <Grid ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                          </Grid.ColumnDefinitions>
                          <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconParking}" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Foreground="{ThemeResource GoodInkBrush}" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Data.ParkingTitle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource RowMeta}" Text="{Binding Data.ParkingMeta}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" Background="{ThemeResource GoodChipBrush}">
                            <TextBlock Style="{StaticResource PillText}" VerticalAlignment="Center" Foreground="{ThemeResource GoodInkBrush}" Text="{Binding Data.ParkingPill}" />
                          </Border>
                          <FontIcon Grid.Column="3" Style="{StaticResource CardIcon}" Glyph="{StaticResource IconChevronRight}" FontSize="16" Foreground="{ThemeResource FaintBrush}"
                                    VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                              <RotateTransform Angle="{Binding Data.ParkingOpen, Converter={StaticResource BoolToAngle}, ConverterParameter=90}" />
                            </FontIcon.RenderTransform>
                          </FontIcon>
                        </Grid>
                      </Button>
                      <TextBlock Style="{StaticResource RowDetail}" Margin="38,0,0,16" Text="{Binding Data.ParkingDetail}"
                                 Visibility="{Binding Data.ParkingOpen, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </StackPanel>
                </utu:CardContentControl>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
            <!-- Loading: the closed header, "Checking…" in place of the ready count. -->
          </mvux:FeedView>
        </StackPanel>
      </utu:CardContentControl>

      <!-- ============================ footer ============================ -->
      <mvux:FeedView Grid.Row="2" Source="{Binding Header}"
                     ProgressTemplate="{StaticResource FooterLoadingTemplate}" UndefinedTemplate="{StaticResource FooterLoadingTemplate}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <Grid Height="56" Padding="14,0,4,0" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- The live dot, the car, and its lock state. -->
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Grid VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="{ThemeResource GoodBrush}"
                           Visibility="{Binding Data.IsStale, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                  <Ellipse Width="6" Height="6" Fill="{ThemeResource FaintBrush}"
                           Visibility="{Binding Data.IsStale, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <TextBlock Style="{StaticResource HeaderMeta}" Foreground="{ThemeResource InkBrush}" Text="{Binding Data.CarName}" />
                <TextBlock Style="{StaticResource HeaderMeta}" Foreground="{ThemeResource FaintBrush}" Text="&#x00B7;" />
                <TextBlock Style="{StaticResource HeaderMeta}" Text="{Binding Data.LockState}" />
              </StackPanel>

              <!-- Labelled since v6: the lock action names what it will do. -->
              <Button Grid.Column="1"
                      Style="{StaticResource GhostPillStyle}"
                      Command="{Binding Parent.ToggleLock}"
                      IsEnabled="{Binding Data.IsStale, Converter={StaticResource InverseBool}}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Grid VerticalAlignment="Center">
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconLockOpen}" FontSize="15" Foreground="{ThemeResource InkStrongBrush}"
                              Visibility="{Binding Data.IsLocked, Converter={StaticResource BoolToVisibility}}" />
                    <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconLock}" FontSize="15" Foreground="{ThemeResource InkStrongBrush}"
                              Visibility="{Binding Data.IsLocked, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                  </Grid>
                  <TextBlock VerticalAlignment="Center" Text="{Binding Data.LockAction}" />
                </StackPanel>
              </Button>

              <Button Grid.Column="2"
                      Style="{StaticResource StartDriveStyle}"
                      Command="{Binding Parent.StartDrive}"
                      IsEnabled="{Binding Data.CanStartDrive}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Style="{StaticResource CardIcon}" Glyph="{StaticResource IconNavigation}" FontSize="14" Foreground="{ThemeResource OnInkStrongBrush}" VerticalAlignment="Center" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Parent.DriveLabel}" />
                </StackPanel>
              </Button>
            </Grid>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
        <!-- Loading: "Updating…", Unlock available, Start drive waits for the trip. -->
      </mvux:FeedView>

    </Grid>
    </utu:CardContentControl>
  </Grid>
</UserControl>
