<UserControl x:Class="MorningCard.Controls.MorningCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="using:MorningCard.Controls"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             xmlns:uen="using:Uno.Extensions.Navigation.UI"
             xmlns:mapsui="using:Mapsui.UI.WinUI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

  <!--
    The card is a Border over a childless glass sibling. Keeping the translucent fill on its own
    element leaves the content free of the backdrop, which is also what the Skia acrylic path wants
    on Android.
  -->
  <Grid>
    <!-- Sits at a negative margin so the wide blur has room; hit-test transparent. -->
    <mc:CardShadowCanvas />

    <Border x:Name="Glass"
            Background="{ThemeResource GlassBrush}"
            BorderBrush="{ThemeResource GlassEdgeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}" />

    <Grid Padding="{StaticResource CardPadding}" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <mvux:FeedView Source="{Binding Header}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <StackPanel Spacing="12">

              <!-- ======================== status strip ======================== -->
              <!-- Greeting left, weather right. Lock moved under the car: the two halves were
                   competing for the same row and the weather half needed the room. -->
              <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                  <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Stroke="{ThemeResource SunInkBrush}"
                            StrokeThickness="1.9"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M12 4V2M12 22v-2M4 12H2M22 12h-2M5.6 5.6 4.2 4.2M19.8 19.8l-1.4-1.4M5.6 18.4l-1.4 1.4M19.8 4.2l-1.4 1.4" />
                      <Ellipse Canvas.Left="7.5" Canvas.Top="7.5" Width="9" Height="9" Fill="{ThemeResource SunInkBrush}" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Style="{StaticResource StatusLineStrong}"
                             VerticalAlignment="Center"
                             Text="{Binding Data.Greeting}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                  <TextBlock Style="{StaticResource StatusLineStrong}"
                             VerticalAlignment="Center"
                             Text="{Binding Data.OutsideTemp}" />
                  <Rectangle Width="1" Height="13" VerticalAlignment="Center" Fill="{ThemeResource LineBrush}" />
                  <TextBlock Style="{StaticResource StatusLine}"
                             VerticalAlignment="Center"
                             Text="{Binding Data.WeatherSummary}" />
                </StackPanel>
              </Grid>

              <!-- ======================== headline ======================== -->
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource CardTitle}"
                               VerticalAlignment="Center"
                               Text="{Binding Data.Title}" />
                    <Viewbox Width="22" Height="22" VerticalAlignment="Center" Margin="0,3,0,0">
                      <Canvas Width="24" Height="24">
                        <Path Stroke="{ThemeResource Ink2Brush}"
                              StrokeThickness="2.2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M9 6l6 6-6 6" />
                      </Canvas>
                    </Viewbox>
                  </StackPanel>

                  <!--
                    One TextBlock, three Runs. Only the middle one takes the accent colour, which is
                    how the design puts the duration in blue without splitting the sentence into
                    separate blocks that would not share a baseline.
                  -->
                  <TextBlock Style="{StaticResource CardLead}"
                             Margin="0,4,0,0"
                             TextWrapping="Wrap"
                             Foreground="{Binding Data.Tone, Converter={StaticResource ToneBrush}}"><Run Text="{Binding Data.HeadlineLead}" /><Run Text="{Binding Data.HeadlineAccent}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" Foreground="{Binding Data.Tone, Converter={StaticResource AccentTone}}" /><Run Text="{Binding Data.HeadlineTail}" /></TextBlock>


                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                  <!-- The car sits in its own tile, which separates it from the headline it stands
                       beside and gives the lock caption something to belong to. -->
                  <Border Background="{ThemeResource CarTileBrush}"
                          CornerRadius="{StaticResource MapCornerRadius}"
                          Padding="10,8">
                    <Image Source="ms-appx:///Assets/Car/xc60.png" Width="140" Stretch="Uniform" />
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                    <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                      <Canvas Width="24" Height="24">
                        <Path Stroke="{ThemeResource Ink2Brush}"
                              StrokeThickness="2.1"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zM8 11V8a4 4 0 0 1 8 0v3" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Style="{StaticResource CardCaption}"
                               VerticalAlignment="Center"
                               Text="{Binding Data.LockText}" />
                  </StackPanel>
                </StackPanel>
              </Grid>


            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>

        <!--
          Without this the whole header vanished while the feeds were still in progress and the card
          collapsed to a bare map. The skeleton carries the same footprint, so nothing jumps when
          the data lands.
        -->
      </mvux:FeedView>

      <!-- ============================ timeline ============================ -->
      <!--
        The slack ruler flattened into a strip: three labelled times over a track whose segments are
        proportional to the same fractions the map's route uses (RouteLeave, RouteArrive). Dotted
        while the car is parked, solid for the drive, amber for the walk, with a cap at the bell.
        Bound to the ETA feed, so it is simply absent on a no-trip morning or a failed lookup
        instead of asserting times the card cannot stand behind.
      -->
      <mvux:FeedView Grid.Row="1" Source="{Binding Eta}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <StackPanel Spacing="9"
                        Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="1">
                  <TextBlock x:Uid="TimelineLeaveBy" Style="{StaticResource TimelineLabel}" />
                  <TextBlock Style="{StaticResource TimelineTime}"
                             Foreground="{ThemeResource AccentInkBrush}"
                             Text="{Binding Data.LeaveByTime}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock x:Uid="TimelineArrive" Style="{StaticResource TimelineLabel}" />
                  <TextBlock Style="{StaticResource TimelineTime}" Text="{Binding Data.ArriveTime}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="1">
                  <TextBlock x:Uid="TimelineBell" Style="{StaticResource TimelineLabel}" />
                  <TextBlock Style="{StaticResource TimelineTime}" Text="{Binding Data.BellTime}" />
                </StackPanel>
              </Grid>

              <!-- Star columns carry the proportions, so the track needs no measuring code. -->
              <Grid Height="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding Data.TrackSlack, Converter={StaticResource PercentToStar}}" />
                  <ColumnDefinition Width="{Binding Data.TrackDrive, Converter={StaticResource PercentToStar}}" />
                  <ColumnDefinition Width="{Binding Data.TrackWalk, Converter={StaticResource PercentToStar}}" />
                </Grid.ColumnDefinitions>

                <!-- Slack: dotted, because the car has not moved yet. Stretch="Fill" spans the
                     cell without a measured width, so the dash pattern needs no code behind it. -->
                <Line X1="0" Y1="0" X2="1" Y2="0"
                      Stretch="Fill"
                      VerticalAlignment="Center"
                      Margin="14,0,2,0"
                      Stroke="{ThemeResource Ink3Brush}"
                      StrokeThickness="4"
                      StrokeDashCap="Round"
                      StrokeDashArray="0.01 0.9" />

                <Border Grid.Column="1"
                        Height="8"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Background="{ThemeResource AccentBrush}" />

                <Border Grid.Column="2"
                        Height="8"
                        VerticalAlignment="Center"
                        Margin="0,0,7,0"
                        CornerRadius="4"
                        Background="{ThemeResource AmberBrush}" />

                <!-- Now, and the bell it has to beat. -->
                <Ellipse Width="11"
                         Height="11"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Fill="{ThemeResource AccentBrush}" />

                <Rectangle Grid.Column="2"
                           Width="4"
                           Height="14"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           RadiusX="2"
                           RadiusY="2"
                           Fill="{ThemeResource InkBrush}" />
              </Grid>

              <!--
                Traffic, kept at the user's request after the v2 mockup dropped the block that used
                to carry it. Not in the reference image; flagged as a deliberate addition.
              -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{Binding Data.Traffic, Converter={StaticResource TrafficBrush}}" />
                <TextBlock Style="{StaticResource CardCaption}"
                           VerticalAlignment="Center"
                           Foreground="{Binding Data.Traffic, Converter={StaticResource TrafficBrush}}"
                           Text="{Binding Data.TrafficText}" />
                <TextBlock Style="{StaticResource CardCaption}"
                           VerticalAlignment="Center"
                           Text="{Binding Data.VsUsualText}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

      <!-- ============================ map panel ============================ -->
      <Border x:Name="MapPanel"
              Grid.Row="2"
              Height="{StaticResource MapPanelHeight}"
              CornerRadius="{StaticResource MapCornerRadius}"
              Background="{ThemeResource MapBrush}">
        <Grid>
          <!--
            Real OSM tiles since v2. The route above it stays schematic - minutes become distance
            along a path - so the drawn line deliberately does not follow the streets underneath:
            the map is a textured ground, not the route's geometry. Recorded in SPEC.md v2 as the
            accepted cost of keeping the time-as-distance device.
          -->
          <!--
            Wrapped in its own rounded Border. The panel's CornerRadius does not reach the map: it
            draws through its own surface, so the outer Border clipped everything except the tiles
            and the map showed square corners inside a rounded panel.
          -->
          <Border CornerRadius="{StaticResource MapCornerRadius}">
            <mapsui:MapControl x:Name="Map" />
          </Border>

          <mc:RouteRulerCanvas x:Name="Ruler" Eta="{Binding State.Data, ElementName=EtaFeed}" />

          <!-- Real launch, not a decorative pill: it opens the platform maps app at the school. -->
          <!-- Hidden whenever a scrim covers the map: a pill showing through "Can't reach the
               car" offers to open a trip the card just said it could not read. -->
          <Button x:Name="OpenInMaps"
                  x:Uid="OpenInMapsButton"
                  Style="{StaticResource MapPillStyle}"
                  Visibility="{Binding State.Data.Failed, ElementName=EtaFeed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, FallbackValue=Collapsed}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,12,30"
                  Click="OnOpenInMaps" />

          <mvux:FeedView x:Name="EtaFeed" Source="{Binding Eta}">

            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <Grid>
                <!--
                  The failure lives here rather than in ErrorTemplate. Measured 2026-09-21: a feed
                  built on a push stream cannot be recovered by FeedView.Refresh, so a Retry bound
                  to it executes and leaves the card broken. As a value, the stream stays alive and
                  the model's own Retry puts a good trip back through it.
                -->
                <Border x:Name="ErrorPanel"
                        Background="{ThemeResource MapScrimBrush}"
                        Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Padding="24"
                              Spacing="8">
                    <TextBlock x:Uid="ErrorTitle"
                               Style="{StaticResource EmptyTitle}"
                               TextAlignment="Center" />
                    <TextBlock Style="{StaticResource CardLabel}"
                               MaxWidth="260"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding Data.FailureMessage}" />
                    <Button x:Name="RetryButton"
                            x:Uid="ErrorRetry"
                            HorizontalAlignment="Center"
                            Command="{Binding Parent.Retry}" />
                  </StackPanel>
                </Border>
                </Grid>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>

            <!-- Nothing on the calendar: the map stays, the route goes. -->
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <Border Background="{ThemeResource MapScrimBrush}">
                  <StackPanel HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Padding="24"
                              Spacing="4">
                    <TextBlock x:Uid="EmptyTitle"
                               Style="{StaticResource EmptyTitle}"
                               TextAlignment="Center" />
                    <TextBlock x:Uid="EmptyNote"
                               Style="{StaticResource CardLabel}"
                               MaxWidth="260"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>

          </mvux:FeedView>
        </Grid>
      </Border>

      <!-- ============================ list rows ============================ -->
      <mvux:FeedView Grid.Row="3" Source="{Binding Stats}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <StackPanel Opacity="{Binding Data.IsStale, Converter={StaticResource StaleOpacity}}">

              <!-- Fuel -->
              <Grid Style="{StaticResource ListRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="92" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{Binding Data.FuelLevel, Converter={StaticResource StatLevelBrush}}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M5 21V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v15M3 21h14M7 8h6M15 10h2a2 2 0 0 1 2 2v5.5a1.5 1.5 0 0 0 3 0V11l-3-3" />
                  </Canvas>
                </Viewbox>

                <TextBlock Grid.Column="1"
                           x:Uid="FuelLabel"
                           Style="{StaticResource RowLabel}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock><Run Text="{Binding Data.FuelValue}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" FontSize="21" /><Run Text=" " /><Run Text="{Binding Data.FuelUnit}" FontSize="15" /><Run Text=" " /><Run x:Uid="FuelRangeWord" FontSize="15" /></TextBlock>
                  <TextBlock Style="{StaticResource CardCaption}"><Run Text="{Binding Data.FuelNote}" /><Run Text="{Binding Data.FuelNoteAccent}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" Foreground="{Binding Data.FuelLevel, Converter={StaticResource StatLevelBrush}}" /></TextBlock>
                </StackPanel>

                <Viewbox Grid.Column="3" Width="18" Height="18" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource Ink3Brush}"
                          StrokeThickness="2.2"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M9 6l6 6-6 6" />
                  </Canvas>
                </Viewbox>
              </Grid>

              <Rectangle Style="{StaticResource RowRule}" />

              <!-- Cabin -->
              <Grid Style="{StaticResource ListRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="92" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource AccentBrush}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M12 3a2.5 2.5 0 0 1 2.5 2.5v8.2a4.5 4.5 0 1 1-5 0V5.5A2.5 2.5 0 0 1 12 3z" />
                    <Ellipse Canvas.Left="9.5"
                             Canvas.Top="15"
                             Width="5"
                             Height="5"
                             Fill="{ThemeResource AccentBrush}" />
                  </Canvas>
                </Viewbox>

                <TextBlock Grid.Column="1"
                           Style="{StaticResource RowLabel}"
                           VerticalAlignment="Center"
                           Text="{Binding Data.CabinLabel}" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock><Run Text="{Binding Data.CabinFrom}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" FontSize="21" /><Run Text="{Binding Data.CabinMid}" FontSize="17" Foreground="{ThemeResource Ink3Brush}" /><Run Text="{Binding Data.CabinTo}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" FontSize="21" /></TextBlock>
                  <TextBlock Style="{StaticResource CardCaption}"><Run Text="{Binding Data.CabinLead}" /><Run Text="{Binding Data.CabinAccent}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" Foreground="{ThemeResource AccentInkBrush}" /></TextBlock>
                </StackPanel>

                <Viewbox Grid.Column="3" Width="18" Height="18" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource Ink3Brush}"
                          StrokeThickness="2.2"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M9 6l6 6-6 6" />
                  </Canvas>
                </Viewbox>
              </Grid>

              <Rectangle Style="{StaticResource RowRule}"
                         Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}" />

              <!-- Destination. Absent entirely on a no-trip morning rather than drawn empty. -->
              <Grid Style="{StaticResource ListRowStyle}"
                    Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="92" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Ellipse Canvas.Left="2"
                             Canvas.Top="2"
                             Width="20"
                             Height="20"
                             Stroke="{ThemeResource InkBrush}"
                             StrokeThickness="1.7" />
                    <Path Stroke="{ThemeResource InkBrush}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          Data="M10 17V7h3.2a3 3 0 0 1 0 6H10" />
                  </Canvas>
                </Viewbox>

                <TextBlock Grid.Column="1"
                           Style="{StaticResource RowLabel}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding Data.DestinationLabel}" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource RowValueStrong}"
                             TextWrapping="Wrap"
                             Text="{Binding Data.ParkingStreet}" />
                  <TextBlock Style="{StaticResource CardCaption}"
                             TextWrapping="Wrap"
                             Text="{Binding Data.ParkingNote}"
                             Visibility="{Binding Data.ParkingNote, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>

                <Viewbox Grid.Column="3" Width="18" Height="18" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{ThemeResource Ink3Brush}"
                          StrokeThickness="2.2"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M9 6l6 6-6 6" />
                  </Canvas>
                </Viewbox>
              </Grid>
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>

      </mvux:FeedView>
    </Grid>
  </Grid>
</UserControl>
