<UserControl x:Class="MorningCard.Controls.MorningCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="using:MorningCard.Controls"
             xmlns:mvux="using:Uno.Extensions.Reactive.UI"
             xmlns:uen="using:Uno.Extensions.Navigation.UI"
             xmlns:mapsui="using:Mapsui.UI.WinUI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

  <!--
    The card is matte paper: an opaque frame with one hairline and one soft ambient shadow, and
    opaque panels inside it with a hairline each. No blur and no layered shadows.
  -->
  <Grid>
    <!-- Sits at a negative margin so the shadow's blur has room; hit-test transparent. -->
    <mc:CardShadowCanvas />

    <Border x:Name="Frame"
            Background="{ThemeResource ShellBackgroundBrush}"
            BorderBrush="{ThemeResource LineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}" />

    <Grid Padding="{StaticResource CardPadding}" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--
        On the shell, outside the inner card.

        The mockup is two surfaces, not one: a white card nested in a lighter shell. The strip and
        the bottom bar are what live on the shell - the greeting and the car's state frame the trip
        rather than belonging to it, and putting them on the card flattened that reading away.
      -->
      <mvux:FeedView Margin="{StaticResource StatusStripMargin}" Source="{Binding Header}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <!-- ======================== status strip ======================== -->
            <!-- Greeting with the weather under it on the left; only the time on the right. The
                 card's status is the headline's job, so the strip does not repeat it. -->
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid ColumnSpacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="{StaticResource IconFont}"
                          Glyph="{StaticResource IconGreeting}"
                          FontSize="18"
                          Foreground="{ThemeResource SunInkBrush}"
                          VerticalAlignment="Top"
                          Margin="0,1,0,0" />
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource StatusLineStrong}" Text="{Binding Data.Greeting}" />
                  <TextBlock Style="{StaticResource CardCaption}" Text="{Binding Data.WeatherLine}" />
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource StatusLine}" VerticalAlignment="Center" Text="{Binding Data.NowText}" />
                <!--
                  A real MenuFlyout, not a decorative glyph: every item runs a command the model
                  already owns. MenuFlyoutItem invokes correctly under synthesized input on Skia
                  desktop, so this is verifiable without a human at the keyboard.
                -->
                <Button x:Name="Overflow"
                        x:Uid="OverflowButton"
                        Style="{StaticResource OverflowButtonStyle}"
                        VerticalAlignment="Center">
                  <FontIcon FontFamily="{StaticResource IconFont}"
                            Glyph="{StaticResource IconOverflow}"
                            FontSize="18"
                            Foreground="{ThemeResource Ink2Brush}" />
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuFlyoutItem x:Name="MenuRefresh" x:Uid="MenuRefresh" Command="{Binding Parent.Retry}" />
                      <MenuFlyoutItem x:Name="MenuOpenMaps" x:Uid="MenuOpenMaps" Click="OnOpenInMaps" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

      <!--
        The inner card.

        Declared before the rows it backs so it renders underneath them, and spanning them rather
        than wrapping them: wrapping would have meant re-parenting four blocks and renumbering
        every row inside them. The negative margin bleeds it out past the content box, which is
        what gives it padding without each row having to carry its own.
      -->
      <Border Grid.Row="1"
              Grid.RowSpan="4"
              Margin="-16,-16,-16,-8"
              Background="{ThemeResource CardSurfaceBrush}"
              BorderBrush="{ThemeResource LineBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource CardInnerCornerRadius}" />

      <mvux:FeedView Grid.Row="1" Source="{Binding Header}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <!-- ======================== headline ======================== -->
            <!-- Title, car, sentence. The sentence sits beside the car while it fits there at full
                 size, and drops to its own full-width row under the car when it would not. -->
            <mc:HeadlineLayoutPanel ColumnSpacing="12" RowSpacing="4">
              <!-- Left-aligned with a star column, so the title trims with an ellipsis inside its
                   column instead of running under the car, and the chevron stays beside it. -->
              <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CardTitle}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Data.Title}" />
                <FontIcon Grid.Column="1"
                          FontFamily="{StaticResource IconFont}"
                          Glyph="{StaticResource IconChevronNext}"
                          FontSize="22"
                          Foreground="{ThemeResource Ink2Brush}"
                          VerticalAlignment="Center"
                          Margin="0,3,0,0" />
              </Grid>
              <!-- Desaturated to 30% (scripts/Mute-Car.ps1), so it reads as a grey object on the
                   paper rather than as a product shot competing with the route accent. The car's
                   name and lock state live in the bottom bar, beside the button that changes it. -->
              <Image Source="ms-appx:///Assets/Car/xc60_muted.png"
                     Width="135"
                     Stretch="Uniform" />
              <!--
                One TextBlock, three Runs. Only the middle one takes the accent colour, which is
                how the design puts the duration in blue without splitting the sentence into
                separate blocks that would not share a baseline.

                Always one line. The panel gives it a full-width row before it would ever shrink;
                the DownOnly Viewbox is only the last resort for a card narrower than the sentence.
              -->
              <Viewbox HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly"
                       Visibility="{Binding Data.ShowsLead, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource CardLead}"
                           TextWrapping="NoWrap"
                           Foreground="{Binding Data.Tone, Converter={StaticResource ToneBrush}}"><Run Text="{Binding Data.HeadlineLead}" /><Run Text="{Binding Data.HeadlineAccent}" FontFamily="{StaticResource CardFontMedium}" FontWeight="Medium" FontSize="{StaticResource CountdownSize}" Foreground="{Binding Data.Tone, Converter={StaticResource AccentTone}}" /><Run Text="{Binding Data.HeadlineTail}" /></TextBlock>
              </Viewbox>
            </mc:HeadlineLayoutPanel>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

      <!-- ============================ timeline ============================ -->
      <!--
        The slack ruler flattened into a strip: three labelled times over a track whose segments are
        proportional to the same fractions the map's route uses (RouteLeave, RouteArrive). Dotted
        while the car is parked, solid for the drive, amber for the walk, with a cap at the bell.
        Bound to the ETA feed, so it is simply absent on a no-trip morning or a failed lookup
        instead of asserting times the card cannot stand behind.
      -->
      <mvux:FeedView Grid.Row="2" Source="{Binding Eta}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <Grid>
            <!--
              Loading: the strip's own skeleton - three label-and-time columns over the track - in
              the chip tint, static like the rest of the card. Sized to the populated strip so
              nothing below it moves when the times arrive.
            -->
            <StackPanel Spacing="8"
                        AutomationProperties.AccessibilityView="Raw"
                        Visibility="{Binding Data.IsLoading, Converter={StaticResource BoolToVisibility}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1">
                  <Border Style="{StaticResource SkeletonLabel}" Width="52" />
                  <Border Style="{StaticResource SkeletonTime}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="1">
                  <Border Style="{StaticResource SkeletonLabel}" Width="44" />
                  <Border Style="{StaticResource SkeletonTime}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="1">
                  <Border Style="{StaticResource SkeletonLabel}" Width="32" />
                  <Border Style="{StaticResource SkeletonTime}" />
                </StackPanel>
              </Grid>
              <Border Height="34" Margin="0,4,0,4" CornerRadius="{StaticResource ChipCornerRadius}" Background="{ThemeResource ChipBrush}" />
            </StackPanel>
            <StackPanel Spacing="8"
                        Visibility="{Binding Data.ShowsRoute, Converter={StaticResource BoolToVisibility}}">
              <!-- The slack ruler. Blocks for what the morning is made of: slack in soft green,
                   the committed drive in the tone's tint, the walk in neutral, and hatched stubs for
                   the time either side (already gone, and in class). Star columns carry the
                   proportions, so the track needs no measuring code. -->
              <!-- xaml-lint: allow card - ruler segments and a status callout, not containers; a CardContentControl brings hover/pressed overlays a data bar must not have -->
              <Grid ColumnSpacing="2" RowSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="42" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="{Binding Data.TrackSlack, Converter={StaticResource PercentToStar}}" />
                  <ColumnDefinition Width="{Binding Data.TrackDrive, Converter={StaticResource PercentToStar}}" />
                  <ColumnDefinition Width="{Binding Data.TrackWalk, Converter={StaticResource PercentToStar}}" />
                  <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>

                <!-- Every label sits above the track, at the edge it names: the callout at Now,
                     Leave where the drive starts, Arrive where it ends, Bell at the bell. The panel
                     lifts a label to a second tier only when it would collide with another. -->
                <mc:RulerLabelPanel Grid.ColumnSpan="5"
                                    SlackWeight="{Binding Data.TrackSlack}"
                                    DriveWeight="{Binding Data.TrackDrive}"
                                    WalkWeight="{Binding Data.TrackWalk}">
                  <!-- The card's answer, which used to be the sentence under the title. Only the
                       accent takes the tone: sage on time, clay for leave now, brick when late. -->
                  <Border Padding="10,6"
                          CornerRadius="{StaticResource ChipCornerRadius}"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource LineBrush}"
                          Background="{ThemeResource CardSurfaceBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" Margin="0,0,2,0" VerticalAlignment="Center"
                               Fill="{Binding Data.Tone, Converter={StaticResource SlackTone}, ConverterParameter=dot}" />
                      <TextBlock VerticalAlignment="Center" Style="{StaticResource CardLabel}" Text="{Binding Data.CalloutLead}" />
                      <TextBlock VerticalAlignment="Center"
                                 Style="{StaticResource CardLabelStrong}"
                                 Foreground="{Binding Data.Tone, Converter={StaticResource SlackTone}, ConverterParameter=ink}"
                                 Text="{Binding Data.CalloutAccent}" />
                    </StackPanel>
                  </Border>
                  <StackPanel Spacing="1" Visibility="{Binding Data.ShowsLeaveBy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource TimelineLabel}" Text="{Binding Data.LeaveByLabel}" />
                    <TextBlock Style="{StaticResource TimelineTime}"
                               TextWrapping="NoWrap"
                               Foreground="{Binding Data.Tone, Converter={StaticResource ToneChipInk}}"
                               Text="{Binding Data.LeaveByTime}" />
                  </StackPanel>
                  <StackPanel Spacing="1">
                    <TextBlock x:Uid="TimelineArrive" Style="{StaticResource TimelineLabel}" HorizontalAlignment="Right" />
                    <!-- Brick when late: the arrival lands after the bell, and this is where that shows. -->
                    <TextBlock Style="{StaticResource TimelineTime}" HorizontalAlignment="Right" TextWrapping="NoWrap"
                               Foreground="{Binding Data.IsLate, Converter={StaticResource LateInk}}"
                               Text="{Binding Data.ArriveTime}" />
                  </StackPanel>
                  <StackPanel Spacing="1">
                    <TextBlock x:Uid="TimelineBell" Style="{StaticResource TimelineLabel}" HorizontalAlignment="Right" />
                    <TextBlock Style="{StaticResource TimelineTime}" HorizontalAlignment="Right" TextWrapping="NoWrap" Text="{Binding Data.BellTime}" />
                  </StackPanel>
                </mc:RulerLabelPanel>

                <!-- Ticks at the Leave and Arrive edges, in the gaps between blocks. -->
                <Rectangle Grid.Row="1" Grid.Column="2" Width="1.5" Margin="-1.75,0,0,0" HorizontalAlignment="Left" Fill="{Binding Data.Tone, Converter={StaticResource ToneTrackBrush}}" />
                <Rectangle Grid.Row="1" Grid.Column="3" Width="1" Margin="-1.5,0,0,0" HorizontalAlignment="Left" Fill="{ThemeResource Ink3Brush}" />

                <!-- Now: a thin ink line through the track, reaching up across the row gap to the
                     label band so the callout reads as hanging from it. -->
                <Rectangle Grid.Row="1"
                           Grid.Column="1"
                           Width="1.5"
                           Margin="-1,-8,0,0"
                           HorizontalAlignment="Left"
                           Fill="{ThemeResource InkBrush}" />

                <Border Grid.Row="1" Height="34" CornerRadius="8,0,0,8">
                  <Border.Background>
                    <LinearGradientBrush MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="5,5">
                      <GradientStop Offset="0" Color="{ThemeResource LineColor}" />
                      <GradientStop Offset="0.28" Color="{ThemeResource LineColor}" />
                      <GradientStop Offset="0.28" Color="Transparent" />
                      <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Height="34"
                        CornerRadius="8"
                        Background="{ThemeResource RulerSlackBrush}"
                        Visibility="{Binding Data.ShowsSlack, Converter={StaticResource BoolToVisibility}}" />

                <Border Grid.Row="1"
                        Grid.Column="2"
                        Height="34"
                        Padding="8,0"
                        CornerRadius="8"
                        Background="{Binding Data.Tone, Converter={StaticResource ToneChipBrush}}">
                  <TextBlock x:Uid="TrackDrive"
                             VerticalAlignment="Center"
                             TextTrimming="Clip"
                             Style="{StaticResource BlockLabel}"
                             Foreground="{Binding Data.Tone, Converter={StaticResource ToneChipInk}}" />
                </Border>

                <!-- The word while it fits, a walking figure once it would wrap. The word carries
                     its own margin so the fit test includes it; the icon centres with none. -->
                <Border Grid.Row="1"
                        Grid.Column="3"
                        Height="34"
                        CornerRadius="8"
                        Background="{ThemeResource RulerWalkBrush}">
                  <mc:FitOrFallbackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="TrackWalk"
                               Margin="8,0"
                               TextWrapping="NoWrap"
                               Style="{StaticResource BlockLabel}"
                               Foreground="{ThemeResource AmberInkBrush}" />
                    <FontIcon x:Uid="TrackWalkIcon"
                              HorizontalAlignment="Center"
                              FontFamily="{StaticResource IconFont}"
                              Glyph="{StaticResource IconWalk}"
                              FontSize="14"
                              Foreground="{ThemeResource AmberInkBrush}" />
                  </mc:FitOrFallbackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="4" Height="34" CornerRadius="0,8,8,0">
                  <Border.Background>
                    <LinearGradientBrush MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="5,5">
                      <GradientStop Offset="0" Color="{ThemeResource LineColor}" />
                      <GradientStop Offset="0.28" Color="{ThemeResource LineColor}" />
                      <GradientStop Offset="0.28" Color="Transparent" />
                      <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>

                <Ellipse Grid.Row="1"
                         Grid.Column="1"
                         Width="9"
                         Height="9"
                         Margin="-5,0,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Fill="{Binding Data.Tone, Converter={StaticResource ToneTrackBrush}}" />

                <!-- The bell: the one hard edge, a 2px ink tick standing proud of the blocks. -->
                <Rectangle Grid.Row="1"
                           Grid.Column="3"
                           Width="2"
                           Height="42"
                           Margin="0,0,-2,0"
                           HorizontalAlignment="Right"
                           Fill="{ThemeResource InkBrush}" />
              </Grid>


            </StackPanel>
            </Grid>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

      <!-- ============================ map panel ============================ -->
      <Border x:Name="MapPanel"
              Grid.Row="3"
              Margin="-8,0"
              Height="{StaticResource MapPanelHeight}"
              CornerRadius="{StaticResource MapCornerRadius}"
              Background="{ThemeResource CardSurfaceBrush}">
        <Grid>
          <!--
            Real OSM tiles since v2. The route above it stays schematic - minutes become distance
            along a path - so the drawn line deliberately does not follow the streets underneath:
            the map is a textured ground, not the route's geometry. Recorded in SPEC.md v2 as the
            accepted cost of keeping the time-as-distance device.
          -->
          <!--
            Wrapped in its own rounded Border. The panel's CornerRadius does not reach the map: it
            draws through its own surface, so the outer Border clipped everything except the tiles
            and the map showed square corners inside a rounded panel.
          -->
          <Border CornerRadius="{StaticResource MapCornerRadius}">
            <mapsui:MapControl x:Name="Map" />
          </Border>

          <!-- No CornerRadius of its own: the panel Border already clips to the radius, and a
               second rounding inside it cut a notch that exposed the panel's ground at the corner. -->
          <Border Visibility="{Binding State.Data.ShowsRoute, ElementName=EtaFeed, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <Border.Background>
              <!--
                Opaque, not a wash. The left of the panel is the ETA block's ground, so the map is
                fully gone behind it and only reappears past the text - a half-visible street grid
                under a headline reads as a rendering fault rather than as depth.
              -->
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{ThemeResource EtaScrimColor}" Offset="0" />
                <GradientStop Color="{ThemeResource EtaScrimStop1Color}" Offset="0.25" />
                <GradientStop Color="{ThemeResource EtaScrimStop2Color}" Offset="0.42" />
                <GradientStop Color="{ThemeResource EtaScrimStop3Color}" Offset="0.52" />
                <GradientStop Color="{ThemeResource EtaScrimStop4Color}" Offset="0.58" />
                <GradientStop Color="{ThemeResource EtaScrimStop5Color}" Offset="0.63" />
                <GradientStop Color="{ThemeResource EtaScrimStop6Color}" Offset="0.68" />
                <GradientStop Color="{ThemeResource EtaScrimStop7Color}" Offset="0.71" />
                <GradientStop Color="{ThemeResource EtaScrimFadeColor}" Offset="0.74" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <mc:RouteRulerCanvas x:Name="Ruler" Eta="{Binding State.Data, ElementName=EtaFeed}" />

          <!-- Real launch, not a decorative pill: it opens the platform maps app at the school. -->
          <!-- Hidden whenever a scrim covers the map: a pill showing through "Can't reach the
               car" offers to open a trip the card just said it could not read. -->
          <Button x:Name="OpenInMaps"
                  x:Uid="OpenInMapsButton"
                  Style="{StaticResource MapPillStyle}"
                  Visibility="{Binding State.Data.ShowsRoute, ElementName=EtaFeed, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,8,26"
                  Click="OnOpenInMaps" />

          <mvux:FeedView x:Name="EtaFeed" Source="{Binding Eta}">

            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <Grid>
                <!--
                  The failure lives here rather than in ErrorTemplate. Measured 2026-09-21: a feed
                  built on a push stream cannot be recovered by FeedView.Refresh, so a Retry bound
                  to it executes and leaves the card broken. As a value, the stream stays alive and
                  the model's own Retry puts a good trip back through it.
                -->
                <!--
                  A gradient scrim under the ETA block. The v1 map was a schematic that faded out
                  behind these numbers; real tiles do not, and dark ink on a street grid measured
                  unreadable. The fade keeps the map legible where the route runs and gives the
                  figures a ground where they sit.
                -->


                <!--
                  Back inside the map in v3. It carries the minutes, the arrival and the traffic
                  read, which the timeline strip above deliberately does not repeat.
                -->
                <StackPanel Margin="8,16,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            MaxWidth="200"
                            Visibility="{Binding Data.ShowsRoute, Converter={StaticResource BoolToVisibility}}"><StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource CardBody}" /></StackPanel.Resources>
                  <!-- The drive alone: the countdown is the headline's and the slack is the
                       ruler's, so each of the three durations appears once. -->
                  <TextBlock Style="{StaticResource EtaNumber}"
                             Foreground="{Binding Data.IsLate, Converter={StaticResource LateInk}}"><Run Text="{Binding Data.DriveMinutes}" /><Run Text=" " /><Run Text="{Binding Parent.EtaUnitLabel}" FontFamily="{StaticResource CardFontMedium}" FontWeight="Medium" FontSize="{StaticResource EtaUnitSize}" /></TextBlock>
                  <TextBlock x:Uid="EtaDriveLabel" Style="{StaticResource TimelineLabel}" />

                  <StackPanel Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                               Fill="{Binding Data.Traffic, Converter={StaticResource TrafficBrush}}" />
                      <TextBlock Style="{StaticResource CardLabelStrong}"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding Data.Traffic, Converter={StaticResource TrafficBrush}}"
                                 Text="{Binding Data.TrafficText}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CardCaption}"
                               Foreground="{ThemeResource Ink3Brush}"
                               Text="{Binding Data.VsUsualText}" />
                  </StackPanel>
                </StackPanel>

                <!--
                  Loading: the ETA block's skeleton where the block will land - number, label,
                  traffic line, note - on the same scrim the empty state uses, so the tiles do not
                  read as a route that forgot to draw. The panel is a fixed height, so no shift.
                -->
                <Border Background="{ThemeResource MapScrimBrush}"
                        AutomationProperties.AccessibilityView="Raw"
                        Visibility="{Binding Data.IsLoading, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Margin="8,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="6">
                    <Border Width="72" Height="30" Margin="0,4,0,0" HorizontalAlignment="Left" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource ChipBrush}" />
                    <Border Style="{StaticResource SkeletonLabel}" Width="96" />
                    <Border Width="92" Height="12" Margin="0,8,0,0" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource ChipBrush}" />
                    <Border Width="140" Height="10" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource ChipBrush}" />
                  </StackPanel>
                </Border>

                <Border x:Name="ErrorPanel"
                        Background="{ThemeResource MapScrimBrush}"
                        Visibility="{Binding Data.Failed, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Padding="24"
                              Spacing="8">
                    <TextBlock x:Uid="ErrorTitle"
                               Style="{StaticResource EmptyTitle}"
                               TextAlignment="Center" />
                    <TextBlock Style="{StaticResource CardLabel}"
                               MaxWidth="260"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding Data.FailureMessage}" />
                    <Button x:Name="RetryButton"
                            x:Uid="ErrorRetry"
                            HorizontalAlignment="Center"
                            Command="{Binding Parent.Retry}" />
                  </StackPanel>
                </Border>
                </Grid>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>


            <!-- Nothing on the calendar: the map stays, the route goes. -->
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <Border Background="{ThemeResource MapScrimBrush}">
                  <StackPanel HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Padding="24"
                              Spacing="4">
                    <TextBlock x:Uid="EmptyTitle"
                               Style="{StaticResource EmptyTitle}"
                               TextAlignment="Center" />
                    <TextBlock x:Uid="EmptyNote"
                               Style="{StaticResource CardLabel}"
                               MaxWidth="260"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>

          </mvux:FeedView>
        </Grid>
      </Border>

      <!-- ========================= before you go ========================= -->
      <mvux:FeedView Grid.Row="4" Source="{Binding Stats}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <!--
              One container for the whole checklist, header and rows together, as the mockup draws
              it. The header carried the border on its own before, which made the rows beneath it
              read as loose items on the card rather than as the contents of the thing that just
              opened. The disclosure and what it discloses belong in the same box.
            -->
            <Border Margin="-8,0"
                    BorderBrush="{ThemeResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource MapCornerRadius}"
                    Opacity="{Binding Data.IsStale, Converter={StaticResource StaleOpacity}}">
              <StackPanel>

                <!--
                  The header is the disclosure control: one target for the whole row rather than a
                  separate chevron button, so the hit area matches what it looks like.
                -->
                <!--
                  In its own container, as the mockup draws it: the checklist is a panel the card
                  opens, and a bare row of text gave the disclosure nothing to belong to. The border
                  is what makes the closed state read as a closed thing rather than as a spare line.
                -->
                <!-- No border of its own: the container around the whole checklist owns that, and
                     the two were drawn on top of each other. -->
                <Button x:Name="ChecksHeader"
                        Style="{StaticResource RowButtonStyle}"
                        CornerRadius="{Binding Data.ChecksExpanded, Converter={StaticResource ChecksHeaderRadius}}"
                        Padding="16,12"
                        Command="{Binding Parent.ToggleChecks}"
                        AutomationProperties.Name="{Binding Data.ChecksReady}">
                  <!-- Padding zeroed: the row style's own 14pt top and bottom stacked on the
                       button's and made the closed checklist half again the reference's height. -->
                  <Grid Style="{StaticResource ListRowStyle}" Padding="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon FontFamily="{StaticResource IconFont}"
                              Glyph="{StaticResource IconChecklist}"
                              FontSize="20"
                              Foreground="{ThemeResource Ink2Brush}"
                              VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" x:Uid="ChecksTitle" Style="{StaticResource RowValueStrong}" VerticalAlignment="Center" />

                    <Border Grid.Column="2" Background="{ThemeResource ChipBrush}" CornerRadius="{StaticResource ChipCornerRadius}" Padding="8,4" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource CardCaption}" Text="{Binding Data.ChecksCount}" />
                    </Border>

                    <!-- The count in words only. Three coloured dots beside it said the same thing
                         to anyone who could tell the colours apart, and nothing to anyone else. -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource CardCaption}"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding Data.CabinNeedsWarming, Converter={StaticResource ReadyInk}}"
                                 Text="{Binding Data.ChecksReady}" />
                    </StackPanel>

                    <!-- One glyph, rotated, rather than two glyphs swapped. -->
                    <!-- caret-down, turned over rather than swapped for caret-up: one glyph,
                         and the turn is animatable where a Glyph string is not. -->
                    <FontIcon Grid.Column="4"
                              FontFamily="{StaticResource IconFont}"
                              Glyph="{StaticResource IconDisclosure}"
                              FontSize="16"
                              Foreground="{ThemeResource Ink3Brush}"
                              VerticalAlignment="Center"
                              Margin="0"
                              RenderTransformOrigin="0.5,0.5">
                      <FontIcon.RenderTransform>
                        <RotateTransform Angle="{Binding Data.ChecksExpanded, Converter={StaticResource BoolToAngle}}" />
                      </FontIcon.RenderTransform>
                    </FontIcon>
                  </Grid>
                </Button>

                <!--
                  Everything below the header collapses together, and appears at once: the matte
                  design keeps motion to press and hover, so there is no reveal.
                -->
                <StackPanel x:Name="ChecksBody"
                            Visibility="{Binding Data.ChecksExpanded, Converter={StaticResource BoolToVisibility}}">
                <Rectangle Style="{StaticResource RowRule}" />

                <!-- Fuel: informational, so it carries a status chip and no action. -->
                <Grid Style="{StaticResource ListRowStyle}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <FontIcon FontFamily="{StaticResource IconFont}"
                            Glyph="{StaticResource IconFuel}"
                            FontSize="22"
                            Foreground="{Binding Data.FuelLevel, Converter={StaticResource StatLevelBrush}}"
                            VerticalAlignment="Center" />

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowValueStrong}"><Run Text="{Binding Data.FuelValue}" /><Run Text=" " /><Run Text="{Binding Data.FuelUnit}" /><Run Text=" " /><Run x:Uid="FuelRangeWord" /></TextBlock>
                    <TextBlock Style="{StaticResource CardCaption}" Text="{Binding Data.FuelTitle}" />
                  </StackPanel>

                  <Border Grid.Column="2" Background="{ThemeResource AmberChipBrush}" CornerRadius="{StaticResource ChipCornerRadius}" Padding="8,4" VerticalAlignment="Center"
                          Visibility="{Binding Data.FuelNoteAccent, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Style="{StaticResource CardCaption}" Foreground="{ThemeResource AmberInkBrush}" Text="{Binding Data.FuelChip}" />
                  </Border>

                  <!--
                    Decorative, and accepted as such: nothing sits behind these rows in a sample whose
                    whole product is one card. Recorded here rather than left for a reviewer to find.
                  -->
                  <FontIcon FontFamily="{StaticResource IconFont}"
                            Glyph="{StaticResource IconChevronNext}"
                            FontSize="16"
                            Foreground="{ThemeResource Ink3Brush}"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Margin="0" />
                </Grid>

                <Rectangle Style="{StaticResource RowRule}" />

                <!-- Cabin: the one check the driver can still act on, so it owns the actions. -->
                <Grid Style="{StaticResource ListRowStyle}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <FontIcon FontFamily="{StaticResource IconFont}"
                            Glyph="{StaticResource IconCabin}"
                            FontSize="22"
                            Foreground="{ThemeResource AccentBrush}"
                            VerticalAlignment="Top"
                            Margin="0,2,0,0" />

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                    <StackPanel>
                      <TextBlock x:Uid="ChecksCabinTitle" Style="{StaticResource RowValueStrong}" />
                      <TextBlock Style="{StaticResource CardCaption}"><Run Text="{Binding Data.CabinLead}" /><Run Text="{Binding Data.CabinAccent}" FontFamily="{StaticResource CardFontSemiBold}" FontWeight="SemiBold" Foreground="{ThemeResource AccentInkBrush}" /></TextBlock>
                    </StackPanel>

                    <StackPanel Spacing="8" Visibility="{Binding Data.CabinNeedsWarming, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Style="{StaticResource CardCaption}" Foreground="{ThemeResource Ink2Brush}" TextWrapping="Wrap" Text="{Binding Data.CabinDetail}" />
                      <!-- The method only. The temperatures are already in the row's own line. -->
                      <Border Background="{ThemeResource ChipBrush}" CornerRadius="{StaticResource ChipCornerRadius}" Padding="8,4" HorizontalAlignment="Left">
                        <TextBlock x:Uid="ChecksCabinRemote" Style="{StaticResource CardCaption}" />
                      </Border>

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="StartWarming"
                                Style="{StaticResource PrimaryPillStyle}"
                                Command="{Binding Parent.ToggleClimate}"
                                IsEnabled="{Binding Data.IsStale, Converter={StaticResource InverseBool}}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>

                  <Border Grid.Column="2" Background="{ThemeResource AccentChipBrush}" CornerRadius="{StaticResource ChipCornerRadius}" Padding="8,4" VerticalAlignment="Top" Margin="0,2,0,0"
                          Visibility="{Binding Data.CabinNeedsWarming, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Uid="ChecksCabinSuggested" Style="{StaticResource CardCaption}" Foreground="{ThemeResource AccentInkBrush}" />
                  </Border>
                </Grid>

                <Rectangle Style="{StaticResource RowRule}"
                           Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}" />

                <!-- Destination. Absent entirely on a no-trip morning rather than drawn empty. -->
                <Grid Style="{StaticResource ListRowStyle}"
                      Visibility="{Binding Data.HasDestination, Converter={StaticResource BoolToVisibility}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <FontIcon FontFamily="{StaticResource IconFont}"
                            Glyph="{StaticResource IconParking}"
                            FontSize="22"
                            Foreground="{ThemeResource InkBrush}"
                            VerticalAlignment="Center" />

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowValueStrong}" TextWrapping="Wrap" Text="{Binding Data.ParkingStreet}" />
                    <TextBlock Style="{StaticResource CardCaption}" TextWrapping="Wrap" Text="{Binding Data.ParkingNote}" />
                  </StackPanel>

                  <Border Grid.Column="2" Background="{ThemeResource GoodChipBrush}" CornerRadius="{StaticResource ChipCornerRadius}" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardCaption}" Foreground="{ThemeResource GoodInkBrush}" Text="{Binding Data.ParkingChip}" />
                  </Border>

                  <!--
                    Decorative, and accepted as such: nothing sits behind these rows in a sample whose
                    whole product is one card. Recorded here rather than left for a reviewer to find.
                  -->
                  <FontIcon FontFamily="{StaticResource IconFont}"
                            Glyph="{StaticResource IconChevronNext}"
                            FontSize="16"
                            Foreground="{ThemeResource Ink3Brush}"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Margin="0" />
                </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

      <!-- ============================ bottom bar ============================ -->
      <mvux:FeedView Grid.Row="5" Margin="{StaticResource BottomBarMargin}" Source="{Binding Header}">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!--
                The car, beside the button that changes its lock. The card's status is the
                headline's job, so it is not repeated here. The dot is the connection and is never
                the only signal: offline, the text itself reads "Last seen 7:20".
              -->
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{Binding Data.IsStale, Converter={StaticResource ConnectionDotBrush}}" />
                <TextBlock Style="{StaticResource CardCaption}"
                           VerticalAlignment="Center"
                           Text="{Binding Data.LockText}" />
              </StackPanel>

              <!-- Labelled with the action it takes, icon and word, so it is not an unlabelled
                   padlock that could be read as a state instead of a control. -->
              <Button Grid.Column="1"
                      Style="{StaticResource GhostPillStyle}"
                      Command="{Binding Parent.ToggleLock}"
                      IsEnabled="{Binding Data.IsStale, Converter={StaticResource InverseBool}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Data.LockAction}"
                             Style="{StaticResource ButtonLabel}"
                             Foreground="{ThemeResource InkBrush}"
                             VerticalAlignment="Center" />
                  <FontIcon FontFamily="{StaticResource IconFont}"
                            Glyph="{Binding Data.IsLocked, Converter={StaticResource LockGlyph}}"
                            FontSize="15"
                            Foreground="{ThemeResource InkBrush}"
                            VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Grid.Column="2"
                      Style="{StaticResource StartDriveStyle}"
                      Command="{Binding Parent.StartDrive}"
                      IsEnabled="{Binding Data.IsStale, Converter={StaticResource InverseBool}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Parent.DriveLabel}"
                             Style="{StaticResource ButtonLabel}"
                             Foreground="{ThemeResource GlassInkBrush}"
                             VerticalAlignment="Center" />
                  <FontIcon FontFamily="{StaticResource IconFont}"
                            Glyph="{StaticResource IconDrive}"
                            FontSize="15"
                            Foreground="{ThemeResource GlassInkBrush}"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                    <!-- The glyph points up-left; a quarter turn points it up-right, forward from
                         the label and the way the drive goes. -->
                    <FontIcon.RenderTransform>
                      <RotateTransform Angle="90" />
                    </FontIcon.RenderTransform>
                  </FontIcon>
                </StackPanel>
              </Button>
            </Grid>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
      </mvux:FeedView>

    </Grid>
  </Grid>
</UserControl>