<UserControl x:Class="MorningCard.Controls.BokehBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="using:MorningCard.Controls"
             IsHitTestVisible="False">

  <!-- Dark slate ground with a fixed film grain over it (GrainCanvas). -->
  <Grid Background="{ThemeResource GroundBrush}">
    <mc:GrainCanvas />
  </Grid>
</UserControl>
