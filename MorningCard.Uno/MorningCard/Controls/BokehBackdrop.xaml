<UserControl x:Class="MorningCard.Controls.BokehBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">

  <!--
    Four out-of-focus blobs on the ground colour. Drawn as soft radial gradients rather than blurred
    ellipses: Composition blur does not render on the Skia desktop head, and a gradient that is
    already soft costs nothing per frame.
  -->
  <Grid Background="{ThemeResource GroundBrush}">
    <Grid x:Name="Blobs">
      <Ellipse Width="460" Height="460" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-40,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="{ThemeResource BlobAColor}" />
            <GradientStop Offset="1" Color="Transparent" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-140,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="{ThemeResource BlobBColor}" />
            <GradientStop Offset="1" Color="Transparent" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <Ellipse Width="480" Height="480" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="80,0,0,-120">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="{ThemeResource BlobCColor}" />
            <GradientStop Offset="1" Color="Transparent" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,-60">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="{ThemeResource BlobDColor}" />
            <GradientStop Offset="1" Color="Transparent" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
    </Grid>
  </Grid>
</UserControl>
