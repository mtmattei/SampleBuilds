<UserControl x:Class="MorningCard.Controls.CarGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The car, as drawn in the mockup. A fixed 120x56 design space inside a Viewbox, so it scales with
    the header without touching the path data.
  -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="120" Height="56">
      <Canvas.Resources>
        <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
          <GradientStop Offset="0" Color="#D7DBE0" />
          <GradientStop Offset="1" Color="#9AA3AC" />
        </LinearGradientBrush>
      </Canvas.Resources>

      <Path Fill="{StaticResource BodyBrush}"
            Data="M8 38 L11 27 Q14 23 24 22 L34 9 Q37 5 44 5 L96 5 Q102 5 106 9 L110 22 L114 24 Q118 26 118 31 L118 38 Q118 42 114 42 L8 42 Q5 42 5 39 Z" />
      <Path Fill="#5C6670"
            Data="M36 22 L42 10 Q43 8 46 8 L66 8 L66 22 Z M70 22 L70 8 L95 8 Q99 8 100 11 L104 22 Z" />
      <Path Fill="#7D8790"
            Data="M8 38 L118 38 L118 40 Q118 42 114 42 L8 42 Q5 42 5 39 Z" />

      <Path Fill="#2A3138" Data="M30 34 A8 8 0 1 1 29.99 34 Z" />
      <Path Fill="#B8C0C8" Data="M30 38.5 A3.5 3.5 0 1 1 29.99 38.5 Z" />
      <Path Fill="#2A3138" Data="M94 34 A8 8 0 1 1 93.99 34 Z" />
      <Path Fill="#B8C0C8" Data="M94 38.5 A3.5 3.5 0 1 1 93.99 38.5 Z" />

      <Path Stroke="#F4F6F8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12 30h8" />
    </Canvas>
  </Viewbox>
</UserControl>
