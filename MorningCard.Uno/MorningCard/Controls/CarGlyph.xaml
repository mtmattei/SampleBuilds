<UserControl x:Class="MorningCard.Controls.CarGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The car, as the mockup has it: a front three-quarter XC60 cutout.

    Supplied as a transparent PNG and trimmed to its opaque bounds, then resampled to 576x300 -
    six times the 96 epx slot, so it stays crisp on a 3x phone while dropping the file from 1.6 MB
    to 276 KB. The source aspect is 1.92, and the slot matches it, so Uniform neither letterboxes
    nor crops.

    This replaced three attempts at a hand-drawn vector. At this size a drawing cannot carry the
    detail a photograph does, and the near-realistic versions read as a generic sedan.
  -->
  <Image Source="ms-appx:///Assets/Car/xc60_muted.png"
         Stretch="Uniform"
         AutomationProperties.AccessibilityView="Raw" />
</UserControl>
