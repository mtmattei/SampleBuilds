<!-- Integration blueprint. Implement Carte.Controls.TasteMapView and the view-model contract in BUILD-GUIDE.md. -->
<Page
    x:Class="Carte.Presentation.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Carte.Controls"
    Background="{StaticResource CartePaperBrush}">
    <Grid Padding="24" RowSpacing="16" RowDefinitions="Auto,Auto,Auto,*,Auto" MaxWidth="1120">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="carte." Style="{StaticResource CarteTitleTextStyle}" />
            <Button Grid.Column="1" x:Uid="ExplorePage.ScanMenu"
                    Content="Scan menu" Command="{Binding ScanMenuCommand}"
                    Style="{StaticResource CarteSecondaryButtonStyle}" />
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock x:Uid="ExplorePage.Eyebrow" Text="Your evening, mapped" Style="{StaticResource CarteLabelTextStyle}" />
            <TextBlock Text="{Binding MenuName}" Style="{StaticResource CarteTitleTextStyle}" />
            <TextBlock Text="{Binding MenuSubtitle}" Style="{StaticResource CarteSecondaryTextStyle}" />
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ListView ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Menu category">
                <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemTemplate><DataTemplate><Grid Padding="12"><TextBlock Text="{Binding Label}" Style="{StaticResource CarteSecondaryTextStyle}" /></Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <Button Grid.Column="1" Content="{Binding OtherViewLabel}" Command="{Binding ToggleViewCommand}"
                    Style="{StaticResource CarteSecondaryButtonStyle}" />
        </Grid>
        <Grid Grid.Row="3" RowDefinitions="*,Auto" ColumnSpacing="24" RowSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DetailColumn" Width="0" /></Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Compact" />
                    <VisualState x:Name="Expanded">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="905" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DetailColumn.Width" Value="360" />
                            <Setter Target="DetailPanel.(Grid.Row)" Value="0" />
                            <Setter Target="DetailPanel.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <controls:TasteMapView ItemsSource="{Binding VisibleItems}"
                    AxisSet="{Binding SelectedCategory.AxisSet}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    Visibility="{Binding MapVisibility}"
                    AutomationProperties.Name="Taste map" />
            <ListView ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      Visibility="{Binding ListVisibility}" SelectionMode="Single" AutomationProperties.Name="Menu items">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,12" ColumnDefinitions="44,*,Auto" ColumnSpacing="12" MinHeight="64">
                            <Image Source="{Binding GlyphUri}" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource CarteItemTitleTextStyle}" />
                                <TextBlock Text="{Binding SensorySummary}" Style="{StaticResource CarteSecondaryTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding PriceText}" Style="{StaticResource CartePriceTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ScrollViewer x:Name="DetailPanel" Grid.Row="1" MaxHeight="440">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding SelectedItem.Name}" Style="{StaticResource CarteItemTitleTextStyle}" />
                    <TextBlock Text="{Binding SelectedItem.Description}" Style="{StaticResource CarteBodyTextStyle}" />
                    <Button x:Uid="ItemDetail.Why" Content="Why here?" Command="{Binding ToggleRationaleCommand}" Style="{StaticResource CarteSecondaryButtonStyle}" />
                    <TextBlock Text="{Binding SelectedItem.Rationale}" Visibility="{Binding RationaleVisibility}" Style="{StaticResource CarteSecondaryTextStyle}" />
                    <Button Content="{Binding SaveLabel}" Command="{Binding ToggleSavedCommand}" Style="{StaticResource CartePrimaryButtonStyle}" />
                    <Button x:Uid="ItemDetail.Pair" Content="Pair it" Command="{Binding PairCommand}" IsEnabled="{Binding CanPair}" Style="{StaticResource CarteSecondaryButtonStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Button Grid.Row="4" Content="{Binding TonightLabel}" Command="{Binding ShowTonightCommand}"
                HorizontalAlignment="Right" Style="{StaticResource CarteSecondaryButtonStyle}" />
    </Grid>
</Page>
