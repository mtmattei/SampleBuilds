<Page x:Class="Carte.Presentation.CapturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Carte.Presentation"
      xmlns:controls="using:Carte.Controls"
      Background="{StaticResource CartePaperBrush}">
  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters><Setter Target="ContentRoot.Padding" Value="16,8,16,24" /></VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="360" /></VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ContentRoot" MaxWidth="640" Padding="24,8,24,24">
        <controls:AppHeader />

        <Button Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}" Style="{StaticResource CarteQuietButtonStyle}"
                Margin="-8,16,0,0" AutomationProperties.LabeledBy="{x:Bind BackText}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Source="ms-appx:///Assets/Svg/arrow-left.svg" Style="{StaticResource CarteIconStyle}" />
            <TextBlock x:Name="BackText" x:Uid="CapturePage.BackLabel" Text="Back to your menu" Style="{StaticResource CarteQuietActionTextStyle}" />
          </StackPanel>
        </Button>

        <TextBlock x:Uid="CapturePage.Eyebrow" Text="01 / Photograph" Style="{StaticResource CarteLabelTextStyle}"
                   controls:TextCase.Upper="True" Margin="0,8,0,8" />
        <TextBlock x:Uid="CapturePage.Title" Text="Good taste starts with a menu." Style="{StaticResource CarteTitleTextStyle}"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Uid="CapturePage.Instruction" Style="{StaticResource CarteSecondaryTextStyle}" Margin="0,12,0,24" />

        <!-- Illustrative viewfinder: the sample menu as a photographed page, not a camera feed -->
        <Grid Background="{StaticResource CarteWashBrush}" Padding="20,24" AutomationProperties.AccessibilityView="Raw">
          <Path Data="M0,18 L0,0 L18,0" Stroke="{StaticResource CarteInkBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-12,-16,0,0" />
          <Path Data="M0,0 L18,0 L18,18" Stroke="{StaticResource CarteInkBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-16,-12,0" />
          <Path Data="M0,0 L0,18 L18,18" Stroke="{StaticResource CarteInkBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-12,0,0,-16" />
          <Path Data="M18,0 L18,18 L0,18" Stroke="{StaticResource CarteInkBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-12,-16" />
          <Border Background="{StaticResource CartePaperBrush}" BorderBrush="{StaticResource CarteRuleBrush}" BorderThickness="1"
                  Padding="20,24" Margin="8" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><RotateTransform Angle="-1.5" /></Border.RenderTransform>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Bind ViewModel.MenuName, Mode=OneWay}" Style="{StaticResource CarteItemTitleTextStyle}" HorizontalAlignment="Center" />
              <TextBlock x:Uid="CapturePage.CardSubtitle" Text="À la carte" Style="{StaticResource CarteLabelTextStyle}"
                         controls:TextCase.Upper="True" HorizontalAlignment="Center" Margin="0,0,0,12" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:CaptureLine">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,8" BorderBrush="{StaticResource CarteRuleBrush}" BorderThickness="0,1,0,0">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource CarteBodyTextStyle}" FontFamily="{StaticResource CarteEditorialFont}" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Price}" Style="{StaticResource CarteBodyTextStyle}" FontFamily="{StaticResource CarteEditorialFont}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock x:Uid="Demo.ScanPreview" Style="{StaticResource CarteSecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,20,0,16" />

        <Button Command="{x:Bind ViewModel.ReadCommand, Mode=OneWay}" Style="{StaticResource CartePrimaryButtonStyle}"
                HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                AutomationProperties.LabeledBy="{x:Bind ReadText}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Source="ms-appx:///Assets/Svg/camera-paper.svg" Style="{StaticResource CarteIconStyle}" />
            <TextBlock x:Name="ReadText" x:Uid="CapturePage.ReadLabel" Text="Read this menu" Style="{StaticResource CarteActionTextStyle}"
                       Foreground="{StaticResource CartePaperBrush}" />
          </StackPanel>
        </Button>

        <!-- Reading state: cancelling stops the late result from navigating -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsReading, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <ProgressRing IsActive="{x:Bind ViewModel.IsReading, Mode=OneWay}" Width="20" Height="20" Foreground="{StaticResource CarteInkBrush}" />
            <TextBlock x:Uid="ReviewPage.Reading" Style="{StaticResource CarteBodyTextStyle}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <Button Grid.Column="1" x:Uid="Common.Cancel" Content="Cancel" Command="{x:Bind ViewModel.CancelReadCommand, Mode=OneWay}"
                  Style="{StaticResource CarteSecondaryButtonStyle}" />
        </Grid>

        <TextBlock x:Uid="CapturePage.ReviewHint" Text="A quick review before we draw your map." Style="{StaticResource CarteSecondaryTextStyle}"
                   HorizontalAlignment="Center" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
