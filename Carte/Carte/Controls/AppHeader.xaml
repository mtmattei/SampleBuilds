<UserControl x:Class="Carte.Controls.AppHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid ColumnDefinitions="*,Auto" MinHeight="64" BorderBrush="{StaticResource CarteInkBrush}" BorderThickness="0,0,0,1.5" Padding="0,12,0,12">
    <TextBlock Text="carte." Style="{StaticResource CarteWordmarkTextStyle}" VerticalAlignment="Center" AutomationProperties.Name="Carte" />
    <Button x:Name="ScanButton" Grid.Column="1" Command="{x:Bind ScanCommand, Mode=OneWay}" Style="{StaticResource CarteQuietButtonStyle}"
            Margin="0,0,-8,0" AutomationProperties.LabeledBy="{x:Bind ScanText}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Image Source="ms-appx:///Assets/Svg/scan-line.svg" Style="{StaticResource CarteIconStyle}" />
        <TextBlock x:Name="ScanText" x:Uid="ExplorePage.ScanMenuLabel" Text="Scan menu" Style="{StaticResource CarteQuietActionTextStyle}" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
