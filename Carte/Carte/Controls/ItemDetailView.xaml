<UserControl x:Class="Carte.Controls.ItemDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Visibility="{x:Bind ShowHeader, Mode=OneWay}">
      <TextBlock Text="{x:Bind Item.Name, Mode=OneWay}" Style="{StaticResource CarteItemTitleTextStyle}"
                 AutomationProperties.HeadingLevel="Level2" />
      <TextBlock Grid.Column="1" Text="{x:Bind Item.PriceText, Mode=OneWay}" Style="{StaticResource CartePriceTextStyle}"
                 VerticalAlignment="Bottom" Margin="0,0,0,5" />
    </Grid>
    <TextBlock Text="{x:Bind Item.SensorySummary, Mode=OneWay}" Style="{StaticResource CarteSecondaryTextStyle}"
               Visibility="{x:Bind ShowHeader, Mode=OneWay}" />
    <TextBlock Text="{x:Bind Item.Description, Mode=OneWay}" Style="{StaticResource CarteBodyTextStyle}" />
    <TextBlock x:Uid="ExplorePage.Unplaced" Style="{StaticResource CarteSecondaryTextStyle}"
               Visibility="{x:Bind Item.IsUnplaced, Mode=OneWay}" />

    <Button Content="{x:Bind Item.WhyLabel, Mode=OneWay}" Command="{x:Bind Item.ToggleRationaleCommand, Mode=OneWay}"
            Style="{StaticResource CarteLinkButtonStyle}" Margin="0,-6,0,-6" />

    <!-- Source evidence first, then the inferred explanation. -->
    <Grid ColumnDefinitions="1,*" ColumnSpacing="16" Visibility="{x:Bind Item.IsRationaleOpen, Mode=OneWay}">
      <Rectangle Fill="{StaticResource CarteInkBrush}" />
      <StackPanel Grid.Column="1" Spacing="8" Padding="0,2">
        <TextBlock Text="{x:Bind Item.SourceLine, Mode=OneWay}" Style="{StaticResource CarteSecondaryTextStyle}" />
        <TextBlock Text="{x:Bind Item.Rationale, Mode=OneWay}" Style="{StaticResource CarteSecondaryTextStyle}" />
        <TextBlock x:Uid="ItemDetail.UnknownIngredients" Style="{StaticResource CarteLabelTextStyle}" />
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
      <Button Command="{x:Bind Item.ToggleSavedCommand, Mode=OneWay}" Style="{StaticResource CartePrimaryButtonStyle}"
              HorizontalAlignment="Stretch" AutomationProperties.LabeledBy="{x:Bind SaveText}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Image Source="{x:Bind Item.SaveGlyph, Mode=OneWay}" Style="{StaticResource CarteIconStyle}" />
          <TextBlock x:Name="SaveText" Text="{x:Bind Item.SaveLabel, Mode=OneWay}" Style="{StaticResource CarteActionTextStyle}"
                     Foreground="{StaticResource CartePaperBrush}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Command="{x:Bind Item.PairCommand, Mode=OneWay}" Style="{StaticResource CarteSecondaryButtonStyle}"
              Visibility="{x:Bind Item.CanPair, Mode=OneWay}" AutomationProperties.Name="{x:Bind Item.PairName, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Image Source="{x:Bind Item.PairGlyph, Mode=OneWay}" Style="{StaticResource CarteIconStyle}" />
          <TextBlock x:Uid="ItemDetail.PairLabel" Style="{StaticResource CarteActionTextStyle}" />
        </StackPanel>
      </Button>
    </Grid>
  </StackPanel>
</UserControl>
