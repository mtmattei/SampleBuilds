<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Carte.Controls">
    <!-- Production tokens from kit/design/tokens.json. Carte keeps one fixed paper-and-ink palette. -->
    <Color x:Key="CartePaperColor">#F7F1E4</Color>
    <Color x:Key="CarteInkColor">#203BB6</Color>
    <SolidColorBrush x:Key="CartePaperBrush" Color="{StaticResource CartePaperColor}" />
    <SolidColorBrush x:Key="CarteInkBrush" Color="{StaticResource CarteInkColor}" />
    <SolidColorBrush x:Key="CarteRuleBrush" Color="{StaticResource CarteInkColor}" Opacity="0.23" />
    <SolidColorBrush x:Key="CarteWashBrush" Color="{StaticResource CarteInkColor}" Opacity="0.055" />
    <SolidColorBrush x:Key="CarteTransparentBrush" Color="Transparent" />

    <FontFamily x:Key="CarteEditorialFont">ms-appx:///Assets/Fonts/InstrumentSerif-Regular.ttf#Instrument Serif</FontFamily>
    <FontFamily x:Key="CarteEditorialItalicFont">ms-appx:///Assets/Fonts/InstrumentSerif-Italic.ttf#Instrument Serif</FontFamily>
    <FontFamily x:Key="CarteBodyFont">ms-appx:///Assets/Fonts/CarteSans-Regular.ttf#Carte Sans</FontFamily>
    <FontFamily x:Key="CarteBodyMediumFont">ms-appx:///Assets/Fonts/CarteSans-Medium.ttf#Carte Sans</FontFamily>
    <FontFamily x:Key="CarteBodySemiBoldFont">ms-appx:///Assets/Fonts/CarteSans-SemiBold.ttf#Carte Sans</FontFamily>
    <FontFamily x:Key="CarteMonoFont">ms-appx:///Assets/Fonts/DMMono-Regular.ttf#DM Mono</FontFamily>

    <x:Double x:Key="CarteMinTarget">44</x:Double>
    <x:Double x:Key="CarteGlyphSize">30</x:Double>
    <x:Double x:Key="CarteIconSize">18</x:Double>
    <Thickness x:Key="CarteRuleThickness">0,0,0,1</Thickness>

    <!-- Shared page rhythm: 24-unit gutters, 16 below 360, and a consistent masthead. -->
    <Thickness x:Key="CartePagePadding">24,8,24,32</Thickness>
    <Thickness x:Key="CarteNarrowPagePadding">16,8,16,32</Thickness>
    <Style x:Key="CartePageHeaderStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="0,12,0,12" />
        <Setter Property="BorderBrush" Value="{StaticResource CarteInkBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1.5" />
    </Style>

    <!-- Typography -->
    <Style x:Key="CarteBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CarteBodyFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource CarteInkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CarteSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteBodyTextStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="CarteCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteSecondaryTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="CarteActionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteSecondaryTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CarteBodyMediumFont}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CarteQuietActionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteActionTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CarteBodyFont}" />
    </Style>
    <Style x:Key="CarteTabTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteBodyTextStyle}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CarteWordmarkTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteBodyTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CarteEditorialItalicFont}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="CarteTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteBodyTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CarteEditorialFont}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="LineHeight" Value="40" />
    </Style>
    <Style x:Key="CarteItemTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteTitleTextStyle}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="32" />
    </Style>
    <Style x:Key="CarteLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteBodyTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CarteMonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
    </Style>
    <Style x:Key="CarteMapLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteBodyTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style x:Key="CarteAxisTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteBodyTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CarteEditorialItalicFont}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="CartePriceTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarteSecondaryTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CarteMonoFont}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="CarteRuleStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource CarteRuleBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="CarteInkRuleStyle" TargetType="Rectangle" BasedOn="{StaticResource CarteRuleStyle}">
        <Setter Property="Height" Value="1.5" />
        <Setter Property="Fill" Value="{StaticResource CarteInkBrush}" />
    </Style>
    <Style x:Key="CarteIconStyle" TargetType="Image">
        <Setter Property="Width" Value="{StaticResource CarteIconSize}" />
        <Setter Property="Height" Value="{StaticResource CarteIconSize}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Buttons: one template, three skins. Press scale 0.96; a 2-unit system focus ring. -->
    <Style x:Key="CarteButtonBaseStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource CarteMinTarget}" />
        <Setter Property="MinHeight" Value="{StaticResource CarteMinTarget}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="{StaticResource CarteBodyMediumFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{StaticResource CarteInkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CartePaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarteInkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource CarteInkBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CartePaperBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="Hover" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{StaticResource CarteWashBrush}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CartePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CarteButtonBaseStyle}" />
    <Style x:Key="CarteSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CarteButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource CartePaperBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CarteInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarteRuleBrush}" />
    </Style>
    <Style x:Key="CarteQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource CarteSecondaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource CarteTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarteTransparentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CarteBodyFont}" />
        <Setter Property="Padding" Value="8,10" />
    </Style>
    <!-- "Why here?" reads as an underlined text link but keeps a 44-unit target. -->
    <Style x:Key="CarteLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource CarteQuietButtonStyle}">
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{Binding}" Style="{StaticResource CarteSecondaryTextStyle}" TextWrapping="NoWrap" />
                        <Rectangle Height="1" Fill="{StaticResource CarteInkBrush}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Category tab: a radio button so selection is announced; a 2-unit ink underline marks it. -->
    <Style x:Key="CarteCategoryTabStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{StaticResource CarteBodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource CarteInkBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource CarteInkBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="{StaticResource CarteTransparentBrush}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Opacity="0" Background="{StaticResource CarteWashBrush}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Rectangle x:Name="Indicator" Opacity="0" Height="2" Margin="12,0"
                                   VerticalAlignment="Bottom" Fill="{StaticResource CarteInkBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preferences are choices within a field, visually distinct from page-navigation tabs. -->
    <Style x:Key="CarteTasteChoiceStyle" TargetType="RadioButton" BasedOn="{StaticResource CarteCategoryTabStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="{StaticResource CarteTransparentBrush}" CornerRadius="4">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Hover.Opacity" Value="1" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Hover.Opacity" Value="1" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.45" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Selected.Opacity" Value="1" />
                                        <Setter Target="ChoiceText.FontFamily" Value="{StaticResource CarteBodyMediumFont}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Opacity="0" CornerRadius="4" Background="{StaticResource CarteWashBrush}" />
                        <Border x:Name="Selected" Opacity="0" CornerRadius="4" Background="{StaticResource CarteWashBrush}"
                                BorderBrush="{StaticResource CarteInkBrush}" BorderThickness="1" />
                        <ContentPresenter x:Name="ChoiceText" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain list rows: the row template draws its own rule and selection. -->
    <Style x:Key="CarteListItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource CarteMinTarget}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource CarteInkBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Background="{StaticResource CarteTransparentBrush}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Taste-map glyph. Selection, confidence and focus are separate state groups driven by TasteMapView. -->
    <Style x:Key="CarteGlyphButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource CarteMinTarget}" />
        <Setter Property="Height" Value="{StaticResource CarteMinTarget}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{StaticResource CarteTransparentBrush}" RenderTransformOrigin="0.5,0.5">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualStateGroup.Transitions>
                                    <!-- 160 ms selection fade; skipped when animations are off -->
                                    <VisualTransition From="Unselected" To="Selected">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ConfidenceStates">
                                <VisualState x:Name="Confident" />
                                <VisualState x:Name="LowConfidence">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DashedRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Ellipse x:Name="Hover" Opacity="0" Fill="{StaticResource CarteWashBrush}" />
                        <Ellipse x:Name="Disc" Opacity="0" Fill="{StaticResource CarteInkBrush}" />
                        <Ellipse x:Name="DashedRing" Opacity="0" Stroke="{StaticResource CarteInkBrush}"
                                 StrokeThickness="1.2" StrokeDashArray="3,3" Margin="-3" />
                        <Ellipse x:Name="FocusRing" Opacity="0" Stroke="{StaticResource CarteInkBrush}"
                                 StrokeThickness="2" Margin="-5" />
                        <controls:LivingIllustrationView IllustrationKey="{Binding Id}"
                                                     AppearanceId="{Binding AppearanceId}"
                                                     AppearanceDelayMilliseconds="{Binding AppearanceDelayMilliseconds}" FallbackSource="{Binding GlyphInk}"
                                                        FallbackInvertedSource="{Binding GlyphPaper}"
                                                        IsInverted="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
